+import { describe, expect, it } from 'vitest';
+import { buildPlanTree } from './plan-view';
+
+const tasks = [
+  { id: 'parent', code: 'T-001', title: 'Parent task', status: 'in_progress', parent_id: null, blocked_on_kind: null, blocked_on_ref: null, blocked_reason: null, unblock_condition: null },
+  { id: 'blocked', code: 'T-002', title: 'Blocked child', status: 'blocked', parent_id: 'parent', blocked_on_kind: 'task', blocked_on_ref: 'dependency', blocked_reason: 'dependency pending', unblock_condition: 'T-003 must be done' },
+  { id: 'waiting', code: 'T-003', title: 'Human response child', status: 'awaiting_review', parent_id: 'parent', blocked_on_kind: 'question', blocked_on_ref: 'question-id', blocked_reason: null, unblock_condition: 'human answers Q-001' },
+];
+
+describe('buildPlanTree', () => {
+  it('returns the full hierarchy and keeps blocked separate from awaiting_human', () => {
+    const [root] = buildPlanTree({
+      tasks,
+      dependencies: [{ task_id: 'blocked', id: 'dependency', code: 'T-004', status: 'not_started' }],
+      declarations: [{ task_id: 'blocked', req_ids: ['REQ-001'] }],
+      criteria: [{ task_id: 'blocked', code: 'C-001', req_code: 'REQ-001', status: 'pending' }],
+      cancellations: [],
+    });
+    expect(root.code).toBe('T-001');
+    expect(root.children.map((child) => child.display_status)).toEqual(['blocked', 'awaiting_human']);
+    expect(root.children[0]).toMatchObject({
+      status: 'blocked',
+      blocked_on: { kind: 'task', reason: 'dependency pending' },
+      depends_on: [{ code: 'T-004', status: 'not_started' }],
+      declared_req_ids: ['REQ-001'],
+      criteria: [{ code: 'C-001', req_code: 'REQ-001', status: 'pending' }],
+    });
+    expect(root.children[1].status).toBe('awaiting_review');
+    expect(root.children[1].display_status).toBe('awaiting_human');
+  });
+
+  it('marks only a human-canceled child as canceled in the projection', () => {
+    const [root] = buildPlanTree({
+      tasks,
+      dependencies: [],
+      declarations: [],
+      criteria: [],
+      cancellations: [{ child_id: 'blocked', waiver: 'cancel:T-002' }],
+    });
+    expect(root.children[0]).toMatchObject({ status: 'blocked', display_status: 'canceled', canceled_by_human: true });
+    expect(root.children[1].canceled_by_human).toBe(false);
+  });
+});
diff --git a/packages/core/src/exec/plan-view.ts b/packages/core/src/exec/plan-view.ts
new file mode 100644
index 0000000..331310a
--- /dev/null
+++ b/packages/core/src/exec/plan-view.ts
@@ -0,0 +1,172 @@
+import { sql } from 'kysely';
+import { AppError } from '@forgepm/shared';
+import { findCycle } from '../graph';
+import type { DbLike } from '../db/unitOfWork';
+import { findTaskByRef, type LedgerActor } from './open-items-service';
+import { requirementCoverage } from './requirement-coverage';
+
+export interface PlanTaskNode {
+  id: string;
+  code: string;
+  title: string;
+  status: string;
+  display_status: string;
+  parent_id: string | null;
+  blocked_on: { kind: string; ref: string | null; reason: string | null; unblock_condition: string | null } | null;
+  depends_on: { id: string; code: string; status: string }[];
+  declared_req_ids: string[];
+  criteria: { code: string; req_code: string | null; status: string }[];
+  canceled_by_human: boolean;
+  children: PlanTaskNode[];
+}
+
+interface TaskRow {
+  id: string;
+  code: string;
+  title: string;
+  status: string;
+  parent_id: string | null;
+  blocked_on_kind: string | null;
+  blocked_on_ref: string | null;
+  blocked_reason: string | null;
+  unblock_condition: string | null;
+}
+
+interface PlanFacts {
+  tasks: TaskRow[];
+  dependencies: { task_id: string; id: string; code: string; status: string }[];
+  declarations: { task_id: string; req_ids: unknown }[];
+  criteria: { task_id: string; code: string; req_code: string | null; status: string }[];
+  cancellations: { child_id: string; waiver: string | null }[];
+}
+
+export async function execPlanView(
+  db: DbLike,
+  actor: LedgerActor,
+  taskRef?: string,
+): Promise<{ project_id: string; roots: PlanTaskNode[]; task_count: number; requirements: Awaited<ReturnType<typeof requirementCoverage>> }> {
+  if (taskRef && !(await findTaskByRef(db, actor, taskRef))) {
+    throw new AppError('NOT_FOUND', `no task '${taskRef}' in this project`);
+  }
+  const facts = await loadPlanFacts(db, actor);
+  const requirements = await requirementCoverage(db, actor);
+  const roots = buildPlanTree(facts);
+  return { project_id: actor.projectId, roots, task_count: facts.tasks.length, requirements };
+}
+
+async function loadPlanFacts(db: DbLike, actor: LedgerActor): Promise<PlanFacts> {
+  const tasks = await sql<TaskRow>`
+    SELECT id::text AS id, code, title, status, parent_id::text AS parent_id,
+      blocked_on_kind, blocked_on_ref::text AS blocked_on_ref, blocked_reason, unblock_condition
+    FROM exec_tasks
+    WHERE organization_id = ${actor.organizationId}::uuid AND project_id = ${actor.projectId}::uuid
+    ORDER BY code
+  `.execute(db as never);
+  const ids = tasks.rows.map((task) => task.id);
+  if (!ids.length) return { tasks: [], dependencies: [], declarations: [], criteria: [], cancellations: [] };
+  const [dependencies, declarations, criteria, cancellations] = await Promise.all([
+    sql<{ task_id: string; id: string; code: string; status: string }>`
+      SELECT d.task_id::text AS task_id, dependency.id::text AS id, dependency.code, dependency.status
+      FROM exec_task_deps d JOIN exec_tasks dependency ON dependency.id = d.depends_on_task_id
+      WHERE d.task_id = ANY(${ids}::uuid[]) ORDER BY d.task_id, dependency.code
+    `.execute(db as never),
+    sql<{ task_id: string; req_ids: unknown }>`
+      SELECT e.task_id::text AS task_id, e.payload #> '{after,req_ids}' AS req_ids
+      FROM exec_events e WHERE e.task_id = ANY(${ids}::uuid[]) AND e.action = 'task.created'
+      ORDER BY e.created_at, e.id
+    `.execute(db as never),
+    sql<{ task_id: string; code: string; req_code: string | null; status: string }>`
+      SELECT c.task_id::text AS task_id, c.code, r.code AS req_code, c.status
+      FROM exec_criteria c LEFT JOIN exec_requirements r ON r.id = c.req_id
+      WHERE c.task_id = ANY(${ids}::uuid[]) ORDER BY c.task_id, c.code
+    `.execute(db as never),
+    sql<{ child_id: string; waiver: string | null }>`
+      SELECT e.entity_id::text AS child_id, e.payload->>'waiver' AS waiver
+      FROM exec_events e JOIN exec_tasks parent ON parent.id = e.task_id
+      WHERE parent.organization_id = ${actor.organizationId}::uuid AND parent.project_id = ${actor.projectId}::uuid
+        AND e.action = 'task.waived' AND e.actor_type = 'human'
+      ORDER BY e.created_at, e.id
+    `.execute(db as never),
+  ]);
+  return {
+    tasks: tasks.rows,
+    dependencies: dependencies.rows,
+    declarations: declarations.rows,
+    criteria: criteria.rows,
+    cancellations: cancellations.rows,
+  };
+}
+
+export function buildPlanTree(facts: PlanFacts): PlanTaskNode[] {
+  const parentEdges = facts.tasks.flatMap((task): [string, string][] => task.parent_id ? [[task.id, task.parent_id]] : []);
+  for (const task of facts.tasks) {
+    const cycle = findCycle(parentEdges, task.id);
+    if (cycle) throw new AppError('DEPENDENCY_CYCLE', `task parent cycle: ${cycle.join(' -> ')}`, { cycle });
+  }
+  const byId = new Map(facts.tasks.map((task) => [task.id, createNode(task, facts)]));
+  const roots: PlanTaskNode[] = [];
+  for (const task of facts.tasks) {
+    const node = byId.get(task.id)!;
+    const parent = task.parent_id ? byId.get(task.parent_id) : undefined;
+    if (parent) parent.children.push(node);
+    else roots.push(node);
+  }
+  sortTree(roots);
+  return roots;
+}
+
+function createNode(task: TaskRow, facts: PlanFacts): PlanTaskNode {
+  const canceled = facts.cancellations.some((event) => event.child_id === task.id && event.waiver === `cancel:${task.code}`);
+  const taskDependencies = facts.dependencies
+    .filter((dependency) => dependency.task_id === task.id)
+    .map(({ id, code, status }) => ({ id, code, status }));
+  const declarations = facts.declarations
+    .filter((event) => event.task_id === task.id)
+    .flatMap((event) => readStringArray(event.req_ids));
+  const criteria = facts.criteria
+    .filter((criterion) => criterion.task_id === task.id)
+    .map(({ code, req_code, status }) => ({ code, req_code, status }));
+  return {
+    id: task.id,
+    code: task.code,
+    title: task.title,
+    status: task.status,
+    display_status: displayStatus(task.status, canceled),
+    parent_id: task.parent_id,
+    blocked_on: task.blocked_on_kind
+      ? {
+          kind: task.blocked_on_kind,
+          ref: task.blocked_on_ref,
+          reason: task.blocked_reason,
+          unblock_condition: task.unblock_condition,
+        }
+      : null,
+    depends_on: taskDependencies,
+    declared_req_ids: [...new Set(declarations)].sort(),
+    criteria,
+    canceled_by_human: canceled,
+    children: [],
+  };
+}
+
+function displayStatus(status: string, canceled: boolean): string {
+  if (canceled) return 'canceled';
+  if (status === 'awaiting_review') return 'awaiting_human';
+  return status;
+}
+
+function readStringArray(value: unknown): string[] {
+  if (Array.isArray(value)) return value.filter((entry): entry is string => typeof entry === 'string');
+  if (typeof value !== 'string') return [];
+  try {
+    const parsed: unknown = JSON.parse(value);
+    return Array.isArray(parsed) ? parsed.filter((entry): entry is string => typeof entry === 'string') : [];
+  } catch {
+    return [];
+  }
+}
+
+function sortTree(nodes: PlanTaskNode[]): void {
+  nodes.sort((left, right) => left.code.localeCompare(right.code));
+  for (const node of nodes) sortTree(node.children);
+}
diff --git a/packages/core/src/exec/plan.ts b/packages/core/src/exec/plan.ts
new file mode 100644
index 0000000..7b12430
--- /dev/null
+++ b/packages/core/src/exec/plan.ts
@@ -0,0 +1,229 @@
+import { sql } from 'kysely';
+import { AppError, taskBlockInputSchema } from '@forgepm/shared';
+import type { DbLike } from '../db/unitOfWork';
+import { appendEvent } from './events';
+import { findTaskByRef, type LedgerActor } from './open-items-service';
+import { assertAcyclic, pendingDependencies } from './dependencies';
+
+export interface ExecTaskStateResult {
+  task_id: string;
+  task_code: string;
+  status: string;
+  pending_deps?: string[];
+  already_started?: boolean;
+}
+
+export async function startExecTask(db: DbLike, actor: LedgerActor, taskRef: string): Promise<ExecTaskStateResult> {
+  const task = await taskByRef(db, actor, taskRef);
+  if (task.status === 'done') throw new AppError('LEDGER_STATE_INVALID', `task ${task.code} is already closed`);
+  if (task.status === 'in_progress') return { task_id: task.id, task_code: task.code, status: task.status, already_started: true };
+  if (task.status !== 'not_started') {
+    throw new AppError('LEDGER_STATE_INVALID', `task ${task.code} cannot start while '${task.status}'`, {
+      needed_action: 'resolve its current blocker or answer the pending human question first',
+    });
+  }
+  const pending = await pendingDependencies(db, task.id);
+  if (pending.length) {
+    const pendingCodes = pending.map((dependency) => dependency.code);
+    throw new AppError('CONFLICT', `task ${task.code} has pending dependencies: ${pendingCodes.join(', ')}`, {
+      pending_deps: pendingCodes,
+      needed_action: 'finish every dependency before moving this task to in progress',
+    });
+  }
+  await sql`UPDATE exec_tasks SET status = 'in_progress', updated_at = now() WHERE id = ${task.id}::uuid`.execute(db as never);
+  await moveWorkItem(db, task.work_item_id, actor.projectId, 'started');
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: task.id,
+    entity: 'task',
+    entity_id: task.id,
+    entity_code: task.code,
+    action: 'task.started',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: { before: { status: task.status }, after: { status: 'in_progress' } },
+  });
+  return { task_id: task.id, task_code: task.code, status: 'in_progress' };
+}
+
+export async function blockExecTask(db: DbLike, actor: LedgerActor, raw: unknown): Promise<ExecTaskStateResult & { blocked_on_kind: string }> {
+  const parsed = taskBlockInputSchema.safeParse(raw ?? {});
+  if (!parsed.success) {
+    const issue = parsed.error.issues[0];
+    throw new AppError('VALIDATION_ERROR', `${issue?.path.join('.') || 'payload'}: ${issue?.message ?? 'invalid blocker'}`, {
+      needed_action: 'send task_ref, reason, blocked_on_kind, unblock_condition, and a blocking ref when the blocker is a task/question/decision',
+    });
+  }
+  const input = parsed.data;
+  const task = await taskByRef(db, actor, input.task_ref);
+  if (task.status === 'done') throw new AppError('LEDGER_STATE_INVALID', `task ${task.code} is already closed`);
+  const blocker = await resolveBlocker(db, actor, input.blocked_on_kind, input.blocked_on_ref);
+  if (input.blocked_on_kind === 'task' && blocker?.status === 'done') {
+    throw new AppError('LEDGER_STATE_INVALID', `blocking task ${blocker.code} is already done`);
+  }
+  if (input.blocked_on_kind === 'task' && blocker) {
+    await assertAcyclic(db, actor, task.id, blocker.id, task.code, blocker.code);
+    await sql`
+      INSERT INTO exec_task_deps (task_id, depends_on_task_id)
+      VALUES (${task.id}::uuid, ${blocker.id}::uuid)
+      ON CONFLICT (task_id, depends_on_task_id) DO NOTHING
+    `.execute(db as never);
+  }
+  await sql`
+    UPDATE exec_tasks SET status = 'blocked', blocked_on_kind = ${input.blocked_on_kind},
+      blocked_on_ref = ${blocker?.id ?? null}::uuid, blocked_reason = ${input.reason},
+      unblock_condition = ${input.unblock_condition}, closed_at = NULL, updated_at = now()
+    WHERE id = ${task.id}::uuid
+  `.execute(db as never);
+  await moveWorkItem(db, task.work_item_id, actor.projectId, 'unstarted');
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: task.id,
+    entity: 'task',
+    entity_id: task.id,
+    entity_code: task.code,
+    action: 'task.blocked',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: {
+      before: { status: task.status },
+      after: {
+        status: 'blocked',
+        reason: input.reason,
+        blocked_on_kind: input.blocked_on_kind,
+        blocked_on_ref: blocker?.id ?? null,
+        blocked_on_code: blocker?.code ?? input.blocked_on_ref ?? null,
+        unblock_condition: input.unblock_condition,
+      },
+    },
+  });
+  return { task_id: task.id, task_code: task.code, status: 'blocked', blocked_on_kind: input.blocked_on_kind };
+}
+
+export async function resumeBlockedTask(
+  db: DbLike,
+  taskId: string,
+  blockerKind: 'task' | 'question' | 'decision',
+  blockerRef: string,
+  reason: string,
+): Promise<string | null> {
+  const task = await sql<{
+    id: string;
+    code: string;
+    organization_id: string;
+    project_id: string;
+    work_item_id: string;
+    status: string;
+    blocked_on_kind: string | null;
+    blocked_on_ref: string | null;
+  }>`
+    SELECT id::text AS id, code, organization_id::text AS organization_id, project_id::text AS project_id,
+      work_item_id::text AS work_item_id, status, blocked_on_kind, blocked_on_ref::text AS blocked_on_ref
+    FROM exec_tasks WHERE id = ${taskId}::uuid
+  `.execute(db as never);
+  const row = task.rows[0];
+  if (!row || row.status === 'done') return row?.status ?? null;
+  const matchesBlocker = row.blocked_on_kind === blockerKind && (blockerKind === 'task' || row.blocked_on_ref === blockerRef);
+  if (!matchesBlocker) return row.status;
+  const pending = await pendingDependencies(db, row.id);
+  if (pending.length) {
+    const next = pending[0];
+    await sql`
+      UPDATE exec_tasks SET status = 'blocked', blocked_on_kind = 'task', blocked_on_ref = ${next.id}::uuid,
+        blocked_reason = ${`dependency ${next.code} is not done`},
+        unblock_condition = ${`task ${next.code} must be done before this task can continue`}, updated_at = now()
+      WHERE id = ${row.id}::uuid
+    `.execute(db as never);
+    await moveWorkItem(db, row.work_item_id, row.project_id, 'unstarted');
+    return 'blocked';
+  }
+  await sql`
+    UPDATE exec_tasks SET status = 'in_progress', blocked_on_kind = NULL, blocked_on_ref = NULL,
+      blocked_reason = NULL, unblock_condition = NULL, updated_at = now()
+    WHERE id = ${row.id}::uuid
+  `.execute(db as never);
+  await moveWorkItem(db, row.work_item_id, row.project_id, 'started');
+  await appendEvent(db, {
+    organization_id: row.organization_id,
+    task_id: row.id,
+    entity: 'task',
+    entity_id: row.id,
+    entity_code: row.code,
+    action: 'task.unblocked',
+    actor_type: 'system',
+    actor_id: 'exec-plan-unblock',
+    tool: 'task_start',
+    payload: { reason, blocker_kind: blockerKind, blocker_ref: blockerRef, status: 'in_progress' },
+  });
+  return 'in_progress';
+}
+
+export async function unblockDependencyTasks(db: DbLike, completedTaskId: string): Promise<string[]> {
+  const dependents = await sql<{ id: string; code: string }>`
+    SELECT DISTINCT t.id::text AS id, t.code
+    FROM exec_task_deps d JOIN exec_tasks t ON t.id = d.task_id
+    WHERE d.depends_on_task_id = ${completedTaskId}::uuid AND t.status = 'blocked' AND t.blocked_on_kind = 'task'
+    ORDER BY t.code
+  `.execute(db as never);
+  const unblocked: string[] = [];
+  for (const task of dependents.rows) {
+    const next = await resumeBlockedTask(db, task.id, 'task', completedTaskId, 'dependency_completed');
+    if (next === 'in_progress') unblocked.push(task.code);
+  }
+  return unblocked;
+}
+
+async function taskByRef(db: DbLike, actor: LedgerActor, ref: string) {
+  const task = await findTaskByRef(db, actor, ref);
+  if (!task) throw new AppError('NOT_FOUND', `no task '${ref}' in this project`);
+  const row = await sql<{ work_item_id: string }>`
+    SELECT work_item_id::text AS work_item_id FROM exec_tasks WHERE id = ${task.id}::uuid
+  `.execute(db as never);
+  return { ...task, work_item_id: row.rows[0]?.work_item_id ?? '' };
+}
+
+async function resolveBlocker(
+  db: DbLike,
+  actor: LedgerActor,
+  kind: 'task' | 'question' | 'decision' | 'external',
+  ref?: string,
+): Promise<{ id: string; code: string; status: string } | null> {
+  if (kind === 'external') return null;
+  if (!ref) throw new AppError('VALIDATION_ERROR', `blocked_on_ref is required for ${kind}`);
+  if (kind === 'task') {
+    const task = await findTaskByRef(db, actor, ref);
+    if (!task) throw new AppError('NOT_FOUND', `no blocking task '${ref}' in this project`);
+    return { id: task.id, code: task.code, status: task.status };
+  }
+  const table = kind === 'question' ? 'exec_questions' : 'exec_decisions';
+  const statusColumn = kind === 'question' ? 'status' : 'approval_state';
+  const rows = await sql<{ id: string; code: string; status: string }>`
+    SELECT x.id::text AS id, x.code, x.${sql.raw(statusColumn)}::text AS status
+    FROM ${sql.raw(table)} x JOIN exec_tasks t ON t.id = x.task_id
+    WHERE x.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${actor.projectId}::uuid
+      AND (x.code = ${ref} OR x.id::text = ${ref})
+    LIMIT 1
+  `.execute(db as never);
+  const row = rows.rows[0];
+  if (!row) throw new AppError('NOT_FOUND', `no blocking ${kind} '${ref}' in this project`);
+  if (kind === 'question' && row.status !== 'open') throw new AppError('LEDGER_STATE_INVALID', `${kind} ${row.code} is ${row.status}`);
+  if (kind === 'decision' && row.status !== 'pending') throw new AppError('LEDGER_STATE_INVALID', `${kind} ${row.code} is ${row.status}`);
+  return { id: row.id, code: row.code, status: row.status };
+}
+
+async function moveWorkItem(db: DbLike, workItemId: string, projectId: string, target: 'started' | 'unstarted'): Promise<void> {
+  const preferStarted = target === 'started';
+  await sql`
+    WITH target_state AS (
+      SELECT id FROM workflow_states
+      WHERE project_id = ${projectId}::uuid
+        AND ((${preferStarted} AND category = 'started')
+          OR (NOT ${preferStarted} AND category IN ('unstarted','backlog')))
+      ORDER BY CASE WHEN category = 'unstarted' THEN 0 ELSE 1 END, position LIMIT 1
+    )
+    UPDATE work_items SET state_id = (SELECT id FROM target_state), updated_at = now()
+    WHERE id = ${workItemId}::uuid AND EXISTS (SELECT 1 FROM target_state)
+  `.execute(db as never);
+}
