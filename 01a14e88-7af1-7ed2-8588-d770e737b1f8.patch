+import { describe, expect, it } from 'vitest';
+import { toBaseline, toScope } from './gate-mappers';
+
+const startSha = 'a'.repeat(40);
+const currentSha = 'b'.repeat(40);
+const startLogHash = 'd'.repeat(64);
+const startProvenance = {
+  provider: 'fixture',
+  run_id: 'run-1',
+  job: 'unit',
+  sha: startSha,
+  sha256_log: startLogHash,
+};
+const startEvent = (sha = startSha) => ({
+  id: '01-start-event',
+  action: 'baseline.start_captured',
+  actor_type: 'system',
+  actor_id: 'ci-baseline-reader',
+  tool: 'baseline_capture',
+  created_at: new Date('2026-10-19T11:00:00.000Z'),
+  payload: { start: { ...startProvenance, sha } },
+});
+const runEvent = (sha = currentSha) => ({
+  id: '02-current-event',
+  action: 'baseline.captured',
+  actor_type: 'system',
+  actor_id: 'ci-baseline-reader',
+  tool: 'baseline_capture',
+  created_at: new Date('2026-10-19T12:00:00.000Z'),
+  payload: {
+    after: {
+      sha,
+      run_id: 'run-2',
+      job: 'unit',
+      sha256_log: 'c'.repeat(64),
+      complete: true,
+      tests: [{ name: 'auth > logs in', result: 'pass' }],
+      weakening: [],
+    },
+  },
+});
+
+describe('gate baseline mapping (PE-8)', () => {
+  it('labels a server-measured no-Git diff as a manifest scope basis', () => {
+    const scope = toScope([{ path: 'src/app.ts', status: 'M' }], ['src/**'], null, null, false, 'manifest');
+    expect(scope.available).toBe(true);
+    expect(scope.basis).toBe('manifest');
+    expect(scope.files[0]?.in_allowed_paths).toBe(true);
+  });
+
+  it('accepts only CI-origin start rows and a system capture for the current SHA', () => {
+    const result = toBaseline(
+      [
+        {
+          test_name: 'auth > logs in',
+          result_at_start: 'pass',
+          source: 'ci',
+          provenance: startProvenance,
+        },
+        {
+          test_name: 'agent-claimed test',
+          result_at_start: 'pass',
+          source: 'human',
+          provenance: startProvenance,
+        },
+      ],
+      [startEvent(), runEvent()],
+      startSha,
+      currentSha,
+      false,
+    );
+    expect(result.ran).toBe(true);
+    expect(result.start_sha).toBe(startSha);
+    expect(result.current_sha).toBe(currentSha);
+    expect(result.tests.map((test) => test.name)).toEqual(['auth > logs in']);
+    expect(result.after?.sha).toBe(currentSha);
+    expect(result.after?.results).toEqual({ 'auth > logs in': 'pass' });
+  });
+
+  it('fails closed when either the current SHA or the CI event provenance mismatches', () => {
+    const wrongCurrent = toBaseline(
+      [{ test_name: 'auth > logs in', result_at_start: 'pass', source: 'ci', provenance: startProvenance }],
+      [startEvent(), runEvent()],
+      startSha,
+      'd'.repeat(40),
+      false,
+    );
+    expect(wrongCurrent.ran).toBe(false);
+    expect(wrongCurrent.unavailable_reason).toContain('no CI log captured');
+
+    const wrongStart = toBaseline(
+      [{ test_name: 'auth > logs in', result_at_start: 'pass', source: 'ci', provenance: { sha: 'd'.repeat(40) } }],
+      [startEvent(), runEvent()],
+      startSha,
+      currentSha,
+      false,
+    );
+    expect(wrongStart.ran).toBe(false);
+    expect(wrongStart.unavailable_reason).toContain('no CI baseline captured');
+  });
+
+  it('requires a system-authored start capture event matching every baseline row', () => {
+    const result = toBaseline(
+      [{ test_name: 'auth > logs in', result_at_start: 'pass', source: 'ci', provenance: startProvenance }],
+      [runEvent()],
+      startSha,
+      currentSha,
+      false,
+    );
+    expect(result.ran).toBe(false);
+    expect(result.tests).toEqual([]);
+  });
+
+  it('does not treat an agent-authored waiver marker as an approval', () => {
+    const result = toBaseline(
+      [{ test_name: 'auth > logs in', result_at_start: 'pass', source: 'ci', provenance: startProvenance }],
+      [
+        startEvent(),
+        {
+          ...runEvent(),
+          actor_type: 'agent',
+          payload: { waiver: 'baseline:T-001', approval_id: 'not-human' },
+        },
+      ],
+      startSha,
+      currentSha,
+      false,
+    );
+    expect(result.ran).toBe(false);
+
+    const wrongSystemActor = toBaseline(
+      [{ test_name: 'auth > logs in', result_at_start: 'pass', source: 'ci', provenance: startProvenance }],
+      [startEvent(), { ...runEvent(), actor_id: 'untrusted-writer' }],
+      startSha,
+      currentSha,
+      false,
+    );
+    expect(wrongSystemActor.ran).toBe(false);
+  });
+});
diff --git a/packages/core/src/exec/gate-mappers.ts b/packages/core/src/exec/gate-mappers.ts
new file mode 100644
index 0000000..d12ba94
--- /dev/null
+++ b/packages/core/src/exec/gate-mappers.ts
@@ -0,0 +1,419 @@
+import { evidenceIsVerifiable } from './evidence';
+import { isTransient, matchPathGlob, type ChangedFile } from './scope';
+import type {
+  GateBaseline,
+  GateCriterion,
+  GateDecision,
+  GateFact,
+  GateOpenItem,
+  GateQuestion,
+  GateReport,
+  GateRequirement,
+  GateReview,
+  GateScope,
+  GateTask,
+} from './gate-types';
+
+/**
+ * Row → snapshot mappers for the gate (plan §8.2).
+ *
+ * Pure and separate from the loader on purpose: a mapper is the place where a
+ * database column becomes a rule's input, and a rule must never have to know
+ * what a column is called. Every mapper is total — a missing or surprising
+ * value becomes an explicit "empty", never an exception.
+ */
+
+export const asArray = (v: unknown): unknown[] => (Array.isArray(v) ? v : []);
+export const asStringArray = (v: unknown): string[] => asArray(v).filter((x): x is string => typeof x === 'string');
+const asBool = (v: unknown): boolean => v === true;
+
+export function toReport(payload: Record<string, unknown> | null): GateReport | null {
+  if (!payload) return null;
+  const executed = asArray(payload.tests_executed)
+    .map((t) => {
+      const x = (t ?? {}) as Record<string, unknown>;
+      const result = x.result === 'fail' ? 'fail' : x.result === 'not_run' ? 'not_run' : 'pass';
+      return {
+        name: String(x.name ?? ''),
+        result: result as 'pass' | 'fail' | 'not_run',
+        evidence_ref: String(x.evidence_id ?? x.evidence_ref ?? ''),
+      };
+    })
+    .filter((t) => t.name.length > 0);
+  const notRun = asArray(payload.tests_not_run)
+    .map((t) => {
+      const x = (t ?? {}) as Record<string, unknown>;
+      return { name: String(x.name ?? ''), reason: String(x.reason ?? '') };
+    })
+    .filter((t) => t.name.length > 0);
+  return {
+    summary: typeof payload.summary === 'string' ? payload.summary : undefined,
+    tests_executed: executed,
+    tests_not_run: notRun,
+    changed_files: asStringArray(payload.changed_files),
+  };
+}
+
+export function toTask(
+  task: { code: string; status: GateTask['status'] },
+  children: { code: string; title: string; status: GateTask['status'] }[],
+  deps: { depends_on_task_id: string }[],
+  depTasks: { id: string; code: string; status: GateTask['status'] }[],
+  waivers: { entity_code: string | null; payload: unknown }[],
+): GateTask {
+  const waiverNames = waivers.map((w) => waiverName(w.payload) ?? w.entity_code ?? '').filter((w) => w.length > 0);
+  const depById = new Map(depTasks.map((d) => [d.id, d]));
+  return {
+    code: task.code,
+    status: task.status,
+    children: children.map((c) => ({
+      code: c.code,
+      title: c.title,
+      status: c.status,
+      req_codes: [],
+      cancelled: waiverNames.some((w) => w === `cancel:${c.code}` || w.startsWith(`cancel:${c.code}:`)),
+    })),
+    depends_on: deps.map((d) => {
+      const dep = depById.get(d.depends_on_task_id);
+      return { code: dep?.code ?? d.depends_on_task_id, status: dep?.status ?? 'not_started' };
+    }),
+    human_waivers: waiverNames,
+  };
+}
+
+/** A waiver event carries `{ waiver: 'cancel:T-002' }` in its payload. */
+function waiverName(payload: unknown): string | null {
+  if (!payload || typeof payload !== 'object') return null;
+  const p = payload as Record<string, unknown>;
+  const w = p.waiver ?? p.name;
+  return typeof w === 'string' ? w : null;
+}
+
+export function toCriteria(
+  criteria: {
+    id: string;
+    code: string;
+    text: string;
+    status: 'pending' | 'verified' | 'waived';
+    waiver_approval_id: string | null;
+    req_id: string | null;
+  }[],
+  evidence: { criterion_id: string | null; ref: string; payload: string | null; sha256: string | null }[],
+): GateCriterion[] {
+  return criteria.map((c) => {
+    const rows = evidence.filter((e) => e.criterion_id === c.id);
+    return {
+      code: c.code,
+      status: c.status,
+      evidence_count: rows.length,
+      valid_evidence_count: rows.filter(evidenceIsVerifiable).length,
+      has_waiver_approval: c.waiver_approval_id !== null,
+      req_code: c.req_id,
+      text: c.text,
+    };
+  });
+}
+
+export function toOpenItems(
+  items: {
+    code: string;
+    title: string;
+    type: string;
+    status: GateOpenItem['status'];
+    blocks_completion: boolean;
+    source: string;
+    related_ref?: string | null;
+    resolved_by?: 'agent' | 'human' | null;
+  }[],
+): GateOpenItem[] {
+  return items.map((i) => ({
+    code: i.code,
+    title: i.title,
+    type: i.type,
+    status: i.status,
+    blocks_completion: i.blocks_completion,
+    source: i.source,
+    related_ref: i.related_ref ?? null,
+    resolved_by: i.resolved_by ?? null,
+  }));
+}
+
+export function toDecisions(
+  decisions: {
+    code: string;
+    title: string;
+    touches: string[];
+    reversible: boolean;
+    approval_state: GateDecision['approval_state'];
+    applied_at: Date | null;
+    status?: GateDecision['status'];
+  }[],
+): GateDecision[] {
+  return decisions.map((d) => ({
+    code: d.code,
+    title: d.title,
+    touches: d.touches ?? [],
+    reversible: d.reversible,
+    approval_state: d.approval_state,
+    applied: d.applied_at !== null,
+    status: d.status ?? 'active',
+  }));
+}
+
+export function toQuestions(
+  questions: { code: string; blocking: boolean; status: GateQuestion['status'] }[],
+): GateQuestion[] {
+  return questions.map((q) => ({ code: q.code, blocking: q.blocking, status: q.status }));
+}
+
+export function toFacts(
+  facts: { id: string; code: string; status: GateFact['status'] }[],
+  factDecisions: { fact_id: string; decision_id: string }[],
+  decisions: { id: string; code: string; status: string }[],
+): GateFact[] {
+  const decisionCode = new Map(decisions.filter((d) => d.status === 'active').map((d) => [d.id, d.code]));
+  return facts.map((f) => ({
+    code: f.code,
+    status: f.status,
+    active_dependent_decisions: factDecisions
+      .filter((fd) => fd.fact_id === f.id)
+      .map((fd) => decisionCode.get(fd.decision_id))
+      .filter((c): c is string => typeof c === 'string'),
+  }));
+}
+
+export function toRequirements(
+  all: { id: string; code: string; status: GateRequirement['status'] }[],
+  links: { req_id: string; criterion_ids: unknown }[],
+  criteria: { id: string; code: string; status: string; req_id: string | null }[],
+): GateRequirement[] {
+  const linked = new Map<string, string[]>();
+  for (const l of links) linked.set(l.req_id, asStringArray(l.criterion_ids));
+  return all.map((r) => {
+    const ids = new Set(linked.get(r.id) ?? []);
+    const verified = criteria
+      .filter((c) => (ids.has(c.id) || c.req_id === r.id) && c.status === 'verified')
+      .map((c) => c.code);
+    return { code: r.code, status: r.status, verified_criteria: verified };
+  });
+}
+
+export function toReview(
+  reviews: {
+    round: number;
+    verdict: 'pass' | 'fail';
+    tree_hash: string;
+    findings: unknown;
+    created_at: Date;
+  }[],
+): GateReview | null {
+  if (!reviews.length) return null;
+  const latest = [...reviews].sort((a, b) => b.round - a.round || b.created_at.getTime() - a.created_at.getTime())[0];
+  const findings = asArray(latest.findings) as Record<string, unknown>[];
+  const openBlocking = findings.filter((f) => asBool(f.blocks_completion)).length;
+  return {
+    round: latest.round,
+    verdict: latest.verdict,
+    tree_hash: latest.tree_hash,
+    open_blocking_findings: openBlocking,
+  };
+}
+
+/**
+ * Map a code-measured Git diff or server-captured manifest diff into Rule 11
+ * inputs. An exit report is deliberately not accepted: `changed_files` is an agent claim.
+ */
+export function toScope(
+  changed: readonly ChangedFile[] | null,
+  allowedRaw: unknown,
+  unavailableReason: string | null = null,
+  treeHash: string | null = null,
+  humanWaived = false,
+  basis: 'git' | 'manifest' = 'git',
+): GateScope {
+  if (!changed) {
+    return {
+      available: false,
+      basis: 'none',
+      unavailable_reason: unavailableReason ?? 'no start_ref or read-only diff source',
+      human_waived: humanWaived,
+      files: [],
+      tree_hash: null,
+    };
+  }
+  const allowed = asStringArray(allowedRaw);
+  const isAllowed = (path: string): boolean => allowed.some((glob) => matchPathGlob(glob, path));
+  const files = changed.map((file) => ({
+    path: file.path,
+    change: file.status,
+    in_allowed_paths: isAllowed(file.path) && (!file.from || isAllowed(file.from)),
+    deleted: file.status === 'D',
+    transient: isTransient(file.path),
+  }));
+  return { available: true, basis, unavailable_reason: null, human_waived: humanWaived, files, tree_hash: treeHash };
+}
+
+/**
+ * Build baseline inputs only from CI-origin rows and a system-written capture
+ * event whose SHA matches the current clean worktree. Exit-report test claims
+ * are intentionally absent from this function.
+ */
+export function toBaseline(
+  rows: {
+    test_name: string;
+    result_at_start: 'pass' | 'fail' | 'skip';
+    source: 'ci' | 'human';
+    provenance: unknown;
+  }[],
+  events: { id: string; action: string; actor_type: string; actor_id: string | null; tool: string | null; payload: unknown; created_at: Date }[],
+  startSha: string | null,
+  currentSha: string | null,
+  humanWaived: boolean,
+): GateBaseline {
+  const expectedStart = validSha(startSha) ? startSha.toLowerCase() : null;
+  const expectedCurrent = validSha(currentSha) ? currentSha.toLowerCase() : null;
+  const startProvenance = expectedStart
+    ? events
+        .filter((event) => event.action === 'baseline.start_captured')
+        .sort((a, b) => b.created_at.getTime() - a.created_at.getTime() || (a.id < b.id ? 1 : a.id > b.id ? -1 : 0))
+        .map((event) => capturedStartEvent(event, expectedStart))
+        .find((run) => run !== null) ?? null
+    : null;
+  const baselineRows = rows
+    .filter((row) => {
+      const provenance = record(row.provenance);
+      return Boolean(
+        row.source === 'ci' && startProvenance && provenance &&
+        provenance.provider === startProvenance.provider && provenance.run_id === startProvenance.run_id &&
+        provenance.job === startProvenance.job && provenance.sha256_log === startProvenance.sha256_log &&
+        typeof provenance.sha === 'string' && provenance.sha.toLowerCase() === expectedStart,
+      );
+    })
+    .map((row) => ({ name: row.test_name, result_at_start: row.result_at_start, source: 'ci' as const }));
+  const latest = expectedCurrent
+    ? events
+        .filter(
+          (event) =>
+            event.action === 'baseline.captured' &&
+            event.actor_type === 'system' &&
+            event.actor_id === 'ci-baseline-reader' &&
+            event.tool === 'baseline_capture',
+        )
+        .sort((a, b) => b.created_at.getTime() - a.created_at.getTime() || (a.id < b.id ? 1 : a.id > b.id ? -1 : 0))
+        .map((event) => capturedRun(event.payload, expectedCurrent))
+        .find((run) => run !== null) ?? null
+    : null;
+  const ran = Boolean(expectedStart && expectedCurrent && baselineRows.length > 0 && latest);
+  let unavailableReason: string | null = null;
+  if (!expectedStart) unavailableReason = 'BASELINE_UNAVAILABLE: task has no code-captured start SHA';
+  else if (!baselineRows.length) unavailableReason = `BASELINE_UNAVAILABLE: no CI baseline captured for ${expectedStart}`;
+  else if (!expectedCurrent) unavailableReason = 'BASELINE_UNAVAILABLE: current worktree is dirty or its commit SHA is unavailable';
+  else if (!latest) unavailableReason = `BASELINE_UNAVAILABLE: no CI log captured for current SHA ${expectedCurrent}`;
+
+  return {
+    ran,
+    unavailable_reason: ran ? null : unavailableReason,
+    human_waived: humanWaived,
+    start_sha: expectedStart,
+    current_sha: expectedCurrent,
+    tests: baselineRows,
+    after: latest
+      ? {
+          sha: latest.sha,
+          run_id: latest.run_id,
+          job: latest.job,
+          present: latest.tests.map((test) => test.name),
+          results: Object.fromEntries(latest.tests.map((test) => [test.name, test.result])),
+        }
+      : null,
+    weakening: latest?.weakening ?? [],
+  };
+}
+
+interface CapturedStart {
+  provider: string;
+  run_id: string;
+  job: string;
+  sha: string;
+  sha256_log: string;
+}
+
+function capturedStartEvent(
+  event: { action: string; actor_type: string; actor_id: string | null; tool: string | null; payload: unknown },
+  expectedSha: string,
+): CapturedStart | null {
+  if (
+    event.action !== 'baseline.start_captured' || event.actor_type !== 'system' ||
+    event.actor_id !== 'ci-baseline-reader' || event.tool !== 'baseline_capture'
+  ) return null;
+  const start = record(record(event.payload)?.start);
+  if (
+    !start || typeof start.provider !== 'string' || !start.provider ||
+    typeof start.run_id !== 'string' || !start.run_id || typeof start.job !== 'string' || !start.job ||
+    typeof start.sha !== 'string' || start.sha.toLowerCase() !== expectedSha ||
+    typeof start.sha256_log !== 'string' || !/^[0-9a-f]{64}$/i.test(start.sha256_log)
+  ) return null;
+  return {
+    provider: start.provider,
+    run_id: start.run_id,
+    job: start.job,
+    sha: expectedSha,
+    sha256_log: start.sha256_log.toLowerCase(),
+  };
+}
+
+interface CapturedRun {
+  sha: string;
+  run_id: string;
+  job: string;
+  tests: { name: string; result: 'pass' | 'fail' | 'skip' }[];
+  weakening: { path: string; count_delta: number; modifiers: string[] }[];
+}
+
+function capturedRun(payload: unknown, expectedSha: string): CapturedRun | null {
+  const after = record(record(payload)?.after);
+  if (!after || typeof after.sha !== 'string' || after.sha.toLowerCase() !== expectedSha) return null;
+  if (
+    typeof after.run_id !== 'string' || !after.run_id || typeof after.job !== 'string' || !after.job ||
+    after.complete !== true || typeof after.sha256_log !== 'string' || !/^[0-9a-f]{64}$/i.test(after.sha256_log)
+  ) return null;
+  if (!Array.isArray(after.tests) || after.tests.length === 0) return null;
+  const tests = after.tests.flatMap((value) => {
+    const item = record(value);
+    if (!item || typeof item.name !== 'string' || !item.name || !isTestResult(item.result)) return [];
+    return [{ name: item.name, result: item.result }];
+  });
+  if (tests.length !== after.tests.length) return null;
+  if (!Array.isArray(after.weakening)) return null;
+  const weakening = after.weakening.map((value) => {
+    const item = record(value);
+    if (
+      !item || typeof item.path !== 'string' || typeof item.count_delta !== 'number' ||
+      !Array.isArray(item.modifiers) || !item.modifiers.every((modifier) => typeof modifier === 'string')
+    ) return null;
+    return { path: item.path, count_delta: item.count_delta, modifiers: item.modifiers as string[] };
+  });
+  if (weakening.some((item) => item === null)) return null;
+  return { sha: expectedSha, run_id: after.run_id, job: after.job, tests, weakening: weakening as CapturedRun['weakening'] };
+}
+
+function record(value: unknown): Record<string, unknown> | null {
+  if (value && typeof value === 'object' && !Array.isArray(value)) return value as Record<string, unknown>;
+  if (typeof value === 'string') {
+    try {
+      const parsed: unknown = JSON.parse(value);
+      return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? (parsed as Record<string, unknown>) : null;
+    } catch {
+      return null;
+    }
+  }
+  return null;
+}
+
+function validSha(value: string | null): value is string {
+  return typeof value === 'string' && /^[0-9a-f]{40,64}$/i.test(value);
+}
+
+function isTestResult(value: unknown): value is 'pass' | 'fail' | 'skip' {
+  return value === 'pass' || value === 'fail' || value === 'skip';
+}
diff --git a/packages/core/src/exec/gate-rules/index.ts b/packages/core/src/exec/gate-rules/index.ts
new file mode 100644
index 0000000..4537b2e
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/index.ts
@@ -0,0 +1,40 @@
+import type { Rule } from '../gate-types';
+import rule01 from './rule01-exit-report';
+import rule02 from './rule02-blocking-items';
+import rule03 from './rule03-criteria-evidence';
+import rule04 from './rule04-approvals';
+import rule05 from './rule05-questions';
+import rule06 from './rule06-tests';
+import rule07 from './rule07-review';
+import rule08 from './rule08-requirements';
+import rule09 from './rule09-plan';
+import rule10 from './rule10-facts';
+import rule11 from './rule11-scope';
+import rule12 from './rule12-baseline';
+import rule13 from './rule13-journal';
+
+/**
+ * The thirteen rules, in their fixed order (docs/EXECUTION_CONTROL_PLAN.md §8.2).
+ *
+ * The numbering is a public contract: the docs, the tests and the agents' own
+ * error messages all cite it, so a rule may only be *added* at the end — never
+ * renumbered, never reordered. `gate.test.ts` pins the list so an accidental
+ * shuffle fails the build rather than changing what "rule 4" means.
+ */
+export const GATE_RULES: ReadonlyArray<{ n: number; name: string; run: Rule }> = [
+  { n: 1, name: 'exit_report_valid', run: rule01 },
+  { n: 2, name: 'no_blocking_open_items', run: rule02 },
+  { n: 3, name: 'criteria_have_evidence', run: rule03 },
+  { n: 4, name: 'no_pending_or_rejected_approvals', run: rule04 },
+  { n: 5, name: 'no_unanswered_blocking_questions', run: rule05 },
+  { n: 6, name: 'tests_pass_or_justified', run: rule06 },
+  { n: 7, name: 'adversarial_review_current', run: rule07 },
+  { n: 8, name: 'requirements_covered', run: rule08 },
+  { n: 9, name: 'plan_children_and_deps_done', run: rule09 },
+  { n: 10, name: 'no_stale_fact_dependency', run: rule10 },
+  { n: 11, name: 'scope_respected', run: rule11 },
+  { n: 12, name: 'baseline_intact', run: rule12 },
+  { n: 13, name: 'journal_settled', run: rule13 },
+];
+
+export const GATE_RULE_NUMBERS = GATE_RULES.map((r) => r.n);
diff --git a/packages/core/src/exec/gate-rules/rule01-exit-report.ts b/packages/core/src/exec/gate-rules/rule01-exit-report.ts
new file mode 100644
index 0000000..65d14c2
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule01-exit-report.ts
@@ -0,0 +1,35 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 1 — the exit report is present, current and structurally valid.
+ *
+ * "Absent" is the common case (an agent that never submitted one) and it is
+ * the only rule that may talk about the report's shape: the other twelve read
+ * what the report produced, not the report itself.
+ */
+const rule01: Rule = (ctx: GateContext): BlockedRef[] => {
+  if (!ctx.report)
+    return [
+      {
+        rule: 1,
+        ref: 'exit_report',
+        title: 'the exit report is missing',
+        needed: 'call exec_submit_exit_report with the full report',
+        tool_to_call: 'exec_submit_exit_report',
+      },
+    ];
+  if (!Array.isArray(ctx.report.tests_executed) || !Array.isArray(ctx.report.tests_not_run)) {
+    return [
+      {
+        rule: 1,
+        ref: 'exit_report',
+        title: 'the exit report is malformed',
+        needed: 'the report is malformed: tests_executed and tests_not_run must both be arrays (use [] for none)',
+        tool_to_call: 'exec_submit_exit_report',
+      },
+    ];
+  }
+  return [];
+};
+
+export default rule01;
diff --git a/packages/core/src/exec/gate-rules/rule02-blocking-items.ts b/packages/core/src/exec/gate-rules/rule02-blocking-items.ts
new file mode 100644
index 0000000..4f7725b
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule02-blocking-items.ts
@@ -0,0 +1,19 @@
+import { blockingOpen } from '../open-items';
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 2 — no active blocking open item.
+ *
+ * An accepted/deferred item does not block: only the *active* states
+ * (open/blocked/awaiting_human) do, which is what `blockingOpen` means.
+ */
+const rule02: Rule = (ctx: GateContext): BlockedRef[] =>
+  blockingOpen(ctx.open_items).map((i) => ({
+    rule: 2,
+    ref: i.code,
+    title: i.title,
+    needed: 'resolve with proof (note >= 20 chars) or ask the human — never defer it yourself',
+    tool_to_call: 'ledger_resolve_item',
+  }));
+
+export default rule02;
diff --git a/packages/core/src/exec/gate-rules/rule03-criteria-evidence.ts b/packages/core/src/exec/gate-rules/rule03-criteria-evidence.ts
new file mode 100644
index 0000000..94f2557
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule03-criteria-evidence.ts
@@ -0,0 +1,25 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 3 — every criterion has valid evidence, or a human's waiver.
+ *
+ * "Valid" is stricter than "some evidence exists": an evidence row whose ref
+ * cannot be read by an auditor does not count, and the answer says which of
+ * the two problems it is so the agent fixes the right one.
+ */
+const rule03: Rule = (ctx: GateContext): BlockedRef[] =>
+  ctx.criteria
+    .filter((c) => c.status !== 'waived' && c.valid_evidence_count === 0)
+    .map((c) => ({
+      rule: 3,
+      ref: c.code,
+      title: c.text.slice(0, 120),
+      needed:
+        c.evidence_count > 0
+          ? 'evidence exists but is not verifiable (ref missing or output empty) — add valid evidence'
+          : 'add evidence',
+      tool_to_call: 'ledger_add_evidence',
+    }))
+    .filter(Boolean) as BlockedRef[];
+
+export default rule03;
diff --git a/packages/core/src/exec/gate-rules/rule04-approvals.ts b/packages/core/src/exec/gate-rules/rule04-approvals.ts
new file mode 100644
index 0000000..50702da
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule04-approvals.ts
@@ -0,0 +1,51 @@
+import { classify } from '../policy';
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 4 — no pending or rejected approval whose change was already applied.
+ *
+ * The level comes from the policy engine, never from the agent: a decision
+ * that policy denies may not be applied at all, and one that policy demands
+ * approval for stays shut until a human approved it.
+ */
+const rule04: Rule = (ctx: GateContext): BlockedRef[] => {
+  const out: BlockedRef[] = [];
+  for (const d of ctx.decisions) {
+    const level = classify(ctx.policy, { touches: d.touches, reversible: d.reversible }).level;
+    // The journal is the record of what actually ran. A `done` action whose
+    // target is this decision is applied even if an older caller did not set
+    // exec_decisions.applied_at; a rejected change must still be reverted.
+    const applied = d.applied || ctx.journal.some((j) => j.status === 'done' && j.target === d.code);
+    if (level === 'deny' && applied) {
+      out.push({
+        rule: 4,
+        ref: d.code,
+        title: d.title,
+        needed: 'the change is denied by policy — revert it and ask the human',
+        tool_to_call: 'ledger_ask_human',
+      });
+      continue;
+    }
+    if (level !== 'approval' && level !== 'deny') continue;
+    if (d.approval_state === 'pending') {
+      out.push({
+        rule: 4,
+        ref: d.code,
+        title: d.title,
+        needed: 'await human approval before closing',
+        tool_to_call: 'ledger_ask_human',
+      });
+    } else if (d.approval_state === 'rejected' && applied) {
+      out.push({
+        rule: 4,
+        ref: d.code,
+        title: d.title,
+        needed: 'decision was rejected but the change is applied — revert it',
+        tool_to_call: 'ledger_record_decision',
+      });
+    }
+  }
+  return out;
+};
+
+export default rule04;
diff --git a/packages/core/src/exec/gate-rules/rule05-questions.ts b/packages/core/src/exec/gate-rules/rule05-questions.ts
new file mode 100644
index 0000000..1c1c81e
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule05-questions.ts
@@ -0,0 +1,20 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 5 — no unanswered blocking question.
+ *
+ * Silence is not approval: a blocking question that nobody answered keeps the
+ * task shut, which is why the answer names the wait rather than the work.
+ */
+const rule05: Rule = (ctx: GateContext): BlockedRef[] =>
+  ctx.questions
+    .filter((q) => q.blocking && q.status === 'open')
+    .map((q) => ({
+      rule: 5,
+      ref: q.code,
+      title: `blocking question ${q.code}`,
+      needed: 'waiting for a human answer (silence is not approval)',
+      tool_to_call: 'ledger_list_open',
+    }));
+
+export default rule05;
diff --git a/packages/core/src/exec/gate-rules/rule06-tests.ts b/packages/core/src/exec/gate-rules/rule06-tests.ts
new file mode 100644
index 0000000..f47434e
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule06-tests.ts
@@ -0,0 +1,53 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 6 — no failing test; every not_run test needs a reason AND an item.
+ *
+ * "I did not run it" is allowed, but only with a written reason and an open
+ * item that says so — otherwise a missing test is indistinguishable from a
+ * test that was quietly deleted.
+ */
+const rule06: Rule = (ctx: GateContext): BlockedRef[] => {
+  const out: BlockedRef[] = [];
+  // A missing report is rule 1's business; this rule has nothing to say about it.
+  const report = ctx.report;
+  if (!report) return out;
+  // Rule 1 reports malformed shape. Other rules still run to collect blockers,
+  // so do not let an invalid report crash the gate while that blocker is built.
+  if (!Array.isArray(report.tests_executed) || !Array.isArray(report.tests_not_run)) return out;
+  for (const t of report.tests_executed) {
+    if (t.result === 'fail')
+      out.push({
+        rule: 6,
+        ref: t.name,
+        title: `failing test ${t.name}`,
+        needed: 'fix the failing test (do not weaken or delete it)',
+        tool_to_call: 'ledger_add_open_item',
+      });
+  }
+  for (const t of report.tests_not_run) {
+    const linked = ctx.open_items.some(
+      (i) => i.type === 'test_gap' && i.title.toLowerCase().includes(t.name.toLowerCase().slice(0, 40)),
+    );
+    if (!t.reason || t.reason.trim().length < 20) {
+      out.push({
+        rule: 6,
+        ref: t.name,
+        title: `test not run: ${t.name}`,
+        needed: 'record why the test was not run (>= 20 chars) and add a matching open item',
+        tool_to_call: 'ledger_add_open_item',
+      });
+    } else if (!linked) {
+      out.push({
+        rule: 6,
+        ref: t.name,
+        title: `test not run: ${t.name}`,
+        needed: "add open_item(type='test_gap') for this not_run test",
+        tool_to_call: 'ledger_add_open_item',
+      });
+    }
+  }
+  return out;
+};
+
+export default rule06;
diff --git a/packages/core/src/exec/gate-rules/rule07-review.ts b/packages/core/src/exec/gate-rules/rule07-review.ts
new file mode 100644
index 0000000..5c15c42
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule07-review.ts
@@ -0,0 +1,64 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 7 — the adversarial review of THIS version is done and its blockers closed.
+ *
+ * A review of an older tree does not count: the tree hash is the witness, so a
+ * diff that changed after the review sends the task back to the reviewer
+ * instead of closing on a stale verdict.
+ */
+const rule07: Rule = (ctx: GateContext): BlockedRef[] => {
+  if (!ctx.require_review) return [];
+  const out: BlockedRef[] = [];
+  if (!ctx.review) {
+    out.push({
+      rule: 7,
+      ref: 'review',
+      title: 'the adversarial review of this version',
+      needed: 'call review_task to run the adversarial reviewer on the current diff',
+      tool_to_call: 'review_task',
+    });
+    return out;
+  }
+  if (!ctx.current_tree_hash) {
+    out.push({
+      rule: 7,
+      ref: `review:r${ctx.review.round}`,
+      title: `review round ${ctx.review.round} cannot be freshness-checked`,
+      needed: 'the current worktree hash is unavailable — configure a valid start_ref and allowed review roots, or ask a human to inspect the task',
+      tool_to_call: 'ledger_ask_human',
+    });
+  } else if (ctx.review.tree_hash !== ctx.current_tree_hash) {
+    out.push({
+      rule: 7,
+      ref: `review:r${ctx.review.round}`,
+      title: `review round ${ctx.review.round} is stale`,
+      needed: 'the diff changed after the review — re-run review_task',
+      tool_to_call: 'review_task',
+    });
+  }
+  const arbitrationRef = `review-arbitration:${ctx.task.code}:r${ctx.review.round}:${ctx.review.tree_hash}`;
+  const humanArbitrated = ctx.open_items.some((item) =>
+    item.source === 'reviewer' &&
+    item.type === 'risk' &&
+    item.title.trim().toLowerCase().startsWith('human arbitration required') &&
+    item.related_ref === arbitrationRef &&
+    item.resolved_by === 'human' &&
+    !['open', 'blocked', 'awaiting_human'].includes(item.status),
+  );
+  if ((ctx.review.verdict === 'fail' || ctx.review.open_blocking_findings > 0) && !humanArbitrated) {
+    out.push({
+      rule: 7,
+      ref: `review:r${ctx.review.round}`,
+      title: `review round ${ctx.review.round} did not pass`,
+      needed:
+        ctx.review.round >= ctx.max_review_rounds
+          ? 'review round limit reached — a human must decide (fix, waive, or accept the finding)'
+          : 'fix the blocking review findings and re-run review_task',
+      tool_to_call: ctx.review.round >= ctx.max_review_rounds ? 'ledger_ask_human' : 'review_task',
+    });
+  }
+  return out;
+};
+
+export default rule07;
diff --git a/packages/core/src/exec/gate-rules/rule08-requirements.ts b/packages/core/src/exec/gate-rules/rule08-requirements.ts
new file mode 100644
index 0000000..93edf95
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule08-requirements.ts
@@ -0,0 +1,23 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 8 — every linked requirement is covered by a verified criterion.
+ *
+ * A dropped requirement is out of the gate's hands (dropping one needs human
+ * approval); an active one without a verified criterion is the silent-drop
+ * this rule exists to make impossible.
+ */
+const rule08: Rule = (ctx: GateContext): BlockedRef[] =>
+  ctx.requirements
+    .filter((rq) => rq.status !== 'dropped')
+    .filter((rq) => rq.verified_criteria.length === 0)
+    .map((rq) => ({
+      rule: 8,
+      ref: rq.code,
+      title: `requirement ${rq.code} has no verified criterion`,
+      needed:
+        'this requirement has no verified acceptance criterion — implement it or link/verify a criterion (dropping needs human approval)',
+      tool_to_call: 'req_link_task',
+    }));
+
+export default rule08;
diff --git a/packages/core/src/exec/gate-rules/rule09-plan.ts b/packages/core/src/exec/gate-rules/rule09-plan.ts
new file mode 100644
index 0000000..05af65f
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule09-plan.ts
@@ -0,0 +1,40 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 9 — children are done (or a human cancelled them) and dependencies are done.
+ *
+ * A cancelled child needs a human's waiver naming its code: an agent may not
+ * cancel its own subtask, so the waiver is what makes the exception legible.
+ */
+const rule09: Rule = (ctx: GateContext): BlockedRef[] => {
+  const out: BlockedRef[] = [];
+  for (const c of ctx.task.children) {
+    if (c.status === 'done') continue;
+    if (
+      c.cancelled &&
+      (ctx.task.human_waivers.includes(`cancel:${c.code}`) ||
+        ctx.task.human_waivers.includes(`cancel:${c.code}:${c.req_codes.join(',')}`))
+    )
+      continue;
+    out.push({
+      rule: 9,
+      ref: c.code,
+      title: c.title,
+      needed: 'finish the subtask (or have a human cancel it)',
+      tool_to_call: 'exec_plan_view',
+    });
+  }
+  for (const d of ctx.task.depends_on) {
+    if (d.status !== 'done')
+      out.push({
+        rule: 9,
+        ref: d.code,
+        title: `dependency ${d.code} is '${d.status}'`,
+        needed: `dependency is '${d.status}', not done`,
+        tool_to_call: 'exec_plan_view',
+      });
+  }
+  return out;
+};
+
+export default rule09;
diff --git a/packages/core/src/exec/gate-rules/rule10-facts.ts b/packages/core/src/exec/gate-rules/rule10-facts.ts
new file mode 100644
index 0000000..ac6af19
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule10-facts.ts
@@ -0,0 +1,21 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 10 — no stale or rejected fact that an active decision depends on.
+ *
+ * A stale fact nobody decided anything from is harmless; one an active
+ * decision still rests on means the decision must be revisited.
+ */
+const rule10: Rule = (ctx: GateContext): BlockedRef[] =>
+  ctx.facts
+    .filter((f) => f.status === 'stale' || f.status === 'rejected')
+    .filter((f) => f.active_dependent_decisions.length > 0)
+    .map((f) => ({
+      rule: 10,
+      ref: f.code,
+      title: `fact ${f.code} is ${f.status}`,
+      needed: `re-verify the fact or revisit decision(s) ${f.active_dependent_decisions.join(', ')}`,
+      tool_to_call: 'fact_verify',
+    }));
+
+export default rule10;
diff --git a/packages/core/src/exec/gate-rules/rule11-scope.ts b/packages/core/src/exec/gate-rules/rule11-scope.ts
new file mode 100644
index 0000000..d2d0e52
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule11-scope.ts
@@ -0,0 +1,49 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+import { scopeIssueRef } from '../scope';
+
+/**
+ * Rule 11 — no file outside `allowed_paths` without a human's approval.
+ *
+ * An unmeasurable scope is itself a block: "I could not check" is not "the
+ * check passed", and letting it through would make the rule a decoration.
+ */
+const rule11: Rule = (ctx: GateContext): BlockedRef[] => {
+  // A missing report is rule 1's business — the scope is simply not measurable yet.
+  if (!ctx.report) return [];
+  if (!ctx.scope.available) {
+    if (ctx.scope.human_waived) return [];
+    return [
+      {
+        rule: 11,
+        ref: 'scope',
+        title: 'the scope cannot be measured',
+        needed: `scope cannot be measured (${ctx.scope.unavailable_reason ?? 'no server-captured start reference or manifest'}) — restore a code-measured start_ref/manifest or ask the human to waive explicitly`,
+        tool_to_call: 'scope_check',
+      },
+    ];
+  }
+  const out: BlockedRef[] = [];
+  const active = new Set(['open', 'blocked', 'awaiting_human']);
+  for (const f of ctx.scope.files) {
+    if (f.transient || (f.in_allowed_paths && !f.deleted)) continue;
+    const issueRef = scopeIssueRef(f.path, f.change);
+    const approved = ctx.open_items.some(
+      (item) =>
+        item.source === 'hook' && item.type === 'out_of_scope' && item.related_ref === issueRef &&
+        !active.has(item.status) && item.resolved_by === 'human',
+    );
+    if (approved) continue;
+    out.push({
+      rule: 11,
+      ref: f.path,
+      title: f.deleted ? `deleted file ${f.path}` : `changed file outside allowed_paths: ${f.path}`,
+      needed: f.deleted
+        ? 'this deletion needs explicit human approval: resolve the code-created blocking scope item, or restore the file'
+        : 'outside allowed_paths: ask the human to expand scope or resolve the code-created blocking scope item, then retry',
+      tool_to_call: 'ledger_list_open',
+    });
+  }
+  return out;
+};
+
+export default rule11;
diff --git a/packages/core/src/exec/gate-rules/rule12-baseline.ts b/packages/core/src/exec/gate-rules/rule12-baseline.ts
new file mode 100644
index 0000000..e55c96a
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule12-baseline.ts
@@ -0,0 +1,88 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 12 — exact-SHA CI evidence did not lose or weaken a baseline test.
+ *
+ * The "after" numbers come from the gate, never from the agent: ForgePM does
+ * not run repo code itself, so the baseline is what CI recorded and the
+ * comparison is arithmetic. Deleting a test to go green is never a pass.
+ */
+type CapturedAfter = NonNullable<GateContext['baseline']['after']>;
+
+const rule12: Rule = (ctx: GateContext): BlockedRef[] => {
+  if (!ctx.report) return [];
+  if (!ctx.baseline.ran) return ctx.baseline.human_waived ? [] : [missingBaseline(ctx)];
+  const after = ctx.baseline.after;
+  if (!after || after.sha !== ctx.baseline.current_sha) return [missingCurrentRun()];
+  return [...compareTestResults(ctx, after), ...testWeakening(ctx)];
+};
+
+function missingBaseline(ctx: GateContext): BlockedRef {
+  return {
+    rule: 12,
+    ref: 'baseline',
+    title: 'the CI baseline could not be verified for the exact commit SHAs',
+    needed: `BASELINE_UNAVAILABLE${ctx.baseline.unavailable_reason ? `: ${ctx.baseline.unavailable_reason}` : ''} — capture CI logs matching the task start and current commit SHA, or have a human waive explicitly`,
+    tool_to_call: 'baseline_capture',
+  };
+}
+
+function missingCurrentRun(): BlockedRef {
+  return {
+    rule: 12,
+    ref: 'baseline',
+    title: 'the current CI results do not match the measured commit',
+    needed: 'capture a CI log for the exact current commit SHA; exit-report test claims are ignored',
+    tool_to_call: 'baseline_capture',
+  };
+}
+
+function compareTestResults(ctx: GateContext, after: CapturedAfter): BlockedRef[] {
+  const out: BlockedRef[] = [];
+  for (const baseline of ctx.baseline.tests) {
+    if (baseline.result_at_start !== 'pass') continue;
+    if (!after.present.includes(baseline.name)) {
+      out.push({
+        rule: 12,
+        ref: baseline.name,
+        title: `baseline test ${baseline.name} disappeared`,
+        needed: 'a passing baseline test disappeared — restore it, then capture CI for the new commit',
+        tool_to_call: 'baseline_capture',
+      });
+    } else if (after.results[baseline.name] !== 'pass') {
+      out.push({
+        rule: 12,
+        ref: baseline.name,
+        title: `baseline test ${baseline.name} is no longer green`,
+        needed: `the CI log for ${after.sha} reports '${after.results[baseline.name]}' — fix the cause and capture CI for the new commit`,
+        tool_to_call: 'baseline_capture',
+      });
+    }
+  }
+  const baselineNames = new Set(ctx.baseline.tests.map((test) => test.name));
+  for (const name of after.present) {
+    if (baselineNames.has(name) || after.results[name] === 'pass') continue;
+    out.push({
+      rule: 12,
+      ref: name,
+      title: `new test ${name} is not green`,
+      needed: `the CI log for ${after.sha} reports '${after.results[name]}' for a test not present in the baseline — fix it and capture CI for the new commit`,
+      tool_to_call: 'baseline_capture',
+    });
+  }
+  return out;
+}
+
+function testWeakening(ctx: GateContext): BlockedRef[] {
+  return ctx.baseline.weakening
+    .filter((finding) => finding.count_delta < 0 || finding.modifiers.length > 0)
+    .map((finding): BlockedRef => ({
+      rule: 12,
+      ref: finding.path,
+      title: `protected test file was weakened: ${finding.path}`,
+      needed: `restore assertions and remove test modifiers (${finding.modifiers.join(', ') || 'assertion count decreased'}), then capture CI for the new commit`,
+      tool_to_call: 'baseline_capture',
+    }));
+}
+
+export default rule12;
diff --git a/packages/core/src/exec/gate-rules/rule13-journal.ts b/packages/core/src/exec/gate-rules/rule13-journal.ts
new file mode 100644
index 0000000..e5d7ed6
--- /dev/null
+++ b/packages/core/src/exec/gate-rules/rule13-journal.ts
@@ -0,0 +1,25 @@
+import type { BlockedRef, GateContext, Rule } from '../gate-types';
+
+/**
+ * Rule 13 — no journal row left in `started` or `unknown`.
+ *
+ * A row that was started and never finished means an action of unknown
+ * outcome is still out there; `unknown` asks for the real state to be
+ * determined first, because repeating a non-idempotent action is exactly the
+ * damage the journal exists to prevent.
+ */
+const rule13: Rule = (ctx: GateContext): BlockedRef[] =>
+  ctx.journal
+    .filter((j) => j.status === 'started' || j.status === 'unknown')
+    .map((j) => ({
+      rule: 13,
+      ref: j.code,
+      title: j.action,
+      needed:
+        j.status === 'unknown'
+          ? 'determine the real state first, then journal_done/journal_fail'
+          : 'finish the action and call journal_done (or journal_fail with a note)',
+      tool_to_call: 'journal_done',
+    }));
+
+export default rule13;
diff --git a/packages/core/src/exec/gate-types.ts b/packages/core/src/exec/gate-types.ts
new file mode 100644
index 0000000..f78966b
--- /dev/null
+++ b/packages/core/src/exec/gate-types.ts
@@ -0,0 +1,206 @@
+import type { ExecPolicy } from '@forgepm/shared';
+
+/**
+ * The gate's vocabulary (docs/EXECUTION_CONTROL_PLAN.md §8).
+ *
+ * These types were moved out of `gate.ts` when PE-3 split the thirteen rules
+ * into `gate-rules/`: the file had to come back under the 400-line cap (C.11)
+ * and the shapes are shared by the rules, the context loader and the report
+ * builder. Nothing here decides anything — it only names what the rules read.
+ */
+
+export interface GateCriterion {
+  code: string;
+  status: 'pending' | 'verified' | 'waived';
+  evidence_count: number;
+  valid_evidence_count: number;
+  has_waiver_approval: boolean;
+  req_code: string | null;
+  text: string;
+}
+
+export interface GateOpenItem {
+  code: string;
+  title: string;
+  type: string;
+  status: 'open' | 'resolved' | 'accepted' | 'deferred' | 'wont_fix' | 'blocked' | 'awaiting_human' | 'not_applicable';
+  blocks_completion: boolean;
+  source: string;
+  related_ref?: string | null;
+  /** Needed to distinguish an explicit human arbitration from an automatic pass. */
+  resolved_by?: 'agent' | 'human' | null;
+}
+
+export interface GateDecision {
+  code: string;
+  title: string;
+  touches: string[];
+  reversible: boolean;
+  approval_state: 'not_required' | 'pending' | 'approved' | 'rejected';
+  applied: boolean;
+  status: 'proposed' | 'active' | 'superseded' | 'needs_revisit';
+}
+
+export interface GateQuestion {
+  code: string;
+  blocking: boolean;
+  status: 'open' | 'answered' | 'canceled';
+}
+
+export interface GateFact {
+  code: string;
+  status: 'active' | 'stale' | 'rejected' | 'superseded';
+  active_dependent_decisions: string[];
+}
+
+export interface GateRequirement {
+  code: string;
+  status: 'active' | 'changed' | 'dropped';
+  verified_criteria: string[];
+}
+
+export interface GateJournalRow {
+  code: string;
+  action: string;
+  status: 'started' | 'done' | 'failed' | 'unknown';
+  idempotent: boolean;
+  /** A completed action may name the decision code it applied (for example D-001). */
+  target?: string | null;
+}
+
+export interface GateBaselineRow {
+  name: string;
+  result_at_start: 'pass' | 'fail' | 'skip';
+  source?: 'ci' | 'human';
+}
+
+export interface GateReport {
+  summary?: string;
+  tests_executed: { name: string; result: 'pass' | 'fail' | 'not_run'; evidence_ref: string }[];
+  tests_not_run: { name: string; reason?: string }[];
+  changed_files: string[];
+}
+
+export interface GateExitReport {
+  tests_executed: { name: string; result: 'pass' | 'fail'; evidence_ref: string }[];
+  tests_not_run: { name: string; reason: string }[];
+  incomplete: string[];
+  assumptions: string[];
+  risks_found: string[];
+}
+
+export interface GateReview {
+  round: number;
+  verdict: 'pass' | 'fail';
+  tree_hash: string;
+  open_blocking_findings: number;
+}
+
+export interface GateTask {
+  code: string;
+  status: 'not_started' | 'in_progress' | 'awaiting_review' | 'blocked' | 'done';
+  children: { code: string; title: string; status: GateTask['status']; req_codes: string[]; cancelled: boolean }[];
+  depends_on: { code: string; status: GateTask['status'] }[];
+  human_waivers: string[];
+}
+
+export interface GateScope {
+  available: boolean;
+  basis: 'git' | 'manifest' | 'none';
+  unavailable_reason: string | null;
+  human_waived: boolean;
+  files: {
+    path: string;
+    change: 'A' | 'M' | 'D' | 'R' | 'T';
+    in_allowed_paths: boolean;
+    deleted: boolean;
+    transient: boolean;
+  }[];
+  tree_hash: string | null;
+}
+
+export interface GateBaseline {
+  /** True only when CI logs for both exact commit SHAs were parsed successfully. */
+  ran: boolean;
+  unavailable_reason: string | null;
+  human_waived: boolean;
+  start_sha: string | null;
+  current_sha: string | null;
+  tests: GateBaselineRow[];
+  after: {
+    sha: string;
+    run_id: string;
+    job: string;
+    present: string[];
+    results: Record<string, 'pass' | 'fail' | 'skip'>;
+  } | null;
+  weakening: { path: string; count_delta: number; modifiers: string[] }[];
+}
+
+/**
+ * The gate stamp (C.9b). `done` is only ever true when the newest stamp for the
+ * task says `ok` and its `tree_hash` is the tree the task is being closed on —
+ * a hand-written `status='done'` therefore has no stamp to point at.
+ */
+export interface GateStamp {
+  stamp_id: string | null;
+  ok: boolean;
+  tree_hash: string | null;
+  gate_version: number;
+}
+
+export interface GateContext {
+  gate_version: number;
+  policy: ExecPolicy;
+  require_review: boolean;
+  max_review_rounds: number;
+  task: GateTask;
+  criteria: GateCriterion[];
+  open_items: GateOpenItem[];
+  decisions: GateDecision[];
+  questions: GateQuestion[];
+  facts: GateFact[];
+  requirements: GateRequirement[];
+  journal: GateJournalRow[];
+  review: GateReview | null;
+  current_tree_hash: string | null;
+  scope: GateScope;
+  baseline: GateBaseline;
+  /** The exit report, or null when the task never submitted one (rule 1). */
+  report: GateReport | null;
+  /** Verbatim strings from the accepted exit report (already promoted to items). */
+  report_assumptions?: string[];
+  /** The task's own gate stamp, for C.9b. */
+  stamp?: GateStamp;
+}
+
+export interface BlockedRef {
+  rule: number;
+  /** What the block is about: an item code, a criterion code, a file, a test. */
+  ref: string;
+  /** One short line saying what is blocked — the same shape for every rule. */
+  title: string;
+  /** What has to happen before the task may close. */
+  needed: string;
+  /** The tool that can move it. */
+  tool_to_call?: string;
+}
+
+/** A rule is a pure function over the snapshot: same rows in, same answer out. */
+export type Rule = (ctx: GateContext) => BlockedRef[];
+
+/**
+ * The completion report (plan §8.2) — always generated FROM the ledger, never
+ * from the agent's prose.
+ */
+export interface FinalReport {
+  task: string;
+  summary: string;
+  completed: { criterion: string; evidence: number }[];
+  accepted_or_deferred: GateOpenItem[];
+  decisions: { code: string; title: string; level: string; approval_state: string }[];
+  needs_human_review: string[];
+  assumptions: string[];
+  out_of_scope: string[];
+  counts: { criteria_verified: number; criteria_pending: number; open_blocking: number; review_rounds: number };
+}
