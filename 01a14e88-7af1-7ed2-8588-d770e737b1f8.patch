@@ -0,0 +1,124 @@
+import { describe, expect, it } from 'vitest';
+import { checkCriteria, parseTaskStart } from './task-start';
+
+/**
+ * PE-2 §7 B.1/B.2/B.3 — the shape of a task-start payload and the checkability of
+ * its criteria, proven without a database. Existence questions (`req_ids`, the task
+ * ref) are the ledger's answer, not the parser's, so they are deliberately absent here.
+ */
+
+const GOOD = 'POST /api/v1/x returns 201 and one outbox row; test:exec_task_start_ok';
+const base = {
+  title: 'PE-2 tool slice',
+  acceptance_criteria: [GOOD],
+  allowed_paths: ['packages/core/src/exec/**'],
+};
+
+describe('parseTaskStart — shape only (B.1)', () => {
+  it('accepts the documented minimal payload and applies defaults', () => {
+    const r = parseTaskStart(base);
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    expect(r.value).toMatchObject({
+      title: 'PE-2 tool slice',
+      criteria: [GOOD],
+      reqIds: [],
+      allowedPaths: ['packages/core/src/exec/**'],
+    });
+  });
+
+  it('refuses every missing required field with a structured answer, never a throw', () => {
+    const cases: [string, unknown][] = [
+      ['no title', { acceptance_criteria: [GOOD], allowed_paths: ['a'] }],
+      ['title too short', { ...base, title: 'ab' }],
+      ['title not a string', { ...base, title: 42 }],
+      ['no criteria', { title: 'x', allowed_paths: ['a'] }],
+      ['empty criteria array', { ...base, acceptance_criteria: [] }],
+      ['criteria not an array', { ...base, acceptance_criteria: GOOD }],
+      ['no allowed_paths', { title: 'x', acceptance_criteria: [GOOD] }],
+      ['empty allowed_paths', { ...base, allowed_paths: [] }],
+      ['allowed_paths wrong element type', { ...base, allowed_paths: [1] }],
+      ['null payload', null],
+      ['array payload', []],
+      ['string payload', 'exec_task_start'],
+    ];
+    for (const [what, raw] of cases) {
+      const r = parseTaskStart(raw);
+      expect(r.ok, what).toBe(false);
+      if (r.ok) continue;
+      expect(r.code, what).toBe('VALIDATION_ERROR');
+      expect(r.message.length, what).toBeGreaterThan(0);
+      expect(r.needed_action.length, what).toBeGreaterThan(5);
+    }
+  });
+
+  it('refuses unknown keys instead of ignoring them (strictObject)', () => {
+    // The computed key is deliberate: both `__proto__: v` and `'__proto__': v` in an
+    // object literal set the prototype instead of adding a property, so only
+    // `{ ['__proto__']: v }` is an unknown *field* for strictObject to refuse.
+    const protoKey = { ['__proto__']: 'nope' };
+    for (const extra of [{ status: 'done' }, { id: '1' }, protoKey, { work_item_id: 'x' }, { start_ref: 'a'.repeat(40) }]) {
+      const r = parseTaskStart({ ...base, ...extra });
+      expect(r.ok, JSON.stringify(extra)).toBe(false);
+    }
+  });
+
+  it('refuses an idempotency key too short to be a real key', () => {
+    expect(parseTaskStart({ ...base, idempotency_key: 'abc' }).ok).toBe(false);
+    expect(parseTaskStart({ ...base, idempotency_key: 'idem-12345' }).ok).toBe(true);
+  });
+
+  it('refuses a task list longer than the ledger will read back', () => {
+    expect(parseTaskStart({ ...base, acceptance_criteria: Array(51).fill(GOOD) }).ok).toBe(false);
+    expect(parseTaskStart({ ...base, allowed_paths: Array(201).fill('a') }).ok).toBe(false);
+  });
+});
+
+describe('checkCriteria — testability is code, not taste (B.2)', () => {
+  it('refuses the two documented vague examples', () => {
+    for (const vague of ['the feature works well', 'امن باشد']) {
+      const r = checkCriteria([vague]);
+      expect(r.ok, vague).toBe(false);
+      if (r.ok) continue;
+      expect(r.code).toBe('CRITERION_NOT_CHECKABLE');
+      expect(r.needed_action).toMatch(/rewrite|reference/i);
+      expect(r.examples.length).toBeGreaterThan(1);
+      expect(r.examples.join(' ')).toMatch(/returns 401|Tests {2}12 passed/);
+    }
+  });
+
+  /* the 10-row table the plan asks for: 5 acceptable, 5 refused */
+  const table: [string, boolean][] = [
+    ['GET /api/v1/exec/ledger returns 404 for an unknown task code; test:ledger_404', true],
+    ['cmd:npm run test:unit returns exit code 0 and prints the passing count', true],
+    [
+      'the migration file contains exec_append_only() and is not edited after merge; file:packages/core/src/db/migrations/0010_exec.migration.ts',
+      true,
+    ],
+    ['ui: the board column displays the dragged card key after the drop; test:chain.spec.ts', true],
+    ['commit abc1234 adds the CHECK that rejects a done task without closed_at; commit:abc1234', true],
+    ['the ledger is robust and secure', false],
+    ['handler should return proper values', false],
+    ['کد باید تمیز باشد و خوب کار کند', false],
+    ['fast enough for users', false],
+    ['the tests pass, I think', false],
+  ];
+  it.each(table)('classifies %s', (text, ok) => {
+    expect(checkCriteria([text]).ok).toBe(ok);
+  });
+
+  it('reports the offending index so a batch of 20 criteria is fixable in one pass', () => {
+    const r = checkCriteria([GOOD, 'it works well', GOOD, 'secure']);
+    expect(r.ok).toBe(false);
+    if (r.ok) return;
+    expect(r.bad.map((b) => b.index)).toEqual([1, 3]);
+    expect(r.bad[1]?.errors.length).toBeGreaterThan(0);
+  });
+
+  it('does not invent a duplicate of the shared word lists', () => {
+    // the law lives in @forgepm/shared (AMBIGUOUS_WORDS/CHECKABLE_MARKERS/READABLE_REF_RE);
+    // this module only maps its answer into the tool's error shape.
+    const r = checkCriteria([GOOD]);
+    expect(r.ok).toBe(true);
+  });
+});
diff --git a/packages/core/src/exec/task-start.ts b/packages/core/src/exec/task-start.ts
new file mode 100644
index 0000000..9faa7bc
--- /dev/null
+++ b/packages/core/src/exec/task-start.ts
@@ -0,0 +1,276 @@
+import { sql } from 'kysely';
+import { AppError, assessCheckable, taskStartInputSchema, type TaskStartInput } from '@forgepm/shared';
+import { newId } from '../id';
+import { toJsonb } from '../jsonb';
+import type { DbLike } from '../db/unitOfWork';
+import { allocateLedgerCode } from './codes';
+import { appendEvent } from './events';
+import { makeScopeManifest, type ScopeFileManifest } from './scope';
+import type { LedgerActor, ParseResult } from './open-items-service';
+
+/**
+ * `exec_task_start`'s ledger half (plan §7 B.2/B.4): the task row, its acceptance
+ * criteria, and the one `exec_events` row that records the creation.
+ *
+ * Split like the open-item service — a shape answer and a law answer are different
+ * questions. `parseTaskStart` only asks whether the payload is a well-formed object;
+ * `checkCriteria` asks whether each criterion is *verifiable*, which is a rule
+ * (`assessCheckable` in @forgepm/shared) and not something a string can satisfy by
+ * length alone. The caller owns the transaction, so work item + task + criteria +
+ * audit + this event commit or roll back together (B.4).
+ */
+
+export interface TaskStartValue {
+  title: string;
+  description: string | null;
+  criteria: string[];
+  reqIds: string[];
+  allowedPaths: string[];
+  idempotencyKey?: string;
+  projectRef?: string;
+}
+
+export interface TaskCreatedRow {
+  task_id: string;
+  code: string;
+  title: string;
+  status: string;
+  work_item_id: string;
+  allowed_paths: string[];
+  criterion_ids: string[];
+  criterion_codes: string[];
+  /** Declared, not covered: rule 8 needs a verified criterion linked to the requirement. */
+  req_ids: string[];
+  /** Captured by the API's read-only repository adapter, never supplied by the task author. */
+  start_ref: string | null;
+}
+
+export type CriteriaCheck =
+  | { ok: true }
+  | {
+      ok: false;
+      code: 'CRITERION_NOT_CHECKABLE';
+      message: string;
+      needed_action: string;
+      examples: string[];
+      bad: { index: number; text: string; errors: string[] }[];
+    };
+
+function shapeFailure(err: { issues: { path: (string | number)[]; message: string }[] }): {
+  message: string;
+  needed_action: string;
+} {
+  const issue = err.issues[0] ?? { path: [], message: 'payload did not parse' };
+  return {
+    message: issue.path.length ? `${issue.path.join('.')}: ${issue.message}` : issue.message,
+    needed_action: 'send { title, acceptance_criteria[], allowed_paths[] }; every criterion must name a check',
+  };
+}
+
+/** Shape-check a task-start payload. Unknown keys are refused, not ignored. */
+export function parseTaskStart(raw: unknown): ParseResult<TaskStartValue> {
+  const parsed = taskStartInputSchema.safeParse(raw ?? {});
+  if (!parsed.success) {
+    const why = shapeFailure(parsed.error as never);
+    return { ok: false, code: 'VALIDATION_ERROR', ...why };
+  }
+  const v = parsed.data as TaskStartInput;
+  return {
+    ok: true,
+    value: {
+      title: v.title,
+      description: v.description ?? null,
+      criteria: [...v.acceptance_criteria],
+      reqIds: [...v.req_ids],
+      allowedPaths: [...v.allowed_paths],
+      ...(v.idempotency_key ? { idempotencyKey: v.idempotency_key } : {}),
+      ...(v.project_ref ? { projectRef: v.project_ref } : {}),
+    },
+  };
+}
+
+/**
+ * Map `assessCheckable` onto the tool's error shape, reporting **every** bad criterion
+ * at once: an agent that gets one index per round-trip fixes a 20-row list in 20
+ * round-trips, which is how a rule becomes a formality.
+ */
+export function checkCriteria(texts: string[]): CriteriaCheck {
+  const bad: { index: number; text: string; errors: string[] }[] = [];
+  let action: string | null = null; // first refusal wins: one instruction, not five variants
+  let examples: string[] = [];
+  texts.forEach((text, index) => {
+    const r = assessCheckable(text);
+    if (r.ok) return;
+    bad.push({ index, text, errors: r.errors });
+    action ??= r.needed_action ?? 'rewrite the criterion as an observable outcome with a reference';
+    examples = r.examples;
+  });
+  if (!bad.length) return { ok: true };
+  return {
+    ok: false,
+    code: 'CRITERION_NOT_CHECKABLE',
+    message: `${bad.length} of ${texts.length} criteria are not checkable: ${bad
+      .map((b) => `#${b.index} — ${b.errors.join(', ')}`)
+      .join(' | ')}`,
+    needed_action: action ?? 'rewrite the criterion as an observable outcome with a reference',
+    examples,
+    bad,
+  };
+}
+
+/** Requirements the caller claims must exist here — a typo is not a link. */
+async function assertRequirementsExist(db: DbLike, actor: LedgerActor, refs: string[]): Promise<void> {
+  if (!refs.length) return;
+  const found = await sql<{ id: string; code: string }>`
+    SELECT id::text AS id, code FROM exec_requirements
+    WHERE organization_id = ${actor.organizationId}
+      AND (project_id = ${actor.projectId} OR project_id IS NULL)
+      AND (id::text = ANY(${refs}::text[]) OR code = ANY(${refs}::text[]))
+  `.execute(db as never);
+  const known = new Set<string>();
+  for (const row of found.rows) {
+    known.add(row.id);
+    known.add(row.code);
+  }
+  const missing = refs.filter((r) => !known.has(r));
+  if (missing.length) {
+    throw new AppError('NOT_FOUND', `no requirement '${missing[0]}' in this project`, {
+      missing,
+      needed_action: 'record it with req_add first; a task may not claim a requirement that was never written down',
+    });
+  }
+}
+
+async function taskRow(db: DbLike, id: string): Promise<TaskCreatedRow> {
+  const r = await sql<{
+    id: string;
+    code: string;
+    title: string;
+    status: string;
+    work_item_id: string;
+    allowed_paths: unknown;
+    start_ref: string | null;
+  }>`
+    SELECT id, code, title, status, work_item_id::text AS work_item_id, allowed_paths, start_ref
+    FROM exec_tasks WHERE id = ${id}::uuid
+  `.execute(db as never);
+  const row = r.rows[0];
+  if (!row) throw new AppError('INTERNAL', 'task row vanished after insert');
+  return {
+    task_id: row.id,
+    code: row.code,
+    title: row.title,
+    status: row.status,
+    work_item_id: row.work_item_id,
+    allowed_paths: Array.isArray(row.allowed_paths) ? (row.allowed_paths as string[]) : [],
+    start_ref: row.start_ref,
+    criterion_ids: [],
+    criterion_codes: [],
+    req_ids: [],
+  };
+}
+
+/**
+ * Write the task and its criteria. `workItemId` is required by the schema
+ * (`exec_tasks.work_item_id NOT NULL`), which is what keeps the ledger and the
+ * board from drifting apart: a ledger task always has a work item behind it.
+ */
+export interface CreateTaskOptions {
+  /** Server-measured commit SHA from the configured read-only Git source. */
+  startRef?: string | null;
+  /** Hash-only snapshot for a Git-less workspace; never accepted from task input. */
+  startManifest?: ScopeFileManifest | null;
+  /** Parent ledger task when this row is created by task_split. */
+  parentTaskId?: string | null;
+}
+
+export async function createTask(
+  db: DbLike,
+  actor: LedgerActor,
+  workItemId: string,
+  raw: unknown,
+  options: CreateTaskOptions = {},
+): Promise<TaskCreatedRow> {
+  const parsed = parseTaskStart(raw);
+  if (!parsed.ok) throw new AppError('VALIDATION_ERROR', parsed.message, { needed_action: parsed.needed_action });
+  const laws = checkCriteria(parsed.value.criteria);
+  if (!laws.ok) {
+    throw new AppError('CRITERION_NOT_CHECKABLE', laws.message, {
+      needed_action: laws.needed_action,
+      examples: laws.examples,
+      criteria: laws.bad,
+    });
+  }
+  await assertRequirementsExist(db, actor, parsed.value.reqIds);
+
+  let startManifest: ScopeFileManifest | null = null;
+  if (!options.startRef && options.startManifest) {
+    try {
+      startManifest = makeScopeManifest(options.startManifest.files);
+    } catch {
+      throw new AppError('VALIDATION_ERROR', 'server-measured scope manifest is invalid', {
+        needed_action: 'retry task creation with a stable read-only workspace snapshot',
+      });
+    }
+    if (startManifest.hash !== options.startManifest.hash) {
+      throw new AppError('VALIDATION_ERROR', 'server-measured scope manifest hash is inconsistent', {
+        needed_action: 'retry task creation with a stable read-only workspace snapshot',
+      });
+    }
+  }
+
+  const id = newId();
+  const code = await allocateLedgerCode(db, actor.projectId, 'T');
+  await sql`
+    INSERT INTO exec_tasks
+      (id, organization_id, project_id, work_item_id, parent_id, code, title, description, status, start_ref, allowed_paths)
+    VALUES (${id}, ${actor.organizationId}, ${actor.projectId}, ${workItemId}::uuid, ${options.parentTaskId ?? null}::uuid, ${code},
+            ${parsed.value.title}, ${parsed.value.description}, 'not_started', ${options.startRef ?? null},
+            ${toJsonb(parsed.value.allowedPaths)}::jsonb)
+  `.execute(db as never);
+
+  const criterionIds: string[] = [];
+  const criterionCodes: string[] = [];
+  for (const text of parsed.value.criteria) {
+    const cId = newId();
+    const cCode = await allocateLedgerCode(db, actor.projectId, 'C');
+    await sql`
+      INSERT INTO exec_criteria (id, task_id, code, text, status)
+      VALUES (${cId}, ${id}::uuid, ${cCode}, ${text}, 'pending')
+    `.execute(db as never);
+    criterionIds.push(cId);
+    criterionCodes.push(cCode);
+  }
+
+  const row = await taskRow(db, id);
+  row.criterion_ids = criterionIds;
+  row.criterion_codes = criterionCodes;
+  row.req_ids = parsed.value.reqIds;
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: id,
+    entity: 'task',
+    entity_id: id,
+    entity_code: code,
+    action: 'task.created',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: { before: null, after: row },
+  });
+  if (startManifest) {
+    await appendEvent(db, {
+      organization_id: actor.organizationId,
+      task_id: id,
+      entity: 'task',
+      entity_id: id,
+      entity_code: code,
+      action: 'scope.manifest_captured',
+      actor_type: 'system',
+      actor_id: 'exec-scope-manifest',
+      tool: 'exec_task_start',
+      payload: { version: 1, hash: startManifest.hash, files: startManifest.files },
+    });
+  }
+  return row;
+}
diff --git a/packages/core/src/exec/waiver.ts b/packages/core/src/exec/waiver.ts
new file mode 100644
index 0000000..76b796a
--- /dev/null
+++ b/packages/core/src/exec/waiver.ts
@@ -0,0 +1,285 @@
+import { sql } from 'kysely';
+import { AppError } from '@forgepm/shared';
+import type { DbLike } from '../db/unitOfWork';
+import { appendEvent } from './events';
+import { recordHumanDecision } from './approvals';
+import type { LedgerActor } from './open-items-service';
+
+/**
+ * The human's two "this demand will not happen" verbs (plan §9.5):
+ * waive a criterion, drop a requirement.
+ *
+ * Both are the same kind of act, so they are written the same way:
+ *
+ *   • the ledger's own CHECK demands a justification (`drop_reason` ≥ 10
+ *     characters; a waiver without a reason is a deletion with extra steps),
+ *   • and the schema demands a BACKING APPROVAL — a waived criterion points
+ *     at the approval that waived it (`waiver_approval_id`), because "the
+ *     human waived it" must be something an auditor can read, not a status.
+ *     So each of these writes an approval row that is already decided, and
+ *     the ledger points at it.
+ *
+ * The agent has no way to do any of this: the plan's tool table (§4.0) has no
+ * `criterion_waive` and no `req_drop` on purpose, and the service refuses a
+ * non-human actor even if a caller forgets that.
+ */
+
+const MIN_REASON = 10;
+
+export interface WaiveResult {
+  kind: 'criterion';
+  id: string;
+  code: string;
+  task_code: string;
+  status: 'waived';
+  approval_id: string;
+  reason: string;
+}
+
+export interface DropResult {
+  kind: 'requirement';
+  id: string;
+  code: string;
+  status: 'dropped';
+  approval_id: string;
+  reason: string;
+  waived_criteria: string[];
+}
+
+/** Only a human may remove a demand; the agent may ask, never decide. */
+function assertHuman(actor: LedgerActor): void {
+  if (actor.actorType === 'agent') {
+    throw new AppError('FORBIDDEN', 'only a human may waive a criterion or drop a requirement', {
+      needed_action: 'ask the human (ledger_ask_human) — the ledger records who decided, and that is not the agent',
+    });
+  }
+}
+
+function checkReason(reason: string): string {
+  const text = (reason ?? '').trim();
+  if (text.length < MIN_REASON) {
+    throw new AppError('VALIDATION_ERROR', `the reason is too short (${text.length} characters)`, {
+      needed_action: 'write what changed and why — a waiver without a reason is a deletion with extra steps',
+    });
+  }
+  return text;
+}
+
+/**
+ * The approval row behind a human's decision: already decided, by the human.
+ * (`recordHumanDecision` writes it; the ledger points at it afterwards.)
+ */
+async function decidedApproval(
+  db: DbLike,
+  actor: LedgerActor,
+  action: string,
+  payload: Record<string, unknown>,
+  reason: string,
+): Promise<string> {
+  return recordHumanDecision(db, {
+    organizationId: actor.organizationId,
+    projectId: actor.projectId,
+    actorId: actor.actorId,
+    action,
+    payload,
+    reason,
+  });
+}
+
+/**
+ * Waive one acceptance criterion of a task.
+ *
+ * A verified criterion is NOT waived: it is already proven, and turning a
+ * proof into a waiver would erase the very evidence the human is relying on.
+ */
+export async function waiveCriterion(
+  db: DbLike,
+  actor: LedgerActor,
+  code: string,
+  reason: string,
+): Promise<WaiveResult> {
+  assertHuman(actor);
+  const text = checkReason(reason);
+
+  const rows = await sql<{
+    id: string;
+    code: string;
+    status: string;
+    task_id: string;
+    task_code: string;
+    task_status: string;
+  }>`
+    SELECT c.id::text AS id, c.code, c.status, t.id::text AS task_id, t.code AS task_code, t.status AS task_status
+    FROM exec_criteria c JOIN exec_tasks t ON t.id = c.task_id
+    WHERE t.organization_id = ${actor.organizationId}::uuid
+      AND (c.code = ${code} OR c.id::text = ${code})
+    LIMIT 1
+  `.execute(db as never);
+  const criterion = rows.rows[0];
+  if (!criterion) {
+    throw new AppError('NOT_FOUND', `no criterion '${code}' in this organisation`, { ref: code });
+  }
+  if (criterion.task_status === 'done') {
+    throw new AppError('LEDGER_STATE_INVALID', `task ${criterion.task_code} is already closed`, {
+      needed_action: 'a closed task keeps the criteria it was closed with; open a new task for new work',
+    });
+  }
+  if (criterion.status === 'verified') {
+    throw new AppError('LEDGER_STATE_INVALID', `criterion ${criterion.code} is already verified`, {
+      needed_action: 'a proven criterion does not need a waiver — the evidence stands',
+    });
+  }
+  if (criterion.status === 'waived') {
+    throw new AppError('LEDGER_STATE_INVALID', `criterion ${criterion.code} is already waived`);
+  }
+
+  const approvalId = await decidedApproval(
+    db,
+    actor,
+    'exec.waive_criterion',
+    { criterion_id: criterion.id, code: criterion.code, task_code: criterion.task_code, reason: text },
+    text,
+  );
+
+  await sql`
+    UPDATE exec_criteria
+    SET status = 'waived', waiver_approval_id = ${approvalId}::uuid
+    WHERE id = ${criterion.id}::uuid
+  `.execute(db as never);
+
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: criterion.task_id,
+    entity: 'criterion',
+    entity_id: criterion.id,
+    entity_code: criterion.code,
+    action: 'task.waived',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: {
+      before: { status: criterion.status },
+      after: { status: 'waived', waiver: `criterion:${criterion.code}`, approval_id: approvalId, reason: text },
+    },
+  });
+
+  return {
+    kind: 'criterion',
+    id: criterion.id,
+    code: criterion.code,
+    task_code: criterion.task_code,
+    status: 'waived',
+    approval_id: approvalId,
+    reason: text,
+  };
+}
+
+/**
+ * Drop a requirement of the organisation.
+ *
+ * Dropping a requirement removes a promise the project made, so the ledger
+ * keeps the promise with a `drop_reason` and a `dropped_by` — a dropped
+ * requirement is not deleted, it is *dropped*, by a named human. The criteria
+ * that were linked to it cannot be verified any more (nobody has to implement
+ * a dropped requirement), so they are waived against the same approval.
+ */
+export async function dropRequirement(
+  db: DbLike,
+  actor: LedgerActor,
+  code: string,
+  reason: string,
+): Promise<DropResult> {
+  assertHuman(actor);
+  const text = checkReason(reason);
+
+  const rows = await sql<{ id: string; code: string; status: string; project_id: string }>`
+    SELECT id::text AS id, code, status, project_id::text AS project_id
+    FROM exec_requirements
+    WHERE organization_id = ${actor.organizationId}::uuid
+      AND (code = ${code} OR id::text = ${code})
+    LIMIT 1
+  `.execute(db as never);
+  const requirement = rows.rows[0];
+  if (!requirement) {
+    throw new AppError('NOT_FOUND', `no requirement '${code}' in this organisation`, { ref: code });
+  }
+  if (requirement.status === 'dropped') {
+    throw new AppError('LEDGER_STATE_INVALID', `requirement ${requirement.code} is already dropped`);
+  }
+
+  const approvalId = await decidedApproval(
+    db,
+    actor,
+    'exec.drop_requirement',
+    { requirement_id: requirement.id, code: requirement.code, reason: text },
+    text,
+  );
+
+  await sql`
+    UPDATE exec_requirements
+    SET status = 'dropped', drop_reason = ${text}, dropped_by = 'human', updated_at = now()
+    WHERE id = ${requirement.id}::uuid
+  `.execute(db as never);
+
+  const linked = await sql<{ id: string; code: string; status: string; task_id: string }>`
+    SELECT id::text AS id, code, status, task_id::text AS task_id
+    FROM exec_criteria
+    WHERE req_id = ${requirement.id}::uuid AND status = 'pending'
+  `.execute(db as never);
+
+  const waived: string[] = [];
+  for (const criterion of linked.rows) {
+    await sql`
+      UPDATE exec_criteria
+      SET status = 'waived', waiver_approval_id = ${approvalId}::uuid
+      WHERE id = ${criterion.id}::uuid
+    `.execute(db as never);
+    waived.push(criterion.code);
+    await appendEvent(db, {
+      organization_id: actor.organizationId,
+      task_id: criterion.task_id,
+      entity: 'criterion',
+      entity_id: criterion.id,
+      entity_code: criterion.code,
+      action: 'task.waived',
+      actor_type: actor.actorType,
+      actor_id: actor.actorId,
+      tool: actor.tool ?? null,
+      payload: {
+        before: { status: criterion.status },
+        after: {
+          status: 'waived',
+          waiver: `criterion:${criterion.code}`,
+          approval_id: approvalId,
+          reason: `requirement ${requirement.code} was dropped`,
+        },
+      },
+    });
+  }
+
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: null,
+    entity: 'requirement',
+    entity_id: requirement.id,
+    entity_code: requirement.code,
+    action: 'requirement.dropped',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: {
+      before: { status: requirement.status },
+      after: { status: 'dropped', reason: text, waived_criteria: waived },
+    },
+  });
+
+  return {
+    kind: 'requirement',
+    id: requirement.id,
+    code: requirement.code,
+    status: 'dropped',
+    approval_id: approvalId,
+    reason: text,
+    waived_criteria: waived,
+  };
+}
