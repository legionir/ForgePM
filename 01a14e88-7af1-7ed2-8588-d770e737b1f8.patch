diff --git a/packages/core/src/exec/decision-service.test.ts b/packages/core/src/exec/decision-service.test.ts
new file mode 100644
index 0000000..4e2e781
--- /dev/null
+++ b/packages/core/src/exec/decision-service.test.ts
@@ -0,0 +1,103 @@
+import { describe, expect, it } from 'vitest';
+import { parseDecision } from './decision-service';
+import { parseQuestion } from './question-service';
+
+/**
+ * The shape checks of PE-4's two human-in-the-loop tools (plan §9.2, §9.3 —
+ * acceptance B.9's I-4 and B.11).
+ *
+ * The parts that need a database (the row, the approval request, the task's
+ * move to `awaiting_review`) are proved by the integration cases in
+ * `tests/integration/exec-tools.test.ts`.
+ */
+
+const TASK = 'T-001';
+
+describe('a decision is a choice with its reasons (B.9)', () => {
+  const good = {
+    task_ref: TASK,
+    title: 'the shape of the public API',
+    context: 'the endpoint changes and every client has to follow',
+    options: ['keep the old shape and add a new one', 'replace the old shape'],
+    selected: 'keep the old shape and add a new one',
+    rationale: 'the old shape is used by two other services that cannot change in this release',
+    reversible: true,
+    touches: ['public_api'],
+  };
+
+  it('a good decision parses', () => {
+    const r = parseDecision(good);
+    expect(r.ok).toBe(true);
+  });
+
+  it('the agent may not send its own risk level (I-4)', () => {
+    const r = parseDecision({ ...good, risk_level: 'auto' });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.message).toMatch(/risk_level/);
+  });
+
+  it('the selected option must be one of the options', () => {
+    const r = parseDecision({ ...good, selected: 'something nobody offered' });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.message).toMatch(/selected/);
+  });
+
+  it('a rationale shorter than 40 characters is refused', () => {
+    const r = parseDecision({ ...good, rationale: 'because' });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.message).toMatch(/rationale/);
+  });
+
+  it("'none' cannot be combined with another category", () => {
+    const r = parseDecision({ ...good, touches: ['none', 'public_api'] });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.message).toMatch(/none/);
+  });
+});
+
+describe('a question is a question, not a note (B.11)', () => {
+  const good = {
+    task_ref: TASK,
+    question: 'should the panel show the gate stamp next to the task?',
+    options: ['yes, show it', 'no, keep the panel simple'],
+    recommendation: 'yes, show it',
+    impact_per_option: [
+      'one more column in the board, and the drift becomes visible at a glance',
+      'the board stays small, but a drifted task is only visible in the API',
+    ],
+    why_it_matters: 'a drifted task looks finished on the board while the ledger says it is not',
+    blocking: true,
+    kind: 'generic',
+  };
+
+  it('a good question parses', () => {
+    const r = parseQuestion(good);
+    expect(r.ok).toBe(true);
+  });
+
+  it('a recommendation that is not one of the options is refused', () => {
+    const r = parseQuestion({ ...good, recommendation: 'do whatever you like' });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.message).toMatch(/recommendation/);
+  });
+
+  it('the impact must have one entry per option', () => {
+    const r = parseQuestion({ ...good, impact_per_option: ['only one impact'] });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.message).toMatch(/impact_per_option/);
+  });
+
+  it('a question with no impact at all is refused', () => {
+    const { impact_per_option, ...without } = good;
+    void impact_per_option;
+    const r = parseQuestion(without);
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.message).toMatch(/impact_per_option/);
+  });
+
+  it('a question with fewer than two options is refused', () => {
+    const r = parseQuestion({ ...good, options: ['only one'] });
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.message).toMatch(/options/);
+  });
+});
diff --git a/packages/core/src/exec/decision-service.ts b/packages/core/src/exec/decision-service.ts
new file mode 100644
index 0000000..c3fd4a6
--- /dev/null
+++ b/packages/core/src/exec/decision-service.ts
@@ -0,0 +1,210 @@
+import { sql } from 'kysely';
+import { AppError, decisionInputSchema, type ExecRiskLevel } from '@forgepm/shared';
+import type { DbLike } from '../db/unitOfWork';
+import { newId } from '../id';
+import { toJsonb } from '../jsonb';
+import { appendEvent } from './events';
+import { allocateLedgerCode } from './codes';
+import { classify, type Classified } from './policy';
+import { findTaskByRef, type LedgerActor } from './open-items-service';
+
+/**
+ * `ledger_record_decision` (plan §9.2, acceptance B.9).
+ *
+ * A decision is a choice with its reasons attached — and the RISK is not the
+ * agent's to choose. The agent says what it touches and whether it can be
+ * undone; the policy table says how serious that is, and the answer is stored
+ * with the decision so nobody can re-label it later.
+ *
+ * Two rules that the plan states and this file keeps:
+ *   • a decision whose level is `approval` may NOT be applied before a human
+ *     says yes — the row is stored as `pending` and the answer says so in
+ *     words (`do_not_apply_until_human_approval`),
+ *   • a decision the policy DENIES is not recorded at all: there is no column
+ *     for it, and a decision that may not exist may not be written down.
+ *
+ * The caller owns the transaction.
+ */
+
+export interface DecisionRecordValue {
+  task_ref: string;
+  title: string;
+  context: string;
+  options: string[];
+  selected: string;
+  rationale: string;
+  reversible: boolean;
+  touches: string[];
+  review_trigger?: { fact_codes?: string[]; req_codes?: string[] };
+}
+
+export interface DecisionRecordResult {
+  id: string;
+  code: string;
+  task_code: string;
+  risk_level: ExecRiskLevel;
+  approval_state: 'not_required' | 'pending';
+  approval_id: string | null;
+  /** The one sentence an agent must not skip. */
+  do_not_apply_until_human_approval: boolean;
+  matched: Classified['matched'];
+  explanation: string;
+}
+
+export interface DecisionParseOk {
+  ok: true;
+  value: DecisionRecordValue;
+}
+export interface DecisionParseFail {
+  ok: false;
+  code: 'UNPROCESSABLE';
+  message: string;
+  needed_action: string;
+}
+export type DecisionParse = DecisionParseOk | DecisionParseFail;
+
+/**
+ * The shape check. `risk_level` is NOT accepted as input: the level is
+ * computed (plan §9.2, acceptance B.9's I-4) — an agent that may name its own
+ * risk may name it "auto".
+ */
+export function parseDecision(raw: unknown): DecisionParse {
+  const parsed = decisionInputSchema.safeParse(raw ?? {});
+  if (!parsed.success) {
+    const issue = parsed.error.issues[0];
+    const path = issue?.path?.length ? issue.path.join('.') : 'payload';
+    return {
+      ok: false,
+      code: 'UNPROCESSABLE',
+      message: `${path}: ${issue?.message ?? 'the decision did not parse'}`,
+      needed_action:
+        'send { task_ref, title, context, options, selected, rationale, reversible, touches } — the risk level is computed, never sent',
+    };
+  }
+  return { ok: true, value: parsed.data as DecisionRecordValue };
+}
+
+export async function recordDecision(
+  db: DbLike,
+  actor: LedgerActor,
+  raw: unknown,
+  policy: Parameters<typeof classify>[0],
+): Promise<DecisionRecordResult> {
+  const parsed = parseDecision(raw);
+  if (!parsed.ok) {
+    throw new AppError(parsed.code, parsed.message, { needed_action: parsed.needed_action });
+  }
+  const input = parsed.value;
+
+  const task = await findTaskByRef(db, actor, input.task_ref);
+  if (!task) throw new AppError('NOT_FOUND', `no task '${input.task_ref}' in this project`, { ref: input.task_ref });
+  if (task.status === 'done') {
+    throw new AppError('LEDGER_STATE_INVALID', `task ${task.code} is already closed`, {
+      needed_action: 'a closed task keeps the decision it was closed with; open a new task for new work',
+    });
+  }
+
+  const classified = classify(policy, { touches: input.touches, reversible: input.reversible });
+  if (classified.level === 'deny') {
+    throw new AppError('FORBIDDEN', `the policy denies this decision (${input.touches.join(', ')})`, {
+      needed_action:
+        'do not apply this change: pick another option, or ask the human with ledger_ask_human — a denied decision is not recorded',
+      matched: classified.matched,
+    });
+  }
+
+  const id = newId();
+  const code = await allocateLedgerCode(db, actor.projectId, 'D', actor.organizationId);
+  const needsApproval = classified.level === 'approval';
+  const approvalId = needsApproval ? await requestApproval(db, actor, id, code, input) : null;
+  const approvalState: 'not_required' | 'pending' = needsApproval ? 'pending' : 'not_required';
+
+  await sql`
+    INSERT INTO exec_decisions (id, organization_id, task_id, code, title, context, options, selected,
+                                rationale, touches, reversible, risk_level, approval_state, approval_id,
+                                status, review_trigger)
+    VALUES (${id}, ${actor.organizationId}, ${task.id}::uuid, ${code}, ${input.title}, ${input.context},
+            ${toJsonb(input.options) as never}::jsonb, ${input.selected}, ${input.rationale},
+            ${input.touches}::text[], ${input.reversible}, ${classified.level}, ${approvalState},
+            ${approvalId}::uuid, 'proposed', ${toJsonb(input.review_trigger ?? null) as never}::jsonb)
+  `.execute(db as never);
+
+  await linkReviewTrigger(db, actor, id, input.review_trigger);
+
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: task.id,
+    entity: 'decision',
+    entity_id: id,
+    entity_code: code,
+    action: 'decision.recorded',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: {
+      before: null,
+      after: {
+        code,
+        selected: input.selected,
+        risk_level: classified.level,
+        approval_state: approvalState,
+        touches: input.touches,
+      },
+    },
+  });
+
+  return {
+    id,
+    code,
+    task_code: task.code,
+    risk_level: classified.level,
+    approval_state: approvalState,
+    approval_id: approvalId,
+    do_not_apply_until_human_approval: needsApproval,
+    matched: classified.matched,
+    explanation: classified.explanation,
+  };
+}
+
+/**
+ * The approval request a decision waits for. It is an ordinary
+ * `approval_requests` row: the human path (REST/CLI/panel, PE-4 §9.5) decides
+ * it, and nothing else may.
+ */
+async function requestApproval(
+  db: DbLike,
+  actor: LedgerActor,
+  decisionId: string,
+  code: string,
+  input: DecisionRecordValue,
+): Promise<string> {
+  const id = newId();
+  await sql`
+    INSERT INTO approval_requests (id, organization_id, project_id, requested_by, action, payload, risk, status)
+    VALUES (${id}, ${actor.organizationId}, ${actor.projectId}::uuid, ${actor.actorId}, 'exec.decision',
+            ${toJsonb({ decision_id: decisionId, code, title: input.title, touches: input.touches, selected: input.selected }) as never}::jsonb,
+            'sensitive', 'pending')
+  `.execute(db as never);
+  return id;
+}
+
+/** A decision that depends on a fact links to it, so the fact can be re-checked. */
+async function linkReviewTrigger(
+  db: DbLike,
+  actor: LedgerActor,
+  decisionId: string,
+  trigger: DecisionRecordValue['review_trigger'],
+): Promise<void> {
+  const codes = trigger?.fact_codes ?? [];
+  if (!codes.length) return;
+  const rows = await sql<{ id: string; code: string }>`
+    SELECT id, code FROM exec_facts
+    WHERE organization_id = ${actor.organizationId} AND project_id = ${actor.projectId}::uuid AND code = ANY(${codes})
+  `.execute(db as never);
+  for (const fact of rows.rows) {
+    await sql`
+      INSERT INTO exec_fact_decisions (fact_id, decision_id) VALUES (${fact.id}::uuid, ${decisionId}::uuid)
+      ON CONFLICT DO NOTHING
+    `.execute(db as never);
+  }
+}
diff --git a/packages/core/src/exec/dependencies.ts b/packages/core/src/exec/dependencies.ts
new file mode 100644
index 0000000..7fb54f3
--- /dev/null
+++ b/packages/core/src/exec/dependencies.ts
@@ -0,0 +1,137 @@
+import { sql } from 'kysely';
+import { AppError } from '@forgepm/shared';
+import { findCycle } from '../graph';
+import type { DbLike } from '../db/unitOfWork';
+import { appendEvent } from './events';
+import { findTaskByRef, type LedgerActor } from './open-items-service';
+
+export interface DependencyRow {
+  id: string;
+  code: string;
+  status: string;
+}
+
+export async function pendingDependencies(db: DbLike, taskId: string): Promise<DependencyRow[]> {
+  const rows = await sql<DependencyRow>`
+    SELECT dependency.id::text AS id, dependency.code, dependency.status
+    FROM exec_task_deps d JOIN exec_tasks dependency ON dependency.id = d.depends_on_task_id
+    WHERE d.task_id = ${taskId}::uuid AND dependency.status <> 'done'
+    ORDER BY dependency.code
+  `.execute(db as never);
+  return rows.rows;
+}
+
+export async function linkTaskDependency(
+  db: DbLike,
+  actor: LedgerActor,
+  taskRef: string,
+  dependsOnRef: string,
+): Promise<{ task: string; depends_on: string; already_linked: boolean }> {
+  const task = await findTaskByRef(db, actor, taskRef);
+  const dependency = await findTaskByRef(db, actor, dependsOnRef);
+  if (!task) throw new AppError('NOT_FOUND', `no task '${taskRef}' in this project`);
+  if (!dependency) throw new AppError('NOT_FOUND', `no dependency task '${dependsOnRef}' in this project`);
+  if (task.id === dependency.id) {
+    throw new AppError('DEPENDENCY_CYCLE', `task ${task.code} cannot depend on itself`, { cycle: [task.code, task.code] });
+  }
+  await assertAcyclic(db, actor, task.id, dependency.id, task.code, dependency.code);
+  const inserted = await sql<{ task_id: string }>`
+    INSERT INTO exec_task_deps (task_id, depends_on_task_id)
+    VALUES (${task.id}::uuid, ${dependency.id}::uuid)
+    ON CONFLICT (task_id, depends_on_task_id) DO NOTHING
+    RETURNING task_id::text AS task_id
+  `.execute(db as never);
+  const alreadyLinked = inserted.rows.length === 0;
+  if (!alreadyLinked) {
+    await appendEvent(db, {
+      organization_id: actor.organizationId,
+      task_id: task.id,
+      entity: 'dependency',
+      entity_id: dependency.id,
+      entity_code: dependency.code,
+      action: 'task.dependency_linked',
+      actor_type: actor.actorType,
+      actor_id: actor.actorId,
+      tool: actor.tool ?? null,
+      payload: { task: task.code, depends_on: dependency.code },
+    });
+  }
+  if (task.status === 'in_progress' && dependency.status !== 'done') {
+    await blockOnDependency(db, actor, task.id, task.code, dependency.id, dependency.code);
+  }
+  return { task: task.code, depends_on: dependency.code, already_linked: alreadyLinked };
+}
+
+export async function assertAcyclic(
+  db: DbLike,
+  actor: Pick<LedgerActor, 'organizationId' | 'projectId'>,
+  taskId: string,
+  dependencyId: string,
+  taskCode: string,
+  dependencyCode: string,
+): Promise<void> {
+  const rows = await sql<{
+    task_id: string;
+    task_code: string;
+    depends_on_task_id: string;
+    dependency_code: string;
+  }>`
+    SELECT d.task_id::text AS task_id, task.code AS task_code,
+      d.depends_on_task_id::text AS depends_on_task_id, dependency.code AS dependency_code
+    FROM exec_task_deps d JOIN exec_tasks task ON task.id = d.task_id
+      JOIN exec_tasks dependency ON dependency.id = d.depends_on_task_id
+    WHERE task.organization_id = ${actor.organizationId}::uuid AND task.project_id = ${actor.projectId}::uuid
+  `.execute(db as never);
+  const edges: [string, string][] = rows.rows.map((row) => [row.task_id, row.depends_on_task_id]);
+  const labels = new Map<string, string>([[taskId, taskCode], [dependencyId, dependencyCode]]);
+  for (const row of rows.rows) {
+    labels.set(row.task_id, row.task_code);
+    labels.set(row.depends_on_task_id, row.dependency_code);
+  }
+  edges.push([taskId, dependencyId]);
+  const cycle = findCycle(edges, taskId);
+  if (cycle) {
+    throw new AppError('DEPENDENCY_CYCLE', `dependency cycle: ${cycle.map((id) => labels.get(id) ?? id).join(' -> ')}`, {
+      cycle,
+      needed_action: 'remove a dependency edge so tasks do not depend on each other in a loop',
+    });
+  }
+}
+
+async function blockOnDependency(
+  db: DbLike,
+  actor: LedgerActor,
+  taskId: string,
+  taskCode: string,
+  dependencyId: string,
+  dependencyCode: string,
+): Promise<void> {
+  const condition = `task ${dependencyCode} must be done before ${taskCode} can continue`;
+  await sql`
+    UPDATE exec_tasks SET status = 'blocked', blocked_on_kind = 'task', blocked_on_ref = ${dependencyId}::uuid,
+      blocked_reason = ${condition}, unblock_condition = ${condition}, updated_at = now()
+    WHERE id = ${taskId}::uuid AND status = 'in_progress'
+  `.execute(db as never);
+  await sql`
+    WITH target_state AS (
+      SELECT s.id FROM workflow_states s JOIN exec_tasks t ON t.project_id = s.project_id
+      WHERE t.id = ${taskId}::uuid AND s.category IN ('unstarted','backlog')
+      ORDER BY CASE WHEN s.category = 'unstarted' THEN 0 ELSE 1 END LIMIT 1
+    )
+    UPDATE work_items w SET state_id = (SELECT id FROM target_state), updated_at = now()
+    FROM exec_tasks t WHERE t.id = ${taskId}::uuid AND w.id = t.work_item_id
+      AND EXISTS (SELECT 1 FROM target_state)
+  `.execute(db as never);
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: taskId,
+    entity: 'task',
+    entity_id: taskId,
+    entity_code: taskCode,
+    action: 'task.blocked',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: { blocked_on_kind: 'task', blocked_on_ref: dependencyId, blocked_on_code: dependencyCode, unblock_condition: condition },
+  });
+}
