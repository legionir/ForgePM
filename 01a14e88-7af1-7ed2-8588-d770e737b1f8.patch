+
+/**
+ * `ledger_ask_human` (plan §9.3, acceptance B.11).
+ *
+ * A question is the one way the agent can stop and wait. Three things make it
+ * a real question rather than a note:
+ *
+ *   • the options are written down, with the impact of EACH one (a question
+ *     whose options have no consequences is a question nobody can answer),
+ *   • a blocking question moves the task to `awaiting_review` and says what
+ *     would unblock it — the ledger's own CHECK demands exactly that,
+ *   • and there is NO timeout. Silence is not approval: an unanswered
+ *     question keeps the gate refusing, tomorrow and next week.
+ *
+ * The caller owns the transaction.
+ */
+
+export interface QuestionAskValue {
+  task_ref: string;
+  question: string;
+  options: string[];
+  recommendation: string;
+  impact_per_option?: string[];
+  why_it_matters: string;
+  blocking: boolean;
+  kind: 'generic' | 'scope_expansion' | 'drop_requirement' | 'waive_requirement' | 'baseline_change';
+}
+
+export interface QuestionAskResult {
+  id: string;
+  code: string;
+  task_code: string;
+  status: 'open';
+  blocking: boolean;
+  kind: string;
+  approval_id: string | null;
+  /** The task now waits; this is what would unblock it. */
+  task_status: string;
+  needed_action: string;
+}
+
+export interface QuestionParseOk {
+  ok: true;
+  value: QuestionAskValue;
+}
+export interface QuestionParseFail {
+  ok: false;
+  code: 'UNPROCESSABLE';
+  message: string;
+  needed_action: string;
+}
+export type QuestionParse = QuestionParseOk | QuestionParseFail;
+
+export function parseQuestion(raw: unknown): QuestionParse {
+  const parsed = questionInputSchema.safeParse(raw ?? {});
+  if (!parsed.success) {
+    const issue = parsed.error.issues[0];
+    const path = issue?.path?.length ? issue.path.join('.') : 'payload';
+    return {
+      ok: false,
+      code: 'UNPROCESSABLE',
+      message: `${path}: ${issue?.message ?? 'the question did not parse'}`,
+      needed_action:
+        'send { task_ref, question, options, recommendation, why_it_matters, impact_per_option } — one impact per option, and the recommendation must be one of the options',
+    };
+  }
+  return { ok: true, value: parsed.data as QuestionAskValue };
+}
+
+export async function askHuman(db: DbLike, actor: LedgerActor, raw: unknown): Promise<QuestionAskResult> {
+  const parsed = parseQuestion(raw);
+  if (!parsed.ok) {
+    throw new AppError(parsed.code, parsed.message, { needed_action: parsed.needed_action });
+  }
+  const input = parsed.value;
+
+  const task = await findTaskByRef(db, actor, input.task_ref);
+  if (!task) throw new AppError('NOT_FOUND', `no task '${input.task_ref}' in this project`, { ref: input.task_ref });
+  if (task.status === 'done') {
+    throw new AppError('LEDGER_STATE_INVALID', `task ${task.code} is already closed`, {
+      needed_action: 'a closed task keeps the question it was closed with; open a new task for new work',
+    });
+  }
+
+  const id = newId();
+  const code = await allocateLedgerCode(db, actor.projectId, 'Q', actor.organizationId);
+  const impact = input.impact_per_option ?? [];
+  const approvalId = input.blocking ? await requestApproval(db, actor, id, code, input) : null;
+
+  await sql`
+    INSERT INTO exec_questions (id, organization_id, task_id, code, question, options, recommendation,
+                                why_it_matters, impact, blocking, status, approval_id)
+    VALUES (${id}, ${actor.organizationId}, ${task.id}::uuid, ${code}, ${input.question},
+            ${toJsonb(input.options) as never}::jsonb, ${input.recommendation}, ${input.why_it_matters},
+            ${toJsonb(impact) as never}::jsonb, ${input.blocking}, 'open', ${approvalId}::uuid)
+  `.execute(db as never);
+
+  let taskStatus = task.status;
+  if (input.blocking) {
+    // The ledger's own CHECK: a task in `awaiting_review` must say what would
+    // unblock it. The question is the answer to "what would unblock it".
+    const unblock = `a human answers question ${code} (one of: ${input.options.join(' | ')})`;
+    await sql`
+      UPDATE exec_tasks
+      SET status = 'awaiting_review', updated_at = now(),
+          blocked_on_kind = 'question', blocked_on_ref = ${id}::uuid,
+          unblock_condition = ${unblock}
+      WHERE id = ${task.id}::uuid
+    `.execute(db as never);
+    taskStatus = 'awaiting_review';
+  }
+
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: task.id,
+    entity: 'question',
+    entity_id: id,
+    entity_code: code,
+    action: 'question.asked',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: {
+      before: null,
+      after: {
+        code,
+        blocking: input.blocking,
+        kind: input.kind,
+        options: input.options.length,
+        task_status: taskStatus,
+      },
+    },
+  });
+
+  return {
+    id,
+    code,
+    task_code: task.code,
+    status: 'open',
+    blocking: input.blocking,
+    kind: input.kind,
+    approval_id: approvalId,
+    task_status: taskStatus,
+    needed_action: input.blocking
+      ? 'wait for a human answer — silence is not approval, and the gate keeps refusing until the question is answered'
+      : 'continue; the question is on the record and the human may answer it later',
+  };
+}
+
+/** A blocking question is decided by a human, through the ordinary approval queue. */
+async function requestApproval(
+  db: DbLike,
+  actor: LedgerActor,
+  questionId: string,
+  code: string,
+  input: QuestionAskValue,
+): Promise<string> {
+  const id = newId();
+  await sql`
+    INSERT INTO approval_requests (id, organization_id, project_id, requested_by, action, payload, risk, status)
+    VALUES (${id}, ${actor.organizationId}, ${actor.projectId}::uuid, ${actor.actorId}, 'exec.question',
+            ${toJsonb({ question_id: questionId, code, question: input.question, options: input.options }) as never}::jsonb,
+            'sensitive', 'pending')
+  `.execute(db as never);
+  return id;
+}
+
+/**
+ * `POST /api/v1/exec/questions/:code/answer` (plan §9.5) — the human's answer.
+ *
+ * Answering a question is what unblocks the task: the question becomes
+ * `answered`, the task leaves `awaiting_review` (and stops claiming to be
+ * blocked by a question that no longer exists), and the request that asked for
+ * an answer is closed by the very person who gave it.
+ */
+export interface QuestionAnswerResult {
+  id: string;
+  code: string;
+  task_code: string;
+  status: 'answered';
+  answer: string;
+  answered_by: string;
+  task_status: string;
+}
+
+export async function answerQuestion(
+  db: DbLike,
+  actor: LedgerActor,
+  code: string,
+  answer: string,
+): Promise<QuestionAnswerResult> {
+  const text = (answer ?? '').trim();
+  if (text.length < 1) {
+    throw new AppError('VALIDATION_ERROR', 'the answer is empty', {
+      needed_action: 'write the answer the human gave — a blank answer is not an answer',
+    });
+  }
+  const rows = await sql<{
+    id: string;
+    code: string;
+    task_id: string;
+    status: string;
+    task_code: string;
+    task_status: string;
+  }>`
+    SELECT q.id::text AS id, q.code, q.task_id::text AS task_id, q.status, t.code AS task_code, t.status AS task_status
+    FROM exec_questions q JOIN exec_tasks t ON t.id = q.task_id
+    WHERE q.organization_id = ${actor.organizationId}::uuid
+      AND (q.code = ${code} OR q.id::text = ${code})
+  `.execute(db as never);
+  const question = rows.rows[0];
+  if (!question) {
+    throw new AppError('NOT_FOUND', `no question '${code}' in this organisation`, { ref: code });
+  }
+  if (question.status !== 'open') {
+    throw new AppError('LEDGER_STATE_INVALID', `question ${question.code} is already ${question.status}`, {
+      needed_action: 'a question that was answered or canceled keeps its answer; ask a new one',
+    });
+  }
+
+  await sql`
+    UPDATE exec_questions
+    SET status = 'answered', answer = ${text}, answered_by = ${actor.actorId}, answered_at = now()
+    WHERE id = ${question.id}::uuid
+  `.execute(db as never);
+
+  // An answer clears only the matching question blocker; unfinished dependencies still block.
+  const taskStatus = (await resumeBlockedTask(db, question.task_id, 'question', question.id, 'question_answered'))
+    ?? question.task_status;
+
+  // The approval that asked for an answer is closed by the person who answered.
+  await sql`
+    UPDATE approval_requests
+    SET status = 'approved', decided_by = ${actor.actorId}, decided_at = now(), reason = ${text.slice(0, 1000)}
+    WHERE action = 'exec.question' AND status = 'pending'
+      AND payload->>'question_id' = ${question.id}
+  `.execute(db as never);
+
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: question.task_id,
+    entity: 'question',
+    entity_id: question.id,
+    entity_code: question.code,
+    action: 'question.answered',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: {
+      before: { status: 'open' },
+      after: { status: 'answered', answer: text.slice(0, 500), task_status: taskStatus },
+    },
+  });
+
+  return {
+    id: question.id,
+    code: question.code,
+    task_code: question.task_code,
+    status: 'answered',
+    answer: text,
+    answered_by: actor.actorId,
+    task_status: taskStatus,
+  };
+}
diff --git a/packages/core/src/exec/reconcile.ts b/packages/core/src/exec/reconcile.ts
new file mode 100644
index 0000000..19332bc
--- /dev/null
+++ b/packages/core/src/exec/reconcile.ts
@@ -0,0 +1,276 @@
+import { sql } from 'kysely';
+import { resolveExecReviewSource } from './review-source';
+import { diffScopeManifest, makeScopeManifest, restrictScopeManifest, type ChangedFile, type ScopeFileManifest } from './scope';
+import type { DbLike } from '../db/unitOfWork';
+import type { LedgerActor } from './open-items-service';
+
+const MAX_TASKS = 500;
+const MAX_REPORTED_PATHS = 250;
+const MAX_SUMMARY_ROWS = 200;
+
+export interface ReconcileResult {
+  project_id: string;
+  reconciled_at: string;
+  completed_task_drift: {
+    task_id: string;
+    task_code: string;
+    closed_at: string | null;
+    changed_count: number;
+    changed_files: ChangedFile[];
+    truncated: boolean;
+  }[];
+  unmeasurable_closed_tasks: { task_id: string; task_code: string; reason: string }[];
+  missing_gate_stamp: { task_id: string; task_code: string; reason: string }[];
+  stale_facts: { code: string; key: string; source: string; files: string[] }[];
+  unsettled_journal: { code: string; task_code: string; action: string; status: string; idempotent: boolean }[];
+  changed_file_diffs: {
+    task_id: string;
+    task_code: string;
+    measured_count: number;
+    reported_count: number;
+    measured_not_reported: string[];
+    reported_not_measured: string[];
+    matches: boolean;
+    truncated: boolean;
+    measurement_error?: string;
+  }[];
+  counts: Record<string, number>;
+  truncated: boolean;
+}
+
+interface TaskReconcileRow {
+  id: string;
+  code: string;
+  status: string;
+  start_ref: string | null;
+  closed_at: Date | null;
+  gate_id: string | null;
+  gate_ok: boolean | null;
+  gate_file_manifest: unknown;
+  report_payload: unknown;
+}
+
+/**
+ * Read-side reconciliation for appendix K.4. Close-time file hashes are stored
+ * on the append-only gate stamp; current Git input is measured by the server's
+ * read-only adapter. Report.changed_files is compared for drift only and is
+ * never a source for scope or a gate decision.
+ */
+export async function reconcileLedger(db: DbLike, actor: Pick<LedgerActor, 'organizationId' | 'projectId'>): Promise<ReconcileResult> {
+  const [tasksResult, factsResult, journalResult] = await Promise.all([
+    sql<TaskReconcileRow>`
+      SELECT t.id::text AS id, t.code, t.status, t.start_ref, t.closed_at,
+        g.id::text AS gate_id, g.ok AS gate_ok, g.file_manifest AS gate_file_manifest,
+        r.payload AS report_payload
+      FROM exec_tasks t
+      LEFT JOIN exec_gate_checks g ON g.id = t.gate_stamp_id
+      LEFT JOIN LATERAL (
+        SELECT payload FROM exec_reports WHERE task_id = t.id
+        ORDER BY created_at DESC, id DESC LIMIT 1
+      ) r ON true
+      WHERE t.organization_id = ${actor.organizationId}::uuid
+        AND t.project_id = ${actor.projectId}::uuid
+      ORDER BY t.updated_at DESC, t.code
+      LIMIT ${MAX_TASKS + 1}
+    `.execute(db as never),
+    sql<{ code: string; key: string; source: string; files: unknown }>`
+      SELECT code, key, source, files FROM exec_facts
+      WHERE organization_id = ${actor.organizationId}::uuid
+        AND project_id = ${actor.projectId}::uuid AND status = 'stale'
+      ORDER BY code LIMIT ${MAX_SUMMARY_ROWS + 1}
+    `.execute(db as never),
+    sql<{ code: string; task_code: string; action: string; status: string; idempotent: boolean }>`
+      SELECT j.code, t.code AS task_code, j.action, j.status, j.idempotent
+      FROM exec_action_journal j JOIN exec_tasks t ON t.id = j.task_id
+      WHERE t.organization_id = ${actor.organizationId}::uuid
+        AND t.project_id = ${actor.projectId}::uuid AND j.status IN ('started','unknown')
+      ORDER BY CASE WHEN j.status = 'unknown' THEN 0 ELSE 1 END, j.started_at, j.code
+      LIMIT ${MAX_SUMMARY_ROWS + 1}
+    `.execute(db as never),
+  ]);
+
+  const tasks = tasksResult.rows.slice(0, MAX_TASKS);
+  const source = resolveExecReviewSource();
+  const manifestCache = new Map<string, Promise<ScopeFileManifest>>();
+  const completedTaskDrift: ReconcileResult['completed_task_drift'] = [];
+  const unmeasurableClosedTasks: ReconcileResult['unmeasurable_closed_tasks'] = [];
+  const missingGateStamp: ReconcileResult['missing_gate_stamp'] = [];
+  const changedFileDiffs: ReconcileResult['changed_file_diffs'] = [];
+  let truncated = tasksResult.rows.length > MAX_TASKS || factsResult.rows.length > MAX_SUMMARY_ROWS || journalResult.rows.length > MAX_SUMMARY_ROWS;
+
+  for (const task of tasks) {
+    if (task.status === 'done') {
+      if (!task.gate_id || task.gate_ok !== true) {
+        missingGateStamp.push({
+          task_id: task.id,
+          task_code: task.code,
+          reason: task.gate_id ? 'the task points at a non-passing gate stamp' : 'the task has no gate stamp',
+        });
+      } else {
+        const saved = parseCloseManifest(task.gate_file_manifest);
+        if (!saved) {
+          unmeasurableClosedTasks.push({
+            task_id: task.id,
+            task_code: task.code,
+            reason: 'the passing gate stamp has no valid hash-only close snapshot',
+          });
+        } else if (!source?.fileSnapshot) {
+          unmeasurableClosedTasks.push({
+            task_id: task.id,
+            task_code: task.code,
+            reason: 'no read-only per-file hash source is configured',
+          });
+        } else {
+          const rootsKey = JSON.stringify([saved.roots, saved.allowed_paths]);
+          let currentPromise = manifestCache.get(rootsKey);
+          if (!currentPromise) {
+            currentPromise = source.fileSnapshot({ roots: saved.roots }).then((manifest) => restrictScopeManifest(manifest, saved.allowed_paths));
+            manifestCache.set(rootsKey, currentPromise);
+          }
+          try {
+            const current = await currentPromise;
+            const changes = diffScopeManifest(saved.manifest, current);
+            if (changes.length) {
+              completedTaskDrift.push({
+                task_id: task.id,
+                task_code: task.code,
+                closed_at: task.closed_at?.toISOString() ?? null,
+                changed_count: changes.length,
+                changed_files: changes.slice(0, MAX_REPORTED_PATHS),
+                truncated: changes.length > MAX_REPORTED_PATHS,
+              });
+            }
+          } catch {
+            unmeasurableClosedTasks.push({
+              task_id: task.id,
+              task_code: task.code,
+              reason: 'the current read-only file snapshot could not be measured safely',
+            });
+          }
+        }
+      }
+    }
+
+    const payload = asObject(task.report_payload);
+    const reported = stringArray(payload?.changed_files);
+    if (!task.start_ref || !Array.isArray(payload?.changed_files)) continue;
+    if (!source?.changedFiles) {
+      changedFileDiffs.push({
+        task_id: task.id,
+        task_code: task.code,
+        measured_count: 0,
+        reported_count: reported.length,
+        measured_not_reported: [],
+        reported_not_measured: reported.slice(0, MAX_REPORTED_PATHS),
+        matches: false,
+        truncated: reported.length > MAX_REPORTED_PATHS,
+        measurement_error: 'no read-only Git diff source is configured',
+      });
+      continue;
+    }
+    try {
+      const measured = await source.changedFiles({ start_ref: task.start_ref });
+      const measuredPaths = [...new Set(measured.map((file) => file.path))].sort();
+      const reportedPaths = [...new Set(reported)].sort();
+      const measuredSet = new Set(measuredPaths);
+      const reportedSet = new Set(reportedPaths);
+      const measuredNotReported = measuredPaths.filter((path) => !reportedSet.has(path));
+      const reportedNotMeasured = reportedPaths.filter((path) => !measuredSet.has(path));
+      if (measuredNotReported.length || reportedNotMeasured.length) {
+        changedFileDiffs.push({
+          task_id: task.id,
+          task_code: task.code,
+          measured_count: measuredPaths.length,
+          reported_count: reportedPaths.length,
+          measured_not_reported: measuredNotReported.slice(0, MAX_REPORTED_PATHS),
+          reported_not_measured: reportedNotMeasured.slice(0, MAX_REPORTED_PATHS),
+          matches: false,
+          truncated: measuredNotReported.length > MAX_REPORTED_PATHS || reportedNotMeasured.length > MAX_REPORTED_PATHS,
+        });
+      }
+    } catch {
+      changedFileDiffs.push({
+        task_id: task.id,
+        task_code: task.code,
+        measured_count: 0,
+        reported_count: reported.length,
+        measured_not_reported: [],
+        reported_not_measured: reported.slice(0, MAX_REPORTED_PATHS),
+        matches: false,
+        truncated: reported.length > MAX_REPORTED_PATHS,
+        measurement_error: 'the read-only Git diff could not be measured safely',
+      });
+    }
+  }
+
+  const staleFacts = factsResult.rows.slice(0, MAX_SUMMARY_ROWS).map((fact) => ({
+    code: fact.code,
+    key: fact.key,
+    source: fact.source,
+    files: stringArray(fact.files),
+  }));
+  const unsettledJournal = journalResult.rows.slice(0, MAX_SUMMARY_ROWS);
+  const result: ReconcileResult = {
+    project_id: actor.projectId,
+    reconciled_at: new Date().toISOString(),
+    completed_task_drift: completedTaskDrift,
+    unmeasurable_closed_tasks: unmeasurableClosedTasks,
+    missing_gate_stamp: missingGateStamp,
+    stale_facts: staleFacts,
+    unsettled_journal: unsettledJournal,
+    changed_file_diffs: changedFileDiffs,
+    counts: {
+      tasks_examined: tasks.length,
+      completed_task_drift: completedTaskDrift.length,
+      unmeasurable_closed_tasks: unmeasurableClosedTasks.length,
+      missing_gate_stamp: missingGateStamp.length,
+      stale_facts: factsResult.rows.length,
+      unsettled_journal: journalResult.rows.length,
+      changed_file_diffs: changedFileDiffs.length,
+    },
+    truncated,
+  };
+  return result;
+}
+
+function parseCloseManifest(raw: unknown): { roots: string[]; allowed_paths: string[]; manifest: ScopeFileManifest } | null {
+  const value = asObject(raw);
+  const roots = stringArray(value?.roots);
+  const allowedPaths = stringArray(value?.allowed_paths);
+  if (!value || !roots.length || !allowedPaths.length || !Array.isArray(value.files)) return null;
+  try {
+    const manifest = makeScopeManifest(
+      value.files.map((entry) => {
+        const file = asObject(entry);
+        if (!file || typeof file.path !== 'string' || typeof file.sha256 !== 'string') throw new Error('invalid file hash');
+        return { path: file.path, sha256: file.sha256 };
+      }),
+    );
+    if (typeof value.hash === 'string' && value.hash !== manifest.hash) return null;
+    return { roots, allowed_paths: allowedPaths, manifest };
+  } catch {
+    return null;
+  }
+}
+
+function asObject(value: unknown): Record<string, unknown> | null {
+  if (value && typeof value === 'object' && !Array.isArray(value)) return value as Record<string, unknown>;
+  if (typeof value !== 'string') return null;
+  try {
+    const parsed: unknown = JSON.parse(value);
+    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? (parsed as Record<string, unknown>) : null;
+  } catch {
+    return null;
+  }
+}
+
+function stringArray(value: unknown): string[] {
+  if (Array.isArray(value)) return value.filter((item): item is string => typeof item === 'string');
+  if (typeof value !== 'string') return [];
+  try {
+    const parsed: unknown = JSON.parse(value);
+    return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === 'string') : [];
+  } catch {
+    return [];
+  }
+}
diff --git a/packages/core/src/exec/requirement-conflicts.ts b/packages/core/src/exec/requirement-conflicts.ts
new file mode 100644
index 0000000..21262aa
--- /dev/null
+++ b/packages/core/src/exec/requirement-conflicts.ts
@@ -0,0 +1,175 @@
+import { sql } from 'kysely';
+import { askHuman } from './question-service';
+import { createOpenItem, type LedgerActor } from './open-items-service';
+import { appendEvent } from './events';
+import type { DbLike } from '../db/unitOfWork';
+
+interface ConflictPair {
+  left_id: string;
+  left_code: string;
+  left_kind: string;
+  left_priority: string;
+  right_id: string;
+  right_code: string;
+  right_kind: string;
+  right_priority: string;
+}
+
+interface TaskRow {
+  id: string;
+  code: string;
+  status: string;
+  work_item_id: string;
+}
+
+/** Explicit contradictions are stored in append-only requirement events, not inferred from agent prose. */
+export async function materializeRequirementConflicts(
+  db: DbLike,
+  actor: LedgerActor,
+): Promise<{ conflict: string; task: string; item: string; question: string }[]> {
+  const pairs = await loadConflictPairs(db, actor);
+  const created: { conflict: string; task: string; item: string; question: string }[] = [];
+  for (const pair of pairs) {
+    if (pair.left_kind !== pair.right_kind || pair.left_priority !== pair.right_priority) continue;
+    const conflictRef = [pair.left_code, pair.right_code].sort().join(':');
+    const tasks = await tasksForPair(db, actor, pair);
+    for (const task of tasks) {
+      if (await wasReported(db, task.id, conflictRef)) continue;
+      if (task.status === 'done') await reopenTask(db, actor, task);
+      const item = await createOpenItem(db, actor, task.code, {
+        title: `requirements ${pair.left_code} and ${pair.right_code} conflict`,
+        detail: `A human must resolve the explicit contradiction before completion. ${pair.left_code} conflicts with ${pair.right_code}.`,
+        type: 'design_gap',
+        blocks_completion: true,
+        related_ref: `requirement-conflict:${conflictRef}`,
+      });
+      const blocking = task.status !== 'blocked' && task.status !== 'awaiting_review';
+      const question = await askHuman(db, { ...actor, tool: 'req_link_task' }, {
+        task_ref: task.code,
+        question: `Which requirement should govern this conflict: ${pair.left_code} or ${pair.right_code}?`,
+        options: [`Keep ${pair.left_code}`, `Keep ${pair.right_code}`, 'Revise both requirements'],
+        recommendation: 'Revise both requirements',
+        impact_per_option: [
+          `The implementation follows ${pair.left_code}; ${pair.right_code} must be changed or dropped by a human.`,
+          `The implementation follows ${pair.right_code}; ${pair.left_code} must be changed or dropped by a human.`,
+          'Neither requirement is treated as settled until a human records revised wording for both.',
+        ],
+        why_it_matters: `These requirements conflict, so implementing either without a human decision could violate the other requirement.`,
+        blocking,
+        kind: 'generic',
+      });
+      await appendEvent(db, {
+        organization_id: actor.organizationId,
+        task_id: task.id,
+        entity: 'requirement',
+        entity_id: pair.left_id,
+        entity_code: pair.left_code,
+        action: 'requirement.conflict_reported',
+        actor_type: actor.actorType,
+        actor_id: actor.actorId,
+        tool: actor.tool ?? 'req_link_task',
+        payload: {
+          conflict_ref: conflictRef,
+          requirements: [pair.left_code, pair.right_code],
+          item_code: item.code,
+          question_code: question.code,
+        },
+      });
+      created.push({ conflict: conflictRef, task: task.code, item: item.code, question: question.code });
+    }
+  }
+  return created;
+}
+
+async function loadConflictPairs(db: DbLike, actor: LedgerActor): Promise<ConflictPair[]> {
+  const rows = await sql<{
+    id: string;
+    code: string;
+    contradictions: unknown;
+  }>`
+    SELECT e.entity_id::text AS id, e.entity_code AS code, e.payload->'after'->'contradicts' AS contradictions
+    FROM exec_events e JOIN exec_requirements r ON r.id = e.entity_id
+    WHERE e.organization_id = ${actor.organizationId}::uuid
+      AND (r.project_id = ${actor.projectId}::uuid OR r.project_id IS NULL) AND r.status <> 'dropped'
+      AND e.action IN ('requirement.added','requirement.changed')
+      AND e.entity = 'requirement'
+    ORDER BY e.created_at, e.id
+  `.execute(db as never);
+  const latest = new Map<string, { id: string; code: string; contradictions: string[] }>();
+  for (const event of rows.rows) {
+    latest.set(event.code, { id: event.id, code: event.code, contradictions: stringArray(event.contradictions) });
+  }
+  const refs = new Map<string, { id: string; code: string }>();
+  for (const source of latest.values()) {
+    for (const ref of source.contradictions) {
+      const [left, right] = [source.code, ref].sort();
+      if (left !== right) refs.set(`${left}:${right}`, { id: source.id, code: source.code });
+    }
+  }
+  const pairs: ConflictPair[] = [];
+  for (const [key, source] of refs) {
+    const [leftCode, rightCode] = key.split(':');
+    const found = await sql<ConflictPair>`
+      SELECT l.id::text AS left_id, l.code AS left_code, l.kind AS left_kind, l.priority AS left_priority,
+             r.id::text AS right_id, r.code AS right_code, r.kind AS right_kind, r.priority AS right_priority
+      FROM exec_requirements l, exec_requirements r
+      WHERE l.organization_id = ${actor.organizationId}::uuid AND r.organization_id = l.organization_id
+        AND l.code = ${leftCode} AND r.code = ${rightCode}
+        AND (l.project_id = ${actor.projectId}::uuid OR l.project_id IS NULL)
+        AND (r.project_id = ${actor.projectId}::uuid OR r.project_id IS NULL)
+    `.execute(db as never);
+    const pair = found.rows[0];
+    if (pair && pair.left_id !== pair.right_id && source.id) pairs.push(pair);
+  }
+  return pairs;
+}
+
+async function tasksForPair(db: DbLike, actor: LedgerActor, pair: ConflictPair): Promise<TaskRow[]> {
+  const rows = await sql<TaskRow>`
+    SELECT DISTINCT t.id::text AS id, t.code, t.status, t.work_item_id::text AS work_item_id
+    FROM exec_tasks t
+    WHERE t.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${actor.projectId}::uuid
+      AND (
+        EXISTS (
+          SELECT 1 FROM exec_criteria c
+          WHERE c.task_id = t.id AND c.req_id IN (${pair.left_id}::uuid, ${pair.right_id}::uuid)
+        )
+        OR EXISTS (
+          SELECT 1 FROM exec_events e
+          WHERE e.task_id = t.id AND e.action = 'task.created'
+            AND (COALESCE(e.payload #> '{after,req_ids}', '[]'::jsonb) ? ${pair.left_id}
+              OR COALESCE(e.payload #> '{after,req_ids}', '[]'::jsonb) ? ${pair.left_code}
+              OR COALESCE(e.payload #> '{after,req_ids}', '[]'::jsonb) ? ${pair.right_id}
+              OR COALESCE(e.payload #> '{after,req_ids}', '[]'::jsonb) ? ${pair.right_code})
+        )
+      )
+    ORDER BY t.code
+  `.execute(db as never);
+  return rows.rows;
+}
+
+async function wasReported(db: DbLike, taskId: string, conflictRef: string): Promise<boolean> {
+  const row = await sql<{ id: string }>`
+    SELECT id::text AS id FROM exec_events
+    WHERE task_id = ${taskId}::uuid AND action = 'requirement.conflict_reported'
+      AND payload->>'conflict_ref' = ${conflictRef}
+    LIMIT 1
+  `.execute(db as never);
+  return Boolean(row.rows[0]);
+}
+
+async function reopenTask(db: DbLike, actor: LedgerActor, task: TaskRow): Promise<void> {
+  await sql`
+    UPDATE exec_tasks SET status = 'in_progress', closed_at = NULL, gate_stamp_id = NULL, updated_at = now()
+    WHERE id = ${task.id}::uuid AND status = 'done'
+  `.execute(db as never);
+  await sql`
+    UPDATE work_items w SET state_id = s.id, updated_at = now()
+    FROM workflow_states s
+    WHERE w.id = ${task.work_item_id}::uuid AND s.project_id = ${actor.projectId}::uuid AND s.category = 'started'
+  `.execute(db as never);
+}
+
+function stringArray(value: unknown): string[] {
+  return Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string') : [];
+}
diff --git a/packages/core/src/exec/requirement-coverage.ts b/packages/core/src/exec/requirement-coverage.ts
new file mode 100644
index 0000000..180f4de
--- /dev/null
+++ b/packages/core/src/exec/requirement-coverage.ts
@@ -0,0 +1,101 @@
+import { sql } from 'kysely';
+import type { DbLike } from '../db/unitOfWork';
+import type { LedgerActor } from './open-items-service';
+import type { RequirementCoverageRow } from './requirement-types';
+
+export async function requirementCoverage(
+  db: DbLike,
+  actor: Pick<LedgerActor, 'organizationId' | 'projectId'>,
+): Promise<{ requirements: RequirementCoverageRow[]; unassigned: string[]; total: number }> {
+  const [requirements, declarations, criteria] = await Promise.all([
+    sql<{ id: string; code: string; text: string; status: string }>`
+      SELECT id::text AS id, code, text, status FROM exec_requirements
+      WHERE organization_id = ${actor.organizationId}::uuid
+        AND (project_id = ${actor.projectId}::uuid OR project_id IS NULL)
+      ORDER BY code
+    `.execute(db as never),
+    sql<{ task_id: string; task_code: string; req_ids: unknown }>`
+      SELECT t.id::text AS task_id, t.code AS task_code, e.payload #> '{after,req_ids}' AS req_ids
+      FROM exec_tasks t JOIN exec_events e ON e.task_id = t.id
+      WHERE t.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${actor.projectId}::uuid
+        AND e.action = 'task.created'
+      ORDER BY t.code
+    `.execute(db as never),
+    sql<{ req_id: string; task_code: string; criterion: string; status: string; evidence_count: number }>`
+      SELECT c.req_id::text AS req_id, t.code AS task_code, c.code AS criterion, c.status,
+             count(e.id)::int AS evidence_count
+      FROM exec_criteria c JOIN exec_tasks t ON t.id = c.task_id
+      LEFT JOIN exec_evidence e ON e.criterion_id = c.id
+      WHERE t.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${actor.projectId}::uuid
+        AND c.req_id IS NOT NULL
+      GROUP BY c.req_id, t.code, c.code, c.status ORDER BY t.code, c.code
+    `.execute(db as never),
+  ]);
+  const byRef = new Map<string, string>();
+  for (const requirement of requirements.rows) {
+    byRef.set(requirement.id, requirement.id);
+    byRef.set(requirement.code, requirement.id);
+  }
+  const assignments = new Map<string, Set<string>>();
+  for (const event of declarations.rows) {
+    for (const ref of stringArray(event.req_ids)) {
+      const reqId = byRef.get(ref);
+      if (reqId) addAssignment(assignments, reqId, event.task_code);
+    }
+  }
+  const linkedByReq = new Map<string, RequirementCoverageRow['linked_criteria']>();
+  for (const row of criteria.rows) {
+    const linked = linkedByReq.get(row.req_id) ?? [];
+    linked.push({ task: row.task_code, criterion: row.criterion, status: row.status, evidence_count: row.evidence_count });
+    linkedByReq.set(row.req_id, linked);
+    addAssignment(assignments, row.req_id, row.task_code);
+  }
+  const rows = requirements.rows.map((requirement): RequirementCoverageRow => {
+    const assigned = [...(assignments.get(requirement.id) ?? [])].sort();
+    const linked = linkedByReq.get(requirement.id) ?? [];
+    const covered = linked.length > 0 && linked.every((item) => item.status === 'verified' && item.evidence_count > 0);
+    return {
+      id: requirement.id,
+      code: requirement.code,
+      text: requirement.text,
+      status: requirement.status,
+      assignment_tasks: assigned,
+      linked_criteria: linked,
+      coverage: coverageStatus(requirement.status, assigned.length, linked.length, covered),
+    };
+  });
+  return {
+    requirements: rows,
+    unassigned: rows.filter((row) => row.coverage === 'unassigned').map((row) => row.code),
+    total: rows.length,
+  };
+}
+
+function addAssignment(assignments: Map<string, Set<string>>, reqId: string, taskCode: string): void {
+  const tasks = assignments.get(reqId) ?? new Set<string>();
+  tasks.add(taskCode);
+  assignments.set(reqId, tasks);
+}
+
+function coverageStatus(
+  status: string,
+  assigned: number,
+  linked: number,
+  covered: boolean,
+): RequirementCoverageRow['coverage'] {
+  if (status === 'dropped') return 'dropped';
+  if (covered) return 'covered';
+  if (linked) return 'in_progress';
+  return assigned ? 'assigned' : 'unassigned';
+}
+
+function stringArray(value: unknown): string[] {
+  if (Array.isArray(value)) return value.filter((item): item is string => typeof item === 'string');
+  if (typeof value !== 'string') return [];
+  try {
+    const parsed: unknown = JSON.parse(value);
+    return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === 'string') : [];
+  } catch {
+    return [];
+  }
+}
