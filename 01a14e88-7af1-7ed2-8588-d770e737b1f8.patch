diff --git a/apps/api/src/modules/exec/baseline-tools.ts b/apps/api/src/modules/exec/baseline-tools.ts
new file mode 100644
index 0000000..097369e
--- /dev/null
+++ b/apps/api/src/modules/exec/baseline-tools.ts
@@ -0,0 +1,425 @@
+import { sql } from 'kysely';
+import { z } from 'zod';
+import {
+  activeCipher,
+  appendEvent,
+  baselineFromLog,
+  getEffective,
+  getSecret,
+  isProtectedTest,
+  newId,
+  resolveExecReviewSource,
+  toJsonb,
+  unitOfWork,
+  type Db,
+  type ParserCfg,
+} from '@forgepm/core';
+import { AppError, DEFAULT_TEST_PARSER, detectWeakening, idOrCodeSchema } from '@forgepm/shared';
+import type { Actor } from '../../app/auth-context';
+import { projectForTask, projectRefSchema, auditIn } from './context';
+import { readCiLog } from './ci-log-source';
+
+const MAX_PROTECTED_FILES = 250;
+const MAX_CAPTURED_TESTS = 5_000;
+
+export const baselineCaptureInputSchema = z.strictObject({
+  task_ref: idOrCodeSchema,
+  project_ref: projectRefSchema.optional(),
+});
+
+interface TaskRow {
+  id: string;
+  code: string;
+  status: string;
+  start_ref: string | null;
+}
+
+interface CapturedTest {
+  name: string;
+  result: 'pass' | 'fail' | 'skip';
+}
+
+interface CapturedCiRun {
+  provider: string;
+  run_id: string;
+  job: string;
+  sha: string;
+  sha256_log: string;
+  tests: CapturedTest[];
+  totals: { pass: number; fail: number; skip: number };
+  complete: true;
+  captured_at: string;
+  weakening: { path: string; assertions_before: number; assertions_after: number; count_delta: number; modifiers: string[] }[];
+}
+
+/**
+ * Capture CI evidence by looking up only SHAs measured by the server. The
+ * caller cannot submit a SHA, a log, a test name or a result. ForgePM never
+ * executes the repository; the endpoint is configured by an administrator.
+ */
+export async function baselineCaptureTool(db: Db, actor: Actor, raw: unknown): Promise<Record<string, unknown>> {
+  const args = baselineCaptureInputSchema.parse(raw ?? {});
+  const projectId = await projectForTask(db, actor, args.task_ref, args.project_ref);
+  const task = await findTask(db, actor.organizationId, projectId, args.task_ref);
+  if (!task) throw new AppError('NOT_FOUND', `no task '${args.task_ref}' in this project`, { ref: args.task_ref });
+  if (task.status === 'done') {
+    throw new AppError('LEDGER_STATE_INVALID', `task ${task.code} is already closed`, {
+      needed_action: 'a closed task keeps its captured baseline; open a new task for new work',
+    });
+  }
+  const startSha = task.start_ref;
+  if (!startSha || !/^[0-9a-f]{40,64}$/i.test(startSha)) {
+    return unavailable(task, 'task has no code-captured start commit SHA');
+  }
+
+  const [sourceSetting, endpointSetting, secretNameSetting, parserSetting, protectedSetting, privateSetting] = await Promise.all([
+    getEffective(db, 'exec.baseline_source', actor.organizationId, projectId),
+    getEffective(db, 'exec.ci_log_endpoint', actor.organizationId, projectId),
+    getEffective(db, 'exec.ci_log_secret_name', actor.organizationId, projectId),
+    getEffective(db, 'exec.test_result_parser', actor.organizationId, projectId),
+    getEffective(db, 'exec.protected_test_globs', actor.organizationId, projectId),
+    getEffective(db, 'network.allow_private_targets', actor.organizationId, projectId),
+  ]);
+  if (sourceSetting?.value === 'off') return unavailable(task, 'exec.baseline_source is off');
+  const endpoint = typeof endpointSetting?.value === 'string' ? endpointSetting.value : '';
+  const secretName = typeof secretNameSetting?.value === 'string' ? secretNameSetting.value.trim() : '';
+  if (!endpoint) return unavailable(task, 'exec.ci_log_endpoint is not configured');
+  if (!secretName) return unavailable(task, 'exec.ci_log_secret_name is not configured');
+  let secret: string | null = null;
+  try {
+    secret = await getSecret(db, activeCipher(), actor.organizationId, secretName, 'system');
+  } catch {
+    return unavailable(task, 'read-only CI secret could not be read from the encrypted secrets store');
+  }
+  if (!secret) return unavailable(task, `read-only CI secret '${secretName}' is not present in the encrypted secrets store`);
+
+  const source = resolveExecReviewSource();
+  if (!source?.headSha || !source.isWorktreeClean || !source.changedFiles || !source.readFilePair) {
+    return unavailable(task, 'read-only Git source cannot verify the current commit and protected test files');
+  }
+  let currentSha: string;
+  let clean: boolean;
+  try {
+    [currentSha, clean] = await Promise.all([source.headSha(), source.isWorktreeClean()]);
+  } catch {
+    return unavailable(task, 'current commit could not be measured');
+  }
+  currentSha = currentSha.toLowerCase();
+  if (!/^[0-9a-f]{40,64}$/.test(currentSha)) return unavailable(task, 'current commit SHA is invalid');
+
+  const parser = parseParser(parserSetting?.value);
+  if (!parser) return unavailable(task, 'exec.test_result_parser is invalid or exceeds safe limits');
+  const protectedGlobs = Array.isArray(protectedSetting?.value)
+    ? protectedSetting.value.filter((value): value is string => typeof value === 'string')
+    : [];
+  if (!protectedGlobs.length) return unavailable(task, 'exec.protected_test_globs is empty');
+  const allowPrivateTargets = privateSetting?.value === true;
+
+  const startRead = await readCiLog({
+    endpoint,
+    sha: startSha,
+    secret,
+    allowPrivateTargets,
+  });
+  if (!startRead.ok) return unavailable(task, startRead.reason);
+  const startParsed = baselineFromLog(startRead.snapshot.log, parser, 'ci');
+  if (!validParsedRun(startParsed)) return unavailable(task, 'start CI log did not contain complete, named per-test results');
+  if (startParsed.rows.length > MAX_CAPTURED_TESTS) return unavailable(task, 'start CI log contains too many tests to capture safely');
+
+  const afterRead = clean
+    ? currentSha === startSha.toLowerCase()
+      ? startRead
+      : await readCiLog({ endpoint, sha: currentSha, secret, allowPrivateTargets })
+    : { ok: false as const, reason: 'current worktree is dirty; commit the changes before matching a CI log' };
+  let afterRun: CapturedCiRun | null = null;
+  let afterFailure: string | null = null;
+  if (afterRead.ok) {
+    const afterParsed = baselineFromLog(afterRead.snapshot.log, parser, 'ci');
+    if (!validParsedRun(afterParsed)) {
+      afterFailure = 'current CI log did not contain complete, named per-test results';
+    } else if (afterParsed.rows.length > MAX_CAPTURED_TESTS) {
+      afterFailure = 'current CI log contains too many tests to capture safely';
+    } else {
+      try {
+        const changes = await source.changedFiles({ start_ref: startSha });
+        const protectedChanges = changes.filter((file) => isProtectedTest(file.path, protectedGlobs));
+        if (protectedChanges.length > MAX_PROTECTED_FILES) throw new Error('too many protected test files changed');
+        const weakening: CapturedCiRun['weakening'] = [];
+        for (const file of protectedChanges) {
+          const pair = await source.readFilePair({ start_ref: startSha, path: file.path, status: file.status });
+          const measured = detectWeakening(pair.before ?? '', pair.after ?? '', file.path);
+          if (measured) {
+            weakening.push({
+              path: measured.path,
+              assertions_before: measured.assertionsBefore,
+              assertions_after: measured.assertionsAfter,
+              count_delta: measured.countDelta,
+              modifiers: measured.addedModifiers,
+            });
+          }
+        }
+        const [confirmedSha, stillClean] = await Promise.all([source.headSha(), source.isWorktreeClean()]);
+        if (!stillClean || confirmedSha.toLowerCase() !== currentSha) {
+          throw new Error('worktree changed while CI results were being captured');
+        }
+        afterRun = {
+          provider: afterRead.snapshot.provider,
+          run_id: afterRead.snapshot.run_id,
+          job: afterRead.snapshot.job,
+          sha: afterRead.snapshot.sha,
+          sha256_log: afterRead.snapshot.sha256_log,
+          tests: afterParsed.rows.map((row) => ({ name: row.name, result: row.result })),
+          totals: afterParsed.totals,
+          complete: true,
+          captured_at: new Date().toISOString(),
+          weakening,
+        };
+      } catch (error) {
+        afterFailure = error instanceof Error ? error.message : 'protected test files could not be measured safely';
+      }
+    }
+  } else {
+    afterFailure = afterRead.reason;
+  }
+
+  const startRun = {
+    provider: startRead.snapshot.provider,
+    run_id: startRead.snapshot.run_id,
+    job: startRead.snapshot.job,
+    sha: startRead.snapshot.sha,
+    sha256_log: startRead.snapshot.sha256_log,
+    captured_at: new Date().toISOString(),
+    test_count: startParsed.rows.length,
+    totals: startParsed.totals,
+  };
+  let startCaptured = false;
+  let storedStartProvenance: { run_id: string; job: string; sha: string; sha256_log: string } | null = null;
+  await unitOfWork(db, async ({ tx }) => {
+    const existing = await tx
+      .selectFrom('exec_baseline_tests')
+      .select(['test_name', 'result_at_start', 'source', 'provenance'])
+      .where('task_id', '=', task.id)
+      .execute();
+    if (!existing.length) {
+      const provenance = {
+        provider: startRun.provider,
+        run_id: startRun.run_id,
+        job: startRun.job,
+        sha: startRun.sha,
+        sha256_log: startRun.sha256_log,
+        captured_at: startRun.captured_at,
+      };
+      await tx
+        .insertInto('exec_baseline_tests')
+        .values(
+          startParsed.rows.map((row) => ({
+            id: newId(),
+            task_id: task.id,
+            test_name: row.name,
+            result_at_start: row.result,
+            assertion_count: row.assertions ?? null,
+            source: 'ci' as const,
+            approval_id: null,
+            provenance: toJsonb(provenance) as never,
+          })),
+        )
+        .execute();
+      await appendEvent(tx, {
+        organization_id: actor.organizationId,
+        task_id: task.id,
+        entity: 'baseline',
+        entity_id: task.id,
+        entity_code: task.code,
+        action: 'baseline.start_captured',
+        actor_type: 'system',
+        actor_id: 'ci-baseline-reader',
+        tool: 'baseline_capture',
+        payload: { start: startRun },
+      });
+      startCaptured = true;
+      storedStartProvenance = {
+        run_id: startRun.run_id,
+        job: startRun.job,
+        sha: startRun.sha,
+        sha256_log: startRun.sha256_log,
+      };
+    } else {
+      if (!sameBaseline(existing, startParsed.rows, startSha)) {
+        throw new AppError('LEDGER_STATE_INVALID', 'stored baseline provenance does not match the task start SHA', {
+          needed_action: 'do not replace a baseline silently; ask a human to waive it or create a new task',
+        });
+      }
+      const provenance = objectValue(existing[0]?.provenance);
+      if (
+        !provenance || typeof provenance.run_id !== 'string' || typeof provenance.job !== 'string' ||
+        typeof provenance.sha !== 'string' || typeof provenance.sha256_log !== 'string'
+      ) {
+        throw new AppError('LEDGER_STATE_INVALID', 'stored CI baseline provenance is incomplete', {
+          needed_action: 'do not replace a baseline silently; ask a human to waive it or create a new task',
+        });
+      }
+      storedStartProvenance = {
+        run_id: provenance.run_id,
+        job: provenance.job,
+        sha: provenance.sha,
+        sha256_log: provenance.sha256_log,
+      };
+    }
+
+    if (afterRun) {
+      await appendEvent(tx, {
+        organization_id: actor.organizationId,
+        task_id: task.id,
+        entity: 'baseline',
+        entity_id: task.id,
+        entity_code: task.code,
+        action: 'baseline.captured',
+        actor_type: 'system',
+        actor_id: 'ci-baseline-reader',
+        tool: 'baseline_capture',
+        payload: { after: afterRun },
+      });
+    }
+    await auditIn(tx, actor, 'exec.baseline.capture', 'exec_task', task.id, {
+      task: task.code,
+      start_sha: startSha,
+      current_sha: currentSha,
+      start_test_count: startParsed.rows.length,
+      after_test_count: afterRun?.tests.length ?? 0,
+      weakening_count: afterRun?.weakening.length ?? 0,
+      start_captured: startCaptured,
+      ready: afterRun !== null,
+    });
+  });
+
+  if (!afterRun) {
+    return {
+      ok: false,
+      code: 'BASELINE_UNAVAILABLE',
+      task_id: task.id,
+      task_code: task.code,
+      start_sha: startSha,
+      current_sha: currentSha,
+      baseline_tests: startParsed.rows.length,
+      needed_action: afterFailure ?? 'capture both CI logs for the exact start and current commit SHAs',
+      human_waive_route: `/api/v1/exec/tasks/${task.id}/baseline/waive`,
+    };
+  }
+  return {
+    ok: true,
+    task_id: task.id,
+    task_code: task.code,
+    start_sha: startSha,
+    current_sha: currentSha,
+    start_test_count: startParsed.rows.length,
+    current_test_count: afterRun.tests.length,
+    weakening_count: afterRun.weakening.length,
+    start_captured: startCaptured,
+    provenance: {
+      start: storedStartProvenance ?? {
+        run_id: startRun.run_id,
+        job: startRun.job,
+        sha: startRun.sha,
+        sha256_log: startRun.sha256_log,
+      },
+      current: { run_id: afterRun.run_id, job: afterRun.job, sha: afterRun.sha, sha256_log: afterRun.sha256_log },
+    },
+  };
+}
+
+async function findTask(db: Db, organizationId: string, projectId: string, ref: string): Promise<TaskRow | null> {
+  const result = await sql<TaskRow>`
+    SELECT id::text AS id, code, status, start_ref
+    FROM exec_tasks
+    WHERE organization_id = ${organizationId} AND project_id = ${projectId}
+      AND (code = ${ref} OR id::text = ${ref})
+    LIMIT 1
+  `.execute(db as never);
+  return result.rows[0] ?? null;
+}
+
+function parseParser(value: unknown): ParserCfg | null {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return {
+      pass: [...DEFAULT_TEST_PARSER.pass],
+      fail: [...DEFAULT_TEST_PARSER.fail],
+      skip: [...DEFAULT_TEST_PARSER.skip],
+      test_line: DEFAULT_TEST_PARSER.test_line,
+    };
+  }
+  const raw = value as Record<string, unknown>;
+  const groups = ['pass', 'fail', 'skip'] as const;
+  const parsed: ParserCfg = { pass: [], fail: [], skip: [], test_line: '' };
+  for (const group of groups) {
+    const values = raw[group];
+    if (values === undefined) continue;
+    if (!Array.isArray(values) || values.length > 20 || values.some((item) => typeof item !== 'string' || item.length > 200)) return null;
+    try {
+      for (const pattern of values as string[]) new RegExp(pattern, 'i');
+    } catch {
+      return null;
+    }
+    parsed[group] = values as string[];
+  }
+  if (raw.test_line !== undefined) {
+    if (typeof raw.test_line !== 'string' || raw.test_line.length > 200) return null;
+    parsed.test_line = raw.test_line;
+  }
+  return parsed;
+}
+
+function validParsedRun(parsed: ReturnType<typeof baselineFromLog>): boolean {
+  const reported = parsed.totals.pass + parsed.totals.fail + parsed.totals.skip;
+  const named = {
+    pass: parsed.rows.filter((row) => row.result === 'pass').length,
+    fail: parsed.rows.filter((row) => row.result === 'fail').length,
+    skip: parsed.rows.filter((row) => row.result === 'skip').length,
+  };
+  return (
+    parsed.complete &&
+    parsed.rows.length > 0 &&
+    parsed.rows.length >= reported &&
+    named.pass >= parsed.totals.pass &&
+    named.fail >= parsed.totals.fail &&
+    named.skip >= parsed.totals.skip &&
+    parsed.rows.every((row) => row.name.length > 0)
+  );
+}
+
+function sameBaseline(
+  existing: { test_name: string; result_at_start: string; source: string; provenance: unknown }[],
+  parsed: { name: string; result: string }[],
+  expectedSha: string,
+): boolean {
+  if (existing.length !== parsed.length) return false;
+  const expected = new Map(parsed.map((row) => [row.name, row.result]));
+  return existing.every((row) => {
+    if (row.source !== 'ci' || row.result_at_start !== expected.get(row.test_name)) return false;
+    const provenance = objectValue(row.provenance);
+    return typeof provenance?.sha === 'string' && provenance.sha.toLowerCase() === expectedSha.toLowerCase();
+  });
+}
+
+function objectValue(value: unknown): Record<string, unknown> | null {
+  if (value && typeof value === 'object' && !Array.isArray(value)) return value as Record<string, unknown>;
+  if (typeof value === 'string') {
+    try {
+      const parsed: unknown = JSON.parse(value);
+      return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? (parsed as Record<string, unknown>) : null;
+    } catch {
+      return null;
+    }
+  }
+  return null;
+}
+
+function unavailable(task: TaskRow, reason: string): Record<string, unknown> {
+  return {
+    ok: false,
+    code: 'BASELINE_UNAVAILABLE',
+    task_id: task.id,
+    task_code: task.code,
+    needed_action: reason,
+    human_waive_route: `/api/v1/exec/tasks/${task.id}/baseline/waive`,
+  };
+}
diff --git a/apps/api/src/modules/exec/ci-log-source.ts b/apps/api/src/modules/exec/ci-log-source.ts
new file mode 100644
index 0000000..92dedb3
--- /dev/null
+++ b/apps/api/src/modules/exec/ci-log-source.ts
@@ -0,0 +1,149 @@
+import { createHash } from 'node:crypto';
+import { z } from 'zod';
+import { isBlockedPrivateHostAll } from '../../app/ssrf';
+
+const MAX_CI_RESPONSE_BYTES = 1_048_576;
+const CI_TIMEOUT_MS = 8_000;
+
+const ciEnvelopeSchema = z.strictObject({
+  sha: z.string().regex(/^[0-9a-f]{40,64}$/i),
+  run_id: z.string().min(1).max(200),
+  job: z.string().min(1).max(200),
+  provider: z.string().min(1).max(100).optional(),
+  log: z.string().min(1).max(MAX_CI_RESPONSE_BYTES),
+});
+
+export interface CiLogSnapshot {
+  provider: string;
+  run_id: string;
+  job: string;
+  sha: string;
+  log: string;
+  sha256_log: string;
+}
+
+export type CiLogReadResult =
+  | { ok: true; snapshot: CiLogSnapshot }
+  | { ok: false; reason: string };
+
+/**
+ * Read a CI log through an administrator-configured, SHA-addressed endpoint.
+ * The endpoint must return a JSON envelope (sha, run_id, job, log), so a log
+ * for a different commit can never be passed off as the requested baseline.
+ * Redirects are refused and response size/time are bounded.
+ */
+export async function readCiLog(input: {
+  endpoint: string;
+  sha: string;
+  secret: string;
+  allowPrivateTargets?: boolean;
+  fetcher?: typeof fetch;
+  privateHostGuard?: typeof isBlockedPrivateHostAll;
+}): Promise<CiLogReadResult> {
+  const sha = input.sha.trim().toLowerCase();
+  if (!/^[0-9a-f]{40,64}$/.test(sha)) return { ok: false, reason: 'CI commit SHA is invalid' };
+  if (!input.endpoint.trim()) return { ok: false, reason: 'exec.ci_log_endpoint is not configured' };
+  if (!input.secret.trim()) return { ok: false, reason: 'read-only CI log secret is not configured' };
+  if (hasInvalidHeaderCharacter(input.secret)) return { ok: false, reason: 'CI log secret contains invalid header characters' };
+
+  let url: URL;
+  try {
+    const hasShaToken = input.endpoint.includes('{sha}');
+    const expanded = hasShaToken ? input.endpoint.replaceAll('{sha}', encodeURIComponent(sha)) : input.endpoint;
+    url = new URL(expanded);
+    if (!hasShaToken) url.searchParams.set('sha', sha);
+  } catch {
+    return { ok: false, reason: 'exec.ci_log_endpoint is not a valid URL template' };
+  }
+  if (url.protocol !== 'https:' || url.username || url.password || url.hash) {
+    return { ok: false, reason: 'CI endpoint must be HTTPS without userinfo or a fragment' };
+  }
+
+  const guardHost = input.privateHostGuard ?? isBlockedPrivateHostAll;
+  try {
+    if (await guardHost(url.toString(), input.allowPrivateTargets ?? false)) {
+      return { ok: false, reason: 'CI endpoint is blocked by the SSRF policy' };
+    }
+  } catch {
+    return { ok: false, reason: 'CI endpoint could not be validated by the SSRF policy' };
+  }
+
+  let response: Response;
+  try {
+    response = await (input.fetcher ?? fetch)(url, {
+      method: 'GET',
+      redirect: 'error',
+      signal: AbortSignal.timeout(CI_TIMEOUT_MS),
+      headers: {
+        accept: 'application/json',
+        authorization: `Bearer ${input.secret}`,
+      },
+    });
+  } catch {
+    return { ok: false, reason: 'CI log request failed or timed out' };
+  }
+  if (!response.ok) return { ok: false, reason: `CI log endpoint returned HTTP ${response.status}` };
+  const contentType = response.headers.get('content-type')?.split(';', 1)[0]?.trim().toLowerCase();
+  if (contentType !== 'application/json') return { ok: false, reason: 'CI endpoint did not return a JSON log envelope' };
+
+  let body: string;
+  try {
+    body = await readBoundedBody(response, MAX_CI_RESPONSE_BYTES);
+  } catch {
+    return { ok: false, reason: 'CI log response exceeded the safe size limit or could not be read' };
+  }
+  let raw: unknown;
+  try {
+    raw = JSON.parse(body);
+  } catch {
+    return { ok: false, reason: 'CI endpoint returned invalid JSON' };
+  }
+  const parsed = ciEnvelopeSchema.safeParse(raw);
+  if (!parsed.success) return { ok: false, reason: 'CI response is missing sha, run_id, job or log' };
+  const envelope = parsed.data;
+  if (envelope.sha.toLowerCase() !== sha) {
+    return { ok: false, reason: 'CI log SHA does not match the requested commit SHA' };
+  }
+  const snapshot: CiLogSnapshot = {
+    provider: envelope.provider ?? 'generic',
+    run_id: envelope.run_id,
+    job: envelope.job,
+    sha,
+    log: envelope.log,
+    sha256_log: createHash('sha256').update(envelope.log, 'utf8').digest('hex'),
+  };
+  return { ok: true, snapshot };
+}
+
+function hasInvalidHeaderCharacter(value: string): boolean {
+  for (const character of value) {
+    const code = character.codePointAt(0) ?? 0;
+    if (code <= 0x1f || code === 0x7f) return true;
+  }
+  return false;
+}
+
+async function readBoundedBody(response: Response, maxBytes: number): Promise<string> {
+  if (!response.body) throw new Error('empty response');
+  const reader = response.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let length = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      length += value.byteLength;
+      if (length > maxBytes) throw new Error('response too large');
+      chunks.push(value);
+    }
+  } catch (error) {
+    await reader.cancel().catch(() => undefined);
+    throw error;
+  } finally {
+    reader.releaseLock();
+  }
+  const bytes = Buffer.concat(chunks.map((chunk) => Buffer.from(chunk)), length);
+  const text = bytes.toString('utf8');
+  if (!Buffer.from(text, 'utf8').equals(bytes)) throw new Error('invalid UTF-8');
+  return text;
+}
diff --git a/apps/api/src/modules/exec/closing-tools.ts b/apps/api/src/modules/exec/closing-tools.ts
new file mode 100644
index 0000000..f862951
--- /dev/null
+++ b/apps/api/src/modules/exec/closing-tools.ts
@@ -0,0 +1,131 @@
+import { z } from 'zod';
+import { AppError, exitReportObjectSchema, idOrCodeSchema } from '@forgepm/shared';
+import {
+  applyFactVerification,
+  completeTask,
+  normalizeExitReportPayload,
+  prepareFactVerification,
+  resolveExecReviewSource,
+  SYSTEM_ACTOR_ID,
+  parseExitReport,
+  submitExitReport,
+  unitOfWork,
+  type Db,
+} from '@forgepm/core';
+import type { Actor } from '../../app/auth-context';
+import { auditIn, ledgerActor, parseTool, projectForTask, projectRefSchema } from './context';
+
+/**
+ * PE-3's two closing tools (plan §8): the exit report and the gate.
+ *
+ * They live together because they are two halves of one act: the report says
+ * what was done, the gate says whether that is enough. The rules are in
+ * `@forgepm/core/src/exec`; what is here is the API's share — which project,
+ * which transaction, which audit row.
+ */
+
+/**
+ * The exit report's own shape, plus the API-level `project_ref`. The strict
+ * object is shared with the service so the advertised schema and the schema
+ * that validates the call cannot drift apart.
+ *
+ * The `preprocess` is the *alias*, not a loophole: the plan (§8.1) calls the
+ * task's field `task_id` and the repo calls it `task_ref`, so both spellings
+ * are accepted and the canonical one is what the ledger sees. The advertised
+ * shape is unchanged — a preprocess does not add a key, it renames one (see
+ * `jsonSchemaFor`, which unwraps the wrapper).
+ */
+export const exitReportToolSchema = z.preprocess(
+  (raw) => normalizeExitReportPayload(raw),
+  exitReportObjectSchema.extend({
+    project_ref: projectRefSchema.optional(),
+  }),
+);
+
+export const completeToolSchema = z.strictObject({
+  task_ref: idOrCodeSchema,
+  /** The report to close on (a uuid — reports have no code of their own). */
+  report_ref: z.string().uuid().optional(),
+  project_ref: projectRefSchema.optional(),
+});
+
+/**
+ * `exec_submit_exit_report` (plan §8.1).
+ *
+ * The report is written and its findings become open items in ONE
+ * transaction, so a report can never exist without the items it promised.
+ * `project_ref` is an API-level field and is stripped before the strict
+ * ledger schema sees the payload.
+ */
+export async function submitExitReportTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const { project_ref, ...rest } = (raw ?? {}) as Record<string, unknown>;
+  const parsed = parseExitReport(rest);
+  if (!parsed.ok) {
+    throw new AppError('UNPROCESSABLE', parsed.message, {
+      needed_action: parsed.needed_action,
+      ...(parsed.details ?? {}),
+    });
+  }
+  const projectId = await projectForTask(db, actor, parsed.value.taskRef, project_ref as string | undefined);
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const row = await submitExitReport(tx, ledgerActor(actor, projectId, 'exec_submit_exit_report'), rest);
+    await auditIn(tx, actor, 'exec.exit_report.submit', 'exec_report', row.report_id, {
+      task: row.task_code,
+      promoted: row.promoted,
+      referenced: row.referenced,
+    });
+    out = row;
+  });
+  return out;
+}
+
+/**
+ * `exec_task_complete` (plan §8.2) — the one door to `done`.
+ *
+ * A refusal is an ANSWER, not an error: the agent gets `{ ok:false,
+ * blocked_by:[…] }` with the rule, the reference, what is needed and which
+ * tool to call. The gate's stamp, the status change and the audit row are
+ * one transaction.
+ */
+export async function completeTaskTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<z.infer<typeof completeToolSchema>>(
+    completeToolSchema,
+    raw,
+    'send { task_ref } — the gate reads the ledger, not the message',
+  );
+  const projectId = await projectForTask(db, actor, tool.task_ref, tool.project_ref);
+  const ledger = ledgerActor(actor, projectId, 'exec_task_complete');
+  const factActor = {
+    organizationId: actor.organizationId,
+    projectId,
+    actorType: 'system' as const,
+    actorId: SYSTEM_ACTOR_ID,
+    tool: 'exec_task_complete',
+  };
+  const factPreparation = await prepareFactVerification(db, ledger, resolveExecReviewSource());
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const checked = await applyFactVerification(tx, factActor, factPreparation);
+    for (const change of checked.changes) {
+      if (change.to !== 'stale' || change.from !== 'active') continue;
+      await auditIn(tx, actor, 'exec.fact.stale', 'exec_fact', change.id, {
+        code: change.code,
+        changed_files: change.changed_files,
+        warning: change.warning,
+        trigger: 'exec_task_complete',
+      });
+    }
+    const row = await completeTask(tx, ledger, tool.task_ref, {
+      reportId: tool.report_ref ?? null,
+    });
+    await auditIn(tx, actor, 'exec.task.complete', 'exec_task', row.task_id, {
+      ok: row.ok,
+      status: row.status,
+      stamp_id: row.stamp_id,
+      blocked_by: row.blocked_by.map((b) => `${b.rule}:${b.ref}`),
+    });
+    out = row;
+  });
+  return out;
+}
diff --git a/apps/api/src/modules/exec/context.ts b/apps/api/src/modules/exec/context.ts
new file mode 100644
index 0000000..6e7afe6
--- /dev/null
+++ b/apps/api/src/modules/exec/context.ts
@@ -0,0 +1,116 @@
+import { sql } from 'kysely';
+import { z } from 'zod';
+import { AppError } from '@forgepm/shared';
+import { recordAudit, type Db, type DbLike, type LedgerActor } from '@forgepm/core';
+import type { Actor } from '../../app/auth-context';
+import { assertProjectAccess } from '../projects/access';
+
+/**
+ * The shared plumbing of every exec tool (plan §7, §8).
+ *
+ * Which project the caller means, whether the task exists in it, who the
+ * ledger actor is and how the audit row is written — none of that belongs to
+ * an individual tool, and a second copy of it is a second answer. The tools
+ * themselves stay thin: schema in, ledger out.
+ */
+
+export const projectRefSchema = z.string().min(1).max(64);
+
+/** A malformed call is an answer, not a crash: same shape as the ledger parsers (A.5). */
+export function parseTool<T extends object>(schema: z.ZodTypeAny, raw: unknown, neededAction: string): T {
+  const parsed = schema.safeParse(raw ?? {});
+  if (parsed.success) return parsed.data as T;
+  const issue = parsed.error.issues[0] ?? { path: [], message: 'payload did not parse' };
+  const path = (issue.path as (string | number)[]).join('.');
+  throw new AppError('VALIDATION_ERROR', path ? `${path}: ${issue.message}` : issue.message, {
+    needed_action: neededAction,
+  });
+}
+
+/** `{project_ref}` is optional everywhere; the rule for filling it in lives here. */
+export async function resolveProject(
+  db: DbLike,
+  actor: Actor,
+  ref: string | undefined,
+  action: 'project:read' | 'project:write',
+): Promise<string> {
+  if (ref) {
+    // `id::text` because a caller may pass the PRJ-key; comparing a text key to a uuid
+    // column is a postgres type error, which would surface as INTERNAL rather than
+    // "no such project".
+    const found = await sql<{ id: string }>`
+      SELECT id::text AS id FROM projects
+      WHERE organization_id = ${actor.organizationId} AND (id::text = ${ref} OR key = ${ref})
+    `.execute(db as never);
+    const row = found.rows[0];
+    if (!row) {
+      throw new AppError('NOT_FOUND', `no project '${ref}' in this organisation`, {
+        ref,
+        needed_action: 'the key may only touch the projects it is bound to',
+      });
+    }
+    await assertProjectAccess(db as Db, actor, row.id, action);
+    return row.id;
+  }
+  if (actor.projectIds && actor.projectIds.length === 1) {
+    await assertProjectAccess(db as Db, actor, actor.projectIds[0], action);
+    return actor.projectIds[0];
+  }
+  throw new AppError('VALIDATION_ERROR', 'the ledger needs one project to write into', {
+    needed_action: 'pass project_ref (id or PRJ-key), or bind the API key to a single project',
+  });
+}
+
+/**
+ * A task code is unique per project, not per org, so `T-004` alone can name several
+ * tasks. Resolving it by project is fine; guessing between two projects is not.
+ */
+export async function projectForTask(db: DbLike, actor: Actor, taskRef: string, explicit?: string): Promise<string> {
+  if (explicit) return resolveProject(db, actor, explicit, 'project:read');
+  const rows = await sql<{ project_id: string }>`
+    SELECT project_id::text AS project_id FROM exec_tasks
+    WHERE organization_id = ${actor.organizationId} AND (code = ${taskRef} OR id::text = ${taskRef})
+  `.execute(db as never);
+  const found = [...new Set(rows.rows.map((r) => r.project_id))];
+  const narrowed = actor.projectIds ? found.filter((p) => actor.projectIds?.includes(p)) : found;
+  if (narrowed.length === 1) return narrowed[0];
+  if (!narrowed.length) {
+    throw new AppError('NOT_FOUND', `no ledger task '${taskRef}' you may write to`, {
+      ref: taskRef,
+      needed_action: 'exec_task_start creates the task; ledger_status without task_ref lists what exists',
+    });
+  }
+  throw new AppError('VALIDATION_ERROR', `'${taskRef}' names a task in ${narrowed.length} projects`, {
+    needed_action: 'pass project_ref to pick one',
+  });
+}
+
+export function ledgerActor(actor: Actor, projectId: string, tool: string): LedgerActor {
+  return {
+    organizationId: actor.organizationId,
+    projectId,
+    actorType: actor.type === 'agent' ? 'agent' : 'human',
+    actorId: actor.id,
+    tool,
+  };
+}
+
+export function auditIn(
+  tx: DbLike,
+  actor: Actor,
+  action: string,
+  resourceType: string,
+  resourceId: string,
+  summary: unknown,
+): Promise<string> {
+  return recordAudit(tx, {
+    organization_id: actor.organizationId,
+    actor_type: actor.type === 'agent' ? 'agent' : 'user',
+    actor_id: actor.id,
+    action,
+    resource_type: resourceType,
+    resource_id: resourceId,
+    summary,
+    request_id: actor.requestId,
+  });
+}
diff --git a/apps/api/src/modules/exec/decision-tools.ts b/apps/api/src/modules/exec/decision-tools.ts
new file mode 100644
index 0000000..d44a10b
--- /dev/null
+++ b/apps/api/src/modules/exec/decision-tools.ts
@@ -0,0 +1,128 @@
+import { decisionObjectSchema, decisionRefinement, questionObjectSchema, questionRefinement } from '@forgepm/shared';
+import {
+  askHuman,
+  classify,
+  EXEC_POLICY_DEFAULT,
+  getEffective,
+  journalWriteLock,
+  recordDecision,
+  throwIfJournalLocked,
+  unitOfWork,
+  unresolvedJournalRows,
+  type Db,
+} from '@forgepm/core';
+import type { ExecPolicy } from '@forgepm/shared';
+import type { Actor } from '../../app/auth-context';
+import { auditIn, ledgerActor, parseTool, projectForTask, projectRefSchema } from './context';
+
+/**
+ * PE-4's two "the agent must involve a human" tools (plan §9.2, §9.3).
+ *
+ * `ledger_record_decision` writes down a choice AND the risk the policy
+ * assigns to it; `ledger_ask_human` writes down a question whose options
+ * each have a stated consequence. Both end in the same place: a row the gate
+ * can read, so "why was this done" and "what is still waiting" are facts
+ * rather than prose.
+ */
+
+export const decisionToolSchema = decisionObjectSchema
+  .extend({
+    project_ref: projectRefSchema.optional(),
+  })
+  .superRefine(decisionRefinement);
+
+export const questionToolSchema = questionObjectSchema
+  .extend({
+    project_ref: projectRefSchema.optional(),
+  })
+  .superRefine(questionRefinement);
+
+export async function recordDecisionTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(
+    decisionToolSchema,
+    raw,
+    'send { task_ref, title, context, options, selected, rationale, reversible, touches } — the risk level is computed, never sent',
+  );
+  const projectId = await projectForTask(db, actor, String(tool.task_ref), tool.project_ref as string | undefined);
+  const policy = await effectivePolicy(db, actor.organizationId, projectId);
+  const payload = decisionPayload(tool);
+  const ledger = ledgerActor(actor, projectId, 'ledger_record_decision');
+  const approvalDecision =
+    classify(policy, { touches: tool.touches as string[], reversible: tool.reversible as boolean }).level === 'approval';
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const open = await unresolvedJournalRows(tx, actor.organizationId, projectId);
+    throwIfJournalLocked(
+      journalWriteLock({
+        tool: 'ledger_record_decision',
+        actorType: ledger.actorType,
+        openRows: open,
+        approvalDecision,
+      }),
+    );
+    const row = await recordDecision(tx, ledger, payload, policy);
+    await auditIn(tx, actor, 'exec.decision.record', 'exec_decision', row.id, {
+      task: row.task_code,
+      code: row.code,
+      risk_level: row.risk_level,
+      approval_state: row.approval_state,
+    });
+    out = row;
+  });
+  return out;
+}
+
+export async function askHumanTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(
+    questionToolSchema,
+    raw,
+    'send { task_ref, question, options, recommendation, why_it_matters, impact_per_option } — one impact per option',
+  );
+  const projectId = await projectForTask(db, actor, String(tool.task_ref), tool.project_ref as string | undefined);
+  const payload = questionPayload(tool);
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const row = await askHuman(tx, ledgerActor(actor, projectId, 'ledger_ask_human'), payload);
+    await auditIn(tx, actor, 'exec.question.ask', 'exec_question', row.id, {
+      task: row.task_code,
+      code: row.code,
+      blocking: row.blocking,
+    });
+    out = row;
+  });
+  return out;
+}
+
+/** The policy the operator configured, or the plan's default table. */
+async function effectivePolicy(db: Db, orgId: string, projectId: string): Promise<ExecPolicy> {
+  const eff = await getEffective(db, 'exec.policy', orgId, projectId);
+  return (eff?.value as ExecPolicy | undefined) ?? EXEC_POLICY_DEFAULT;
+}
+
+/** The ledger payload is strict: rebuild it from the known keys. */
+function decisionPayload(tool: Record<string, unknown>): Record<string, unknown> {
+  return {
+    task_ref: tool.task_ref,
+    title: tool.title,
+    context: tool.context,
+    options: tool.options,
+    selected: tool.selected,
+    rationale: tool.rationale,
+    reversible: tool.reversible,
+    touches: tool.touches,
+    review_trigger: tool.review_trigger,
+  };
+}
+
+function questionPayload(tool: Record<string, unknown>): Record<string, unknown> {
+  return {
+    task_ref: tool.task_ref,
+    question: tool.question,
+    options: tool.options,
+    recommendation: tool.recommendation,
+    impact_per_option: tool.impact_per_option,
+    why_it_matters: tool.why_it_matters,
+    blocking: tool.blocking,
+    kind: tool.kind,
+  };
+}
diff --git a/apps/api/src/modules/exec/evidence-tools.ts b/apps/api/src/modules/exec/evidence-tools.ts
new file mode 100644
index 0000000..ea55de9
--- /dev/null
+++ b/apps/api/src/modules/exec/evidence-tools.ts
@@ -0,0 +1,82 @@
+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { evidenceObjectSchema, evidenceRefinement } from '@forgepm/shared';
+import { addEvidence, loadEvidenceDeps, unitOfWork, type Db, type EvidenceFsLike } from '@forgepm/core';
+import type { Actor } from '../../app/auth-context';
+import { auditIn, ledgerActor, parseTool, projectForTask, projectRefSchema } from './context';
+
+/**
+ * `ledger_add_evidence` (plan §9.1, acceptance B.10/B.16).
+ *
+ * "A claim without proof is forbidden" is a write-time rule, so the tool
+ * READS what it is asked to record: a path that does not exist is refused
+ * (`EVIDENCE_UNAVAILABLE`), a path outside `exec.allowed_repo_roots` is a
+ * scope violation, and a test log without a result line is a paraphrase. The
+ * service does the reading; this file only says WHERE the bytes come from.
+ */
+
+/** The tool's own shape: the shared payload plus the API-level project. */
+export const evidenceToolSchema = evidenceObjectSchema
+  .extend({
+    project_ref: projectRefSchema.optional(),
+  })
+  .superRefine(evidenceRefinement);
+
+/**
+ * The server's own disk, relative to the working directory the operator runs
+ * the API from. The roots in `exec.allowed_repo_roots` are relative paths, and
+ * `underRoot` (in the core) refuses absolute paths and `..` — so a ref can
+ * only name a file under a root the operator opened on purpose.
+ */
+export const repoFs: EvidenceFsLike = {
+  exists: (path) => existsSync(resolve(process.cwd(), path)),
+  read: (path) => {
+    try {
+      return readFileSync(resolve(process.cwd(), path), 'utf8');
+    } catch {
+      return null;
+    }
+  },
+};
+
+export async function addEvidenceTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<{
+    task_ref: string;
+    criterion_ref?: string;
+    kind: 'test_output' | 'diff' | 'file' | 'command_output' | 'manual_check';
+    ref: string;
+    summary: string;
+    payload?: string;
+    project_ref?: string;
+  }>(
+    evidenceToolSchema,
+    raw,
+    'send { task_ref, kind, ref, summary } — ref is a pointer an auditor can read, summary says what was observed',
+  );
+  const projectId = await projectForTask(db, actor, tool.task_ref, tool.project_ref);
+  const deps = await loadEvidenceDeps(db, actor.organizationId, projectId, repoFs);
+  // `project_ref` is an API-level field: the ledger payload is strict, so it
+  // is rebuilt here from the known keys rather than spread through.
+  const payload = {
+    task_ref: tool.task_ref,
+    criterion_ref: tool.criterion_ref,
+    kind: tool.kind,
+    ref: tool.ref,
+    summary: tool.summary,
+    payload: tool.payload,
+  };
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const row = await addEvidence(tx, ledgerActor(actor, projectId, 'ledger_add_evidence'), payload, deps);
+    await auditIn(tx, actor, 'exec.evidence.add', 'exec_evidence', row.id, {
+      task: row.task_code,
+      criterion: row.criterion_code,
+      kind: row.kind,
+      ref: row.ref,
+      verified: row.verified,
+      redacted: row.redacted,
+    });
+    out = row;
+  });
+  return out;
+}
diff --git a/apps/api/src/modules/exec/fact-tools.ts b/apps/api/src/modules/exec/fact-tools.ts
new file mode 100644
index 0000000..6563cd0
--- /dev/null
+++ b/apps/api/src/modules/exec/fact-tools.ts
@@ -0,0 +1,133 @@
+import { z } from 'zod';
+import {
+  AppError,
+  factInputBaseSchema,
+  factInputRefinement,
+  factPromotionInputSchema,
+  factQueryInputSchema,
+  factVerifyInputSchema,
+} from '@forgepm/shared';
+import {
+  applyFactVerification,
+  prepareFactVerification,
+  promoteFact,
+  queryFacts,
+  recordFact,
+  resolveExecReviewSource,
+  unitOfWork,
+  type Db,
+} from '@forgepm/core';
+import type { Actor } from '../../app/auth-context';
+import { auditIn, ledgerActor, parseTool, projectRefSchema, resolveProject } from './context';
+
+export const factRecordToolSchema = factInputBaseSchema
+  .extend({ project_ref: projectRefSchema.optional() })
+  .superRefine(factInputRefinement);
+
+export const factQueryToolSchema = factQueryInputSchema.extend({ project_ref: projectRefSchema.optional() });
+export const factVerifyToolSchema = factVerifyInputSchema.extend({ project_ref: projectRefSchema.optional() });
+export const factPromoteToolSchema = factPromotionInputSchema.extend({
+  fact_ref: z.string().min(1).max(64),
+  project_ref: projectRefSchema.optional(),
+});
+
+export async function factRecordTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(
+    factRecordToolSchema,
+    raw,
+    'send { key, value, kind, source, source_ref?, files?, project_ref? }; source files are checked and hashed by ForgePM',
+  );
+  const projectId = await resolveProject(db, actor, tool.project_ref as string | undefined, 'project:write');
+  const payload = { ...tool };
+  delete payload.project_ref;
+  const ledger = ledgerActor(actor, projectId, 'fact_record');
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const row = await recordFact(tx, ledger, payload, resolveExecReviewSource());
+    await auditIn(tx, actor, 'exec.fact.record', 'exec_fact', row.id, {
+      code: row.code,
+      key: row.key,
+      kind: row.kind,
+      source: row.source,
+      source_ref: row.source_ref,
+      files: row.files,
+      superseded: row.superseded,
+    });
+    out = row;
+  });
+  return out;
+}
+
+export async function factQueryTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(factQueryToolSchema, raw, 'send { query?, limit?, include_superseded?, project_ref? }');
+  const projectId = await resolveProject(db, actor, tool.project_ref as string | undefined, 'project:read');
+  const query = { ...tool };
+  delete query.project_ref;
+  return queryFacts(db, { organizationId: actor.organizationId, projectId }, query);
+}
+
+export async function factVerifyTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(
+    factVerifyToolSchema,
+    raw,
+    'send { fact_ref, project_ref? }; ForgePM re-reads every referenced file and compares its stored hash',
+  );
+  const projectId = await resolveProject(db, actor, tool.project_ref as string | undefined, 'project:write');
+  const ledger = ledgerActor(actor, projectId, 'fact_verify');
+  const source = resolveExecReviewSource();
+  const prepared = await prepareFactVerification(db, ledger, source, String(tool.fact_ref));
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const result = await applyFactVerification(tx, ledger, prepared);
+    for (const change of result.changes) {
+      await auditIn(tx, actor, change.to === 'stale' ? 'exec.fact.stale' : 'exec.fact.verify', 'exec_fact', change.id, {
+        code: change.code,
+        from: change.from,
+        to: change.to,
+        changed_files: change.changed_files,
+        warning: change.warning,
+      });
+    }
+    out = {
+      fact_ref: tool.fact_ref,
+      checked: result.checked,
+      ...(result.changes[0] ?? { status: 'active', changed_files: [] }),
+      ...(prepared.unavailable_reason ? { warning: prepared.unavailable_reason } : {}),
+    };
+  });
+  return out;
+}
+
+export async function factPromoteTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(
+    factPromoteToolSchema,
+    raw,
+    'send { fact_ref, reason, source?, source_ref? }; only a human may confirm a guess as fact',
+  );
+  if (actor.type === 'agent') {
+    throw new AppError('FORBIDDEN', 'only a human may promote an assumption into a project fact', {
+      needed_action: 'ask the human; an agent must not turn its own guess into project truth',
+    });
+  }
+  const projectId = await resolveProject(db, actor, tool.project_ref as string | undefined, 'project:write');
+  const ledger = ledgerActor(actor, projectId, 'fact_promote');
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const row = await promoteFact(
+      tx,
+      ledger,
+      String(tool.fact_ref),
+      { source: tool.source as string | undefined, source_ref: tool.source_ref as string | undefined, reason: String(tool.reason) },
+      resolveExecReviewSource(),
+    );
+    const fact = await tx
+      .selectFrom('exec_facts')
+      .select('id')
+      .where('project_id', '=', projectId)
+      .where('code', '=', row.code)
+      .executeTakeFirstOrThrow();
+    await auditIn(tx, actor, 'exec.fact.promote', 'exec_fact', fact.id, { code: row.code, source: row.source });
+    out = row;
+  });
+  return out;
+}
diff --git a/apps/api/src/modules/exec/journal-tools.ts b/apps/api/src/modules/exec/journal-tools.ts
new file mode 100644
index 0000000..5845182
--- /dev/null
+++ b/apps/api/src/modules/exec/journal-tools.ts
@@ -0,0 +1,141 @@
+import { sql } from 'kysely';
+import { AppError, execLedgerReconcileInputSchema, journalDoneInputSchema, journalFailInputSchema, journalStartInputSchema } from '@forgepm/shared';
+import {
+  appendEvent,
+  reconcileLedger,
+  resolveExecReviewSource,
+  settleJournalAction,
+  startJournalAction,
+  unitOfWork,
+  type Db,
+} from '@forgepm/core';
+import type { Actor } from '../../app/auth-context';
+import { auditIn, ledgerActor, parseTool, projectForTask, projectRefSchema, resolveProject } from './context';
+
+export const journalStartToolSchema = journalStartInputSchema.extend({ project_ref: projectRefSchema.optional() });
+export const journalDoneToolSchema = journalDoneInputSchema.extend({ project_ref: projectRefSchema.optional() });
+export const journalFailToolSchema = journalFailInputSchema.extend({ project_ref: projectRefSchema.optional() });
+export const execLedgerReconcileToolSchema = execLedgerReconcileInputSchema.extend({ project_ref: projectRefSchema.optional() });
+
+export async function journalStartTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(
+    journalStartToolSchema,
+    raw,
+    'send { task_ref, action, target?, idempotent, expected_effect } before performing the external action',
+  );
+  const projectId = await projectForTask(db, actor, String(tool.task_ref), tool.project_ref as string | undefined);
+  const source = resolveExecReviewSource();
+  if (!source?.captureJournalPreState) {
+    throw new AppError('REVIEW_INPUT_UNAVAILABLE', 'REVIEW_INPUT_UNAVAILABLE: the server cannot capture the Git pre-state for this journal action', {
+      needed_action: 'restore the configured read-only Git source before starting the action; do not provide a caller-authored pre_state_ref',
+    });
+  }
+  const preStateRef = await source.captureJournalPreState();
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const ledger = ledgerActor(actor, projectId, 'journal_start');
+    const row = await startJournalAction(tx, ledger, {
+      task_ref: String(tool.task_ref),
+      action: String(tool.action),
+      target: typeof tool.target === 'string' ? tool.target : undefined,
+      idempotent: Boolean(tool.idempotent),
+      expected_effect: String(tool.expected_effect),
+    }, preStateRef);
+    await auditIn(tx, actor, 'exec.journal.start', 'exec_action_journal', row.id, {
+      task: row.task_code,
+      code: row.code,
+      action: row.action,
+      idempotent: row.idempotent,
+      retry_of: row.retry_of ?? [],
+    });
+    out = row;
+  });
+  return out;
+}
+
+export async function journalDoneTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(journalDoneToolSchema, raw, 'send { journal_ref, result_ref?, note?, project_ref? } after verifying the action completed');
+  const projectId = await projectForJournal(db, actor, String(tool.journal_ref), tool.project_ref as string | undefined);
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const ledger = ledgerActor(actor, projectId, 'journal_done');
+    const row = await settleJournalAction(tx, ledger, {
+      journal_ref: String(tool.journal_ref),
+      result_ref: typeof tool.result_ref === 'string' ? tool.result_ref : undefined,
+      note: typeof tool.note === 'string' ? tool.note : undefined,
+    }, 'done');
+    await auditIn(tx, actor, 'exec.journal.done', 'exec_action_journal', row.id, {
+      task: row.task_code,
+      code: row.code,
+      result_ref: row.result_ref ?? null,
+    });
+    out = row;
+  });
+  return out;
+}
+
+export async function journalFailTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(journalFailToolSchema, raw, 'send { journal_ref, note, result_ref?, project_ref? } to record the verified failure');
+  const projectId = await projectForJournal(db, actor, String(tool.journal_ref), tool.project_ref as string | undefined);
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const ledger = ledgerActor(actor, projectId, 'journal_fail');
+    const row = await settleJournalAction(tx, ledger, {
+      journal_ref: String(tool.journal_ref),
+      result_ref: typeof tool.result_ref === 'string' ? tool.result_ref : undefined,
+      note: String(tool.note),
+    }, 'failed');
+    await auditIn(tx, actor, 'exec.journal.fail', 'exec_action_journal', row.id, {
+      task: row.task_code,
+      code: row.code,
+      result_ref: row.result_ref ?? null,
+      note: row.note,
+    });
+    out = row;
+  });
+  return out;
+}
+
+export async function execLedgerReconcileTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(execLedgerReconcileToolSchema, raw, 'send {} or { project_ref }');
+  const projectId = await resolveProject(db, actor, tool.project_ref as string | undefined, 'project:read');
+  const ledger = ledgerActor(actor, projectId, 'exec_ledger_reconcile');
+  const result = await reconcileLedger(db, ledger);
+  await unitOfWork(db, async ({ tx }) => {
+    await appendEvent(tx, {
+      organization_id: actor.organizationId,
+      task_id: null,
+      entity: 'project',
+      entity_id: projectId,
+      action: 'ledger.reconciled',
+      actor_type: ledger.actorType,
+      actor_id: ledger.actorId,
+      tool: 'exec_ledger_reconcile',
+      payload: { counts: result.counts, truncated: result.truncated },
+    });
+    await auditIn(tx, actor, 'exec.ledger.reconcile', 'project', projectId, {
+      counts: result.counts,
+      truncated: result.truncated,
+    });
+  });
+  return result;
+}
+
+async function projectForJournal(db: Db, actor: Actor, journalRef: string, explicit?: string): Promise<string> {
+  if (explicit) return resolveProject(db, actor, explicit, 'project:write');
+  const rows = await sql<{ project_id: string }>`
+    SELECT DISTINCT t.project_id::text AS project_id
+    FROM exec_action_journal j JOIN exec_tasks t ON t.id = j.task_id
+    WHERE t.organization_id = ${actor.organizationId}::uuid
+      AND (j.code = ${journalRef} OR j.id::text = ${journalRef})
+      ${actor.projectIds ? sql`AND t.project_id = ANY(${actor.projectIds}::uuid[])` : sql``}
+  `.execute(db as never);
+  const projects = [...new Set(rows.rows.map((row) => row.project_id))];
+  if (!projects.length) throw new AppError('NOT_FOUND', `no journal action '${journalRef}' you may access`, { ref: journalRef });
+  if (projects.length > 1) {
+    throw new AppError('VALIDATION_ERROR', `'${journalRef}' names journal actions in ${projects.length} projects`, {
+      needed_action: 'pass project_ref to select one project',
+    });
+  }
+  return projects[0]!;
+}
