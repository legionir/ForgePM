+import { sql } from 'kysely';
+import { z } from 'zod';
+import { AppError, idOrCodeSchema } from '@forgepm/shared';
+import { loadGateContext, type Db } from '@forgepm/core';
+import type { Actor } from '../../app/auth-context';
+import { projectForTask, projectRefSchema } from './context';
+
+export const scopeCheckInputSchema = z.strictObject({
+  task_ref: idOrCodeSchema,
+  project_ref: projectRefSchema.optional(),
+});
+
+const MAX_RETURNED_PATHS = 200;
+
+/**
+ * Read-only scope measurement. The gate and tool share loadGateContext, which
+ * obtains changed paths from the configured Git adapter; exit-report claims
+ * are intentionally not exposed as measurement input.
+ */
+export async function scopeCheck(db: Db, actor: Actor, raw: unknown): Promise<Record<string, unknown>> {
+  const args = scopeCheckInputSchema.parse(raw ?? {});
+  const projectId = await projectForTask(db, actor, args.task_ref, args.project_ref);
+  const found = await sql<{ id: string; code: string; start_ref: string | null; allowed_paths: unknown }>`
+    SELECT id::text AS id, code, start_ref, allowed_paths
+    FROM exec_tasks
+    WHERE organization_id = ${actor.organizationId} AND project_id = ${projectId}
+      AND (code = ${args.task_ref} OR id::text = ${args.task_ref})
+    LIMIT 1
+  `.execute(db as never);
+  const task = found.rows[0];
+  if (!task) throw new AppError('NOT_FOUND', `task '${args.task_ref}' not found in this project`, { ref: args.task_ref });
+
+  const { ctx } = await loadGateContext(db, task.id);
+  const files = ctx.scope.files;
+  const outside = files.filter((file) => !file.in_allowed_paths && !file.transient);
+  const deleted = files.filter((file) => file.deleted);
+  return {
+    task_id: task.id,
+    task_code: task.code,
+    measurable: ctx.scope.available,
+    basis: ctx.scope.basis,
+    start_ref: task.start_ref,
+    allowed_paths: Array.isArray(task.allowed_paths) ? task.allowed_paths : [],
+    touched: files.length,
+    outside_count: outside.length,
+    deleted_count: deleted.length,
+    needs_human: (!ctx.scope.available && !ctx.scope.human_waived) || outside.length > 0 || deleted.length > 0,
+    human_waived: ctx.scope.human_waived,
+    manifest_hash: ctx.scope.basis === 'manifest' ? ctx.scope.tree_hash : null,
+    unavailable_reason: ctx.scope.unavailable_reason,
+    outside: outside.slice(0, MAX_RETURNED_PATHS).map((file) => ({ path: file.path, change: file.change })),
+    deleted: deleted.slice(0, MAX_RETURNED_PATHS).map((file) => ({ path: file.path, change: file.change })),
+    files: files.slice(0, MAX_RETURNED_PATHS).map((file) => ({
+      path: file.path,
+      change: file.change,
+      in_allowed_paths: file.in_allowed_paths,
+      deleted: file.deleted,
+    })),
+    truncated: files.length > MAX_RETURNED_PATHS,
+    report_changed_files_used: false,
+  };
+}
diff --git a/apps/api/src/modules/exec/service.ts b/apps/api/src/modules/exec/service.ts
new file mode 100644
index 0000000..44aea22
--- /dev/null
+++ b/apps/api/src/modules/exec/service.ts
@@ -0,0 +1,241 @@
+import { sql } from 'kysely';
+import { z } from 'zod';
+import { AppError, idOrCodeSchema, openItemInputSchema, resolveItemInputSchema } from '@forgepm/shared';
+import {
+  abandonIdempotency,
+  beginIdempotency,
+  assertRequirementsAssigned,
+  checkCriteria,
+  createOpenItem,
+  createTask,
+  listTaskItems,
+  loadLedgerStatus,
+  parseTaskStart,
+  resolveOpenItem,
+  resolveExecReviewSource,
+  storeIdempotencyResult,
+  unitOfWork,
+  type Db,
+  type ScopeFileManifest,
+} from '@forgepm/core';
+import type { Actor } from '../../app/auth-context';
+import { allocateNumber, ensureWorkflow } from '../work-items/states';
+import { insertWorkItem } from '../work-items/items-repository';
+import { gateAgentOperation } from '../work-items/service';
+import { auditIn, ledgerActor, parseTool, projectForTask, projectRefSchema, resolveProject } from './context';
+
+/**
+ * The service behind PE-2's five ledger tools (plan §7). Thin on purpose: every ledger
+ * rule lives in `@forgepm/core/src/exec`, so the tool, a future REST route and
+ * `scripts/ledger-cli.ts` cannot drift apart. What this file owns is the specifically
+ * *api* part — which project the caller means, whether an agent write needs the
+ * approval gate first, the audit row, and the idempotency claim.
+ */
+
+// ---- tool input shapes (B.1) — strict, and the ledger laws are NOT restated here ----
+
+export const openItemToolSchema = openItemInputSchema.extend({
+  task_ref: idOrCodeSchema,
+  project_ref: projectRefSchema.optional(),
+});
+export const resolveToolSchema = resolveItemInputSchema.extend({
+  task_ref: idOrCodeSchema,
+  project_ref: projectRefSchema.optional(),
+});
+export const listToolSchema = z.strictObject({
+  task_ref: idOrCodeSchema,
+  active_only: z.boolean().default(true),
+  project_ref: projectRefSchema.optional(),
+});
+export const statusToolSchema = z.strictObject({
+  task_ref: idOrCodeSchema.optional(),
+  project_ref: projectRefSchema.optional(),
+});
+
+export interface TaskStartOutcome {
+  pending?: true;
+  approval_request_id?: string;
+  task_id?: string;
+  code?: string;
+  replayed?: boolean;
+  [key: string]: unknown;
+}
+
+/**
+ * `exec_task_start` — work item + ledger task + criteria + audit + event in ONE
+ * transaction (B.4). When the approval policy says an agent may not create this work
+ * item unsupervised, **nothing** is written: the ledger must not record work that has
+ * not been allowed, so the gate is consulted before the transaction opens.
+ */
+export async function startTask(db: Db, actor: Actor, raw: unknown): Promise<TaskStartOutcome> {
+  const parsed = parseTaskStart(raw ?? {});
+  if (!parsed.ok) {
+    throw new AppError('VALIDATION_ERROR', parsed.message, { needed_action: parsed.needed_action });
+  }
+  // Law before gate: a payload that cannot be executed must not cost a human an
+  // approval request. `createTask` checks again — defence in depth, not a second rule.
+  const laws = checkCriteria(parsed.value.criteria);
+  if (!laws.ok) {
+    throw new AppError('CRITERION_NOT_CHECKABLE', laws.message, {
+      needed_action: laws.needed_action,
+      examples: laws.examples,
+      criteria: laws.bad,
+    });
+  }
+  const projectId = await resolveProject(db, actor, parsed.value.projectRef, 'project:write');
+  await assertRequirementsAssigned(db, { organizationId: actor.organizationId, projectId }, parsed.value.reqIds);
+  const gate = await gateAgentOperation(db, actor, projectId, 'work_item.create', {
+    item_type: 'task',
+    priority: 'none',
+  });
+  if (gate) return { ...gate };
+
+  const key = parsed.value.idempotencyKey;
+  if (key) {
+    const begin = await beginIdempotency(db, actor.id, 'exec_task_start', key, raw);
+    if (begin.kind === 'replay') return { ...(begin.response as object), replayed: true };
+  }
+
+  // Capture the commit or a hash-only workspace manifest from the API's
+  // read-only source. Either value is server-measured; no agent claim is used.
+  let startRef: string | null = null;
+  let startManifest: ScopeFileManifest | null = null;
+  const reviewSource = resolveExecReviewSource();
+  try {
+    const measured = (await reviewSource?.headSha?.()) ?? null;
+    startRef = typeof measured === 'string' && /^[0-9a-f]{40,64}$/i.test(measured) ? measured.toLowerCase() : null;
+  } catch {
+    startRef = null;
+  }
+  if (!startRef && reviewSource?.fileManifest) {
+    try {
+      startManifest = await reviewSource.fileManifest();
+    } catch {
+      startManifest = null;
+    }
+  }
+
+  let created: TaskStartOutcome = {};
+  try {
+    await unitOfWork(db, async ({ tx }) => {
+      await assertRequirementsAssigned(tx, { organizationId: actor.organizationId, projectId }, parsed.value.reqIds);
+      const states = await ensureWorkflow(tx as never, projectId, actor.organizationId);
+      const first = states.slice().sort((a, b) => Number(a.position) - Number(b.position))[0];
+      if (!first) throw new AppError('INTERNAL', 'project has no workflow states after ensureWorkflow');
+      const number = await allocateNumber(tx as never, projectId);
+      const workItemId = await insertWorkItem(
+        tx as never,
+        {
+          organization_id: actor.organizationId,
+          project_id: projectId,
+          type: 'task',
+          title: parsed.value.title,
+          description: parsed.value.description,
+          state_id: first.id,
+          acceptance_criteria: parsed.value.criteria,
+          // `work_items.source` is a closed CHECK list ('manual','planner','…'):
+          // 'exec_ledger' would need a migration, and provenance is not what PE-2 was
+          // asked to add. The ledger side of the same task carries the real story.
+          source: 'manual',
+          number,
+        } as never,
+      );
+      const row = await createTask(tx, ledgerActor(actor, projectId, 'exec_task_start'), workItemId, raw, { startRef, startManifest });
+      await auditIn(tx, actor, 'exec.task_start', 'exec_task', row.task_id, {
+        code: row.code,
+        work_item_id: row.work_item_id,
+        criteria: row.criterion_codes,
+        req_ids: row.req_ids,
+        allowed_paths: row.allowed_paths,
+      });
+      created = { ...row };
+      if (key) await storeIdempotencyResult(tx, actor.id, 'exec_task_start', key, created, 200);
+    });
+  } catch (err) {
+    if (key) await abandonIdempotency(db, actor.id, 'exec_task_start', key);
+    throw err;
+  }
+  return created;
+}
+
+/** `ledger_add_open_item` — the filing law (defaults, dedup, blocking reason) is the service's. */
+export async function addOpenItem(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<z.infer<typeof openItemToolSchema>>(
+    openItemToolSchema,
+    raw,
+    'send { task_ref, title, type } — title ≥ 5 chars, type from the ledger enum',
+  );
+  const projectId = await projectForTask(db, actor, tool.task_ref, tool.project_ref);
+  const { task_ref: _taskRef, project_ref: _projectRef, ...item } = tool;
+  void _taskRef;
+  void _projectRef;
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const row = await createOpenItem(tx, ledgerActor(actor, projectId, 'ledger_add_open_item'), tool.task_ref, item);
+    await auditIn(tx, actor, 'exec.open_item.add', 'exec_open_item', row.id, {
+      code: row.code,
+      task: row.task_id,
+      type: row.type,
+      blocks_completion: row.blocks_completion,
+    });
+    out = row;
+  });
+  return out;
+}
+
+/** `ledger_resolve_item` — an agent may not soft-close a blocking item (A.3, tool shape). */
+export async function resolveItem(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<z.infer<typeof resolveToolSchema>>(
+    resolveToolSchema,
+    raw,
+    'send { task_ref, item_ref, status, note } — note ≥ 20 chars',
+  );
+  const projectId = await projectForTask(db, actor, tool.task_ref, tool.project_ref);
+  let out: unknown;
+  await unitOfWork(db, async ({ tx }) => {
+    const row = await resolveOpenItem(tx, ledgerActor(actor, projectId, 'ledger_resolve_item'), tool.task_ref, {
+      item_ref: tool.item_ref,
+      status: tool.status,
+      note: tool.note,
+    });
+    await auditIn(tx, actor, 'exec.open_item.resolve', 'exec_open_item', row.id, {
+      code: row.code,
+      status: row.status,
+      by: row.resolved_by,
+    });
+    out = row;
+  });
+  return out;
+}
+
+/** `ledger_list_open` — active first, then history (the order the panel will reuse). */
+export async function listOpen(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<z.infer<typeof listToolSchema>>(
+    listToolSchema,
+    raw,
+    'send { task_ref } (T-NNN or the task id)',
+  );
+  const projectId = await projectForTask(db, actor, tool.task_ref, tool.project_ref);
+  const found = await sql<{ id: string; code: string }>`
+    SELECT id::text AS id, code FROM exec_tasks
+    WHERE organization_id = ${actor.organizationId} AND project_id = ${projectId}
+      AND (code = ${tool.task_ref} OR id::text = ${tool.task_ref})
+  `.execute(db as never);
+  const task = found.rows[0];
+  if (!task) throw new AppError('NOT_FOUND', `no ledger task '${tool.task_ref}' in this project`);
+  const items = await listTaskItems(db, task.id, { activeOnly: tool.active_only });
+  return { task_ref: task.code, count: items.length, items };
+}
+
+/** `exec_ledger_status` (B.5, and the tool half of A.1) — the shared projection over real rows. */
+export async function ledgerStatus(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<z.infer<typeof statusToolSchema>>(
+    statusToolSchema,
+    raw,
+    'send {} , { project_ref } or { task_ref }',
+  );
+  const projectId = tool.task_ref
+    ? await projectForTask(db, actor, tool.task_ref, tool.project_ref)
+    : await resolveProject(db, actor, tool.project_ref, 'project:read');
+  return loadLedgerStatus(db, { organizationId: actor.organizationId, projectId }, tool.task_ref);
+}
diff --git a/apps/api/src/modules/exec/session-tools.ts b/apps/api/src/modules/exec/session-tools.ts
new file mode 100644
index 0000000..a81e417
--- /dev/null
+++ b/apps/api/src/modules/exec/session-tools.ts
@@ -0,0 +1,252 @@
+import { sql } from 'kysely';
+import { z } from 'zod';
+import {
+  appendEvent,
+  getEffective,
+  MCP_MAX_OUTPUT_BYTES,
+  packSession,
+  requirementCoverage,
+  resolveExecReviewSource,
+  SYSTEM_ACTOR_ID,
+  applyFactVerification,
+  prepareFactVerification,
+  unitOfWork,
+  type Db,
+  type LedgerActor,
+  type SessionSection,
+} from '@forgepm/core';
+import { sessionStartInputSchema } from '@forgepm/shared';
+import type { Actor } from '../../app/auth-context';
+import { auditIn, ledgerActor, parseTool, projectRefSchema, resolveProject } from './context';
+
+export const sessionStartToolSchema = sessionStartInputSchema.extend({
+  project_ref: projectRefSchema.optional(),
+  since: z.string().datetime().optional(),
+});
+
+const RECENT_UNBLOCK_LIMIT = 10;
+const MAX_SESSION_ROWS = 2_000;
+
+type SessionItem = Record<string, unknown>;
+
+export async function sessionStartTool(db: Db, actor: Actor, raw: unknown): Promise<unknown> {
+  const tool = parseTool<Record<string, unknown>>(sessionStartToolSchema, raw, 'send {} or { project_ref, since }');
+  const projectId = await resolveProject(db, actor, tool.project_ref as string | undefined, 'project:read');
+  const configuredLimit = await getEffective(db, 'exec.session_output_max_bytes', actor.organizationId, projectId);
+  const configuredMaxBytes =
+    typeof configuredLimit?.value === 'number' && Number.isInteger(configuredLimit.value)
+      ? configuredLimit.value
+      : 8192;
+  // MCP's outer JSON envelope has a lower hard cap. Stay below it so the
+  // dispatcher never replaces a valid SessionSnapshot with a text preview.
+  const maxBytes = Math.min(configuredMaxBytes, MCP_MAX_OUTPUT_BYTES - 512);
+  const since = typeof tool.since === 'string' ? tool.since : null;
+  const staleSetting = await getEffective(db, 'exec.stale_check_on_start', actor.organizationId, projectId);
+  const staleCheckEnabled = staleSetting?.value !== false;
+  const factActor: LedgerActor = {
+    organizationId: actor.organizationId,
+    projectId,
+    actorType: 'system',
+    actorId: SYSTEM_ACTOR_ID,
+    tool: 'session_start',
+  };
+  const factPreparation = staleCheckEnabled
+    ? await prepareFactVerification(db, factActor, resolveExecReviewSource())
+    : null;
+  let output: unknown;
+
+  await unitOfWork(db, async ({ tx }) => {
+    const ledger = ledgerActor(actor, projectId, 'session_start');
+    if (factPreparation) {
+      const verified = await applyFactVerification(tx, factActor, factPreparation);
+      for (const change of verified.changes) {
+        if (change.to !== 'stale' || change.from !== 'active') continue;
+        await auditIn(tx, actor, 'exec.fact.stale', 'exec_fact', change.id, {
+          code: change.code,
+          changed_files: change.changed_files,
+          warning: change.warning,
+          trigger: 'session_start',
+        });
+      }
+    }
+    const interrupted = await sql<{
+      id: string;
+      code: string;
+      task_id: string;
+      task_code: string;
+      action: string;
+    }>`
+      SELECT j.id::text AS id, j.code, j.task_id::text AS task_id, t.code AS task_code, j.action
+      FROM exec_action_journal j JOIN exec_tasks t ON t.id = j.task_id
+      WHERE t.organization_id = ${actor.organizationId}::uuid
+        AND t.project_id = ${projectId}::uuid AND j.status = 'started'
+      ORDER BY j.started_at, j.code
+    `.execute(tx as never);
+    for (const row of interrupted.rows) {
+      await sql`
+        UPDATE exec_action_journal SET status = 'unknown', finished_at = now()
+        WHERE id = ${row.id}::uuid AND status = 'started'
+      `.execute(tx as never);
+      await appendEvent(tx, {
+        organization_id: actor.organizationId,
+        task_id: row.task_id,
+        entity: 'journal',
+        entity_id: row.id,
+        entity_code: row.code,
+        action: 'journal.unknown_after_session_start',
+        actor_type: ledger.actorType,
+        actor_id: ledger.actorId,
+        tool: 'session_start',
+        payload: { task: row.task_code, action: row.action, previous_status: 'started', status: 'unknown' },
+      });
+      await auditIn(tx, actor, 'exec.journal.mark_unknown', 'exec_action_journal', row.id, {
+        task: row.task_code,
+        code: row.code,
+        action: row.action,
+        reason: 'session_start recovery',
+      });
+    }
+
+    const [coverage, questions, approvals, journals, openItems, facts, revisits, tasks, events] = await Promise.all([
+      requirementCoverage(tx, { organizationId: actor.organizationId, projectId }),
+      sql<SessionItem>`
+        SELECT q.code, t.code AS task_code, 'question' AS kind, q.question AS title,
+          q.why_it_matters AS detail, q.created_at::text AS created_at
+        FROM exec_questions q JOIN exec_tasks t ON t.id = q.task_id
+        WHERE q.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${projectId}::uuid
+          AND q.status = 'open' AND q.blocking = true
+        ORDER BY q.created_at, q.code LIMIT ${MAX_SESSION_ROWS}
+      `.execute(tx as never),
+      sql<SessionItem>`
+        SELECT d.code, t.code AS task_code, 'approval' AS kind, d.title,
+          d.rationale AS detail, d.approval_state AS status, d.created_at::text AS created_at
+        FROM exec_decisions d JOIN exec_tasks t ON t.id = d.task_id
+        WHERE d.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${projectId}::uuid
+          AND d.approval_state = 'pending'
+        ORDER BY d.created_at, d.code LIMIT ${MAX_SESSION_ROWS}
+      `.execute(tx as never),
+      sql<SessionItem>`
+        SELECT j.id::text AS id, j.code, t.code AS task_code, j.action, j.target, j.idempotent,
+          j.status, j.expected_effect, j.started_at::text AS started_at
+        FROM exec_action_journal j JOIN exec_tasks t ON t.id = j.task_id
+        WHERE t.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${projectId}::uuid
+          AND j.status IN ('started','unknown')
+        ORDER BY CASE WHEN j.status = 'unknown' THEN 0 ELSE 1 END, j.started_at, j.code
+        LIMIT ${MAX_SESSION_ROWS}
+      `.execute(tx as never),
+      sql<SessionItem>`
+        SELECT i.code, t.code AS task_code, i.title, i.detail, i.type, i.status, i.updated_at::text AS updated_at
+        FROM exec_open_items i JOIN exec_tasks t ON t.id = i.task_id
+        WHERE i.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${projectId}::uuid
+          AND i.blocks_completion = true AND i.status IN ('open','blocked','awaiting_human')
+        ORDER BY CASE WHEN i.status = 'awaiting_human' THEN 0 WHEN i.status = 'blocked' THEN 1 ELSE 2 END,
+          i.created_at, i.code
+        LIMIT ${MAX_SESSION_ROWS}
+      `.execute(tx as never),
+      sql<SessionItem>`
+        SELECT code, key, value, source, files, status, created_at::text AS created_at
+        FROM exec_facts
+        WHERE organization_id = ${actor.organizationId}::uuid AND project_id = ${projectId}::uuid
+          AND status = 'stale'
+        ORDER BY code LIMIT ${MAX_SESSION_ROWS}
+      `.execute(tx as never),
+      sql<SessionItem>`
+        SELECT d.code, t.code AS task_code, d.title, d.rationale, d.review_trigger,
+          d.updated_at::text AS updated_at
+        FROM exec_decisions d JOIN exec_tasks t ON t.id = d.task_id
+        WHERE d.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${projectId}::uuid
+          AND d.status = 'needs_revisit'
+        ORDER BY d.updated_at, d.code LIMIT ${MAX_SESSION_ROWS}
+      `.execute(tx as never),
+      sql<SessionItem>`
+        SELECT id::text AS task_id, code, title, status, blocked_on_kind, blocked_on_ref,
+          blocked_reason, unblock_condition, updated_at::text AS updated_at
+        FROM exec_tasks
+        WHERE organization_id = ${actor.organizationId}::uuid AND project_id = ${projectId}::uuid
+          AND status <> 'done'
+        ORDER BY CASE status WHEN 'in_progress' THEN 0 WHEN 'awaiting_review' THEN 1
+          WHEN 'blocked' THEN 2 ELSE 3 END, code
+        LIMIT ${MAX_SESSION_ROWS}
+      `.execute(tx as never),
+      sql<{
+        task_id: string;
+        task_code: string;
+        created_at: string;
+        reason: string | null;
+        blocker_kind: string | null;
+        blocker_ref: string | null;
+      }>`
+        SELECT e.task_id::text AS task_id, t.code AS task_code, e.created_at::text AS created_at,
+          e.payload->>'reason' AS reason, e.payload->>'blocker_kind' AS blocker_kind,
+          e.payload->>'blocker_ref' AS blocker_ref
+        FROM exec_events e JOIN exec_tasks t ON t.id = e.task_id
+        WHERE e.organization_id = ${actor.organizationId}::uuid AND t.project_id = ${projectId}::uuid
+          AND e.action = 'task.unblocked'
+          ${since ? sql`AND e.created_at >= ${since}::timestamptz` : sql``}
+        ORDER BY e.created_at DESC, e.id DESC LIMIT 50
+      `.execute(tx as never),
+    ]);
+
+    const requirementItems: SessionItem[] = coverage.requirements
+      .filter((requirement) => requirement.status === 'active' && requirement.coverage !== 'covered')
+      .map((requirement) => ({ ...requirement }));
+    const humanPending = [...questions.rows, ...approvals.rows].sort((a, b) =>
+      String(a.created_at ?? '').localeCompare(String(b.created_at ?? '')),
+    );
+    const staleAndRevisited = [...facts.rows, ...revisits.rows].slice(0, MAX_SESSION_ROWS);
+    const sections: SessionSection<SessionItem>[] = [
+      {
+        key: 'human_pending',
+        label: 'Human decisions',
+        items: humanPending,
+        hint: 'read decisions and questions with exec_ledger_status',
+      },
+      {
+        key: 'journal_unknown',
+        label: 'Unsettled actions',
+        items: journals.rows,
+        hint: 'inspect, then use journal_done or journal_fail; reconcile with exec_ledger_reconcile',
+      },
+      {
+        key: 'blocking_open_items',
+        label: 'Blocking items',
+        items: openItems.rows,
+        hint: 'read the rest with ledger_list_open',
+      },
+      {
+        key: 'stale_facts_and_revisits',
+        label: 'Stale facts / revisits',
+        items: staleAndRevisited,
+        hint: 'read fact and decision details with exec_ledger_status',
+      },
+      {
+        key: 'uncovered_requirements',
+        label: 'Uncovered requirements',
+        items: requirementItems,
+        hint: 'read the rest with req_coverage',
+      },
+      {
+        key: 'tasks',
+        label: 'Active tasks',
+        items: tasks.rows,
+        hint: 'read the task tree with exec_plan_view',
+      },
+    ];
+    const unassigned = coverage.unassigned.slice(0, 10);
+    const recent = events.rows.slice(0, RECENT_UNBLOCK_LIMIT);
+    const context: Record<string, unknown> = {
+      project_id: projectId,
+      uncovered_requirements: unassigned,
+      uncovered_requirement_count: coverage.unassigned.length,
+      recently_unblocked: recent,
+      recently_unblocked_limit: RECENT_UNBLOCK_LIMIT,
+      since,
+      ...(coverage.unassigned.length
+        ? { needed_action: 'assign every unassigned active requirement, then link a checkable criterion with req_link_task' }
+        : {}),
+    };
+    output = packSession(sections, { maxBytes, context });
+  });
+
+  return output;
+}
diff --git a/apps/api/src/modules/exec/write-lock.ts b/apps/api/src/modules/exec/write-lock.ts
new file mode 100644
index 0000000..63e8579
--- /dev/null
+++ b/apps/api/src/modules/exec/write-lock.ts
@@ -0,0 +1,154 @@
+import { sql } from 'kysely';
+import { EXEC_POLICY_DEFAULT, classify, getEffective, isJournalLockException, journalWriteLock, throwIfJournalLocked, type Db } from '@forgepm/core';
+import type { ExecPolicy } from '@forgepm/shared';
+import type { Actor } from '../../app/auth-context';
+
+interface LockJournalRow {
+  code: string;
+  task_id: string;
+  action: string;
+  target: string | null;
+  expected_effect: string;
+  idempotent: boolean;
+  status: 'started' | 'unknown';
+}
+
+/**
+ * Dispatch-level enforcement for every agent write to the execution ledger.
+ * The handler cannot be reached while an unresolved action exists, except for
+ * the recovery/read exceptions encoded in the core journal helper.
+ */
+export async function enforceExecWriteLock(
+  db: Db,
+  actor: Actor,
+  tool: string,
+  args: Record<string, unknown>,
+): Promise<void> {
+  if (actor.type !== 'agent' || isJournalLockException(tool)) return;
+  const projectIds = await targetProjects(db, actor, args);
+  if (!projectIds.length) return;
+
+  const openResult = await sql<LockJournalRow>`
+    SELECT j.code, j.task_id::text AS task_id, j.action, j.target, j.expected_effect, j.idempotent, j.status
+    FROM exec_action_journal j JOIN exec_tasks t ON t.id = j.task_id
+    WHERE t.organization_id = ${actor.organizationId}::uuid
+      AND t.project_id = ANY(${projectIds}::uuid[])
+      AND j.status IN ('started','unknown')
+    ORDER BY j.started_at, j.code
+  `.execute(db as never);
+  if (!openResult.rows.length) return;
+
+  let retryIntent: Parameters<typeof journalWriteLock>[0]['retryIntent'];
+  if (tool === 'journal_start') {
+    const taskRef = stringField(args, 'task_ref');
+    const action = stringField(args, 'action');
+    const target = stringField(args, 'target');
+    const expectedEffect = stringField(args, 'expected_effect');
+    const idempotent = args.idempotent === true;
+    if (taskRef && action && expectedEffect) {
+      const task = await sql<{ id: string }>`
+        SELECT id::text AS id FROM exec_tasks
+        WHERE organization_id = ${actor.organizationId}::uuid
+          AND project_id = ANY(${projectIds}::uuid[])
+          AND (id::text = ${taskRef} OR code = ${taskRef})
+        ORDER BY project_id, code LIMIT 2
+      `.execute(db as never);
+      if (task.rows.length === 1) {
+        retryIntent = { task_id: task.rows[0]!.id, action, target: target ?? null, expected_effect: expectedEffect, idempotent };
+      }
+    }
+  }
+
+  const approvalDecision =
+    tool === 'ledger_record_decision' ? await isApprovalDecision(db, actor, args, projectIds) : false;
+  throwIfJournalLocked(
+    journalWriteLock({
+      tool,
+      actorType: 'agent',
+      openRows: openResult.rows,
+      retryIntent,
+      approvalDecision,
+    }),
+  );
+}
+
+async function targetProjects(db: Db, actor: Actor, args: Record<string, unknown>): Promise<string[]> {
+  const explicit = stringField(args, 'project_ref');
+  if (explicit) {
+    const found = await sql<{ id: string }>`
+      SELECT id::text AS id FROM projects
+      WHERE organization_id = ${actor.organizationId}::uuid AND (id::text = ${explicit} OR key = ${explicit})
+        ${actor.projectIds ? sql`AND id = ANY(${actor.projectIds}::uuid[])` : sql``}
+    `.execute(db as never);
+    return found.rows.map((row) => row.id);
+  }
+
+  const taskRefs = ['task_ref', 'parent_ref', 'task_id']
+    .map((key) => stringField(args, key))
+    .filter((value): value is string => value !== null);
+  if (taskRefs.length) {
+    const found = await sql<{ project_id: string }>`
+      SELECT DISTINCT project_id::text AS project_id FROM exec_tasks
+      WHERE organization_id = ${actor.organizationId}::uuid
+        AND (code = ANY(${taskRefs}::text[]) OR id::text = ANY(${taskRefs}::text[]))
+        ${actor.projectIds ? sql`AND project_id = ANY(${actor.projectIds}::uuid[])` : sql``}
+    `.execute(db as never);
+    return found.rows.map((row) => row.project_id);
+  }
+
+  const factRef = stringField(args, 'fact_ref');
+  if (factRef) {
+    const found = await sql<{ project_id: string }>`
+      SELECT DISTINCT project_id::text AS project_id FROM exec_facts
+      WHERE organization_id = ${actor.organizationId}::uuid
+        AND (code = ${factRef} OR id::text = ${factRef})
+        ${actor.projectIds ? sql`AND project_id = ANY(${actor.projectIds}::uuid[])` : sql``}
+    `.execute(db as never);
+    return found.rows.map((row) => row.project_id);
+  }
+
+  const journalRef = stringField(args, 'journal_ref');
+  if (journalRef) {
+    const found = await sql<{ project_id: string }>`
+      SELECT DISTINCT t.project_id::text AS project_id
+      FROM exec_action_journal j JOIN exec_tasks t ON t.id = j.task_id
+      WHERE t.organization_id = ${actor.organizationId}::uuid
+        AND (j.code = ${journalRef} OR j.id::text = ${journalRef})
+        ${actor.projectIds ? sql`AND t.project_id = ANY(${actor.projectIds}::uuid[])` : sql``}
+    `.execute(db as never);
+    return found.rows.map((row) => row.project_id);
+  }
+
+  if (actor.projectIds) return actor.projectIds;
+  const projects = await sql<{ id: string }>`
+    SELECT id::text AS id FROM projects WHERE organization_id = ${actor.organizationId}::uuid
+  `.execute(db as never);
+  return projects.rows.map((row) => row.id);
+}
+
+async function isApprovalDecision(
+  db: Db,
+  actor: Actor,
+  args: Record<string, unknown>,
+  projectIds: string[],
+): Promise<boolean> {
+  const taskRef = stringField(args, 'task_ref');
+  const touches = Array.isArray(args.touches) ? args.touches.filter((value): value is string => typeof value === 'string') : [];
+  if (!taskRef || typeof args.reversible !== 'boolean') return false;
+  const task = await sql<{ project_id: string }>`
+    SELECT DISTINCT project_id::text AS project_id FROM exec_tasks
+    WHERE organization_id = ${actor.organizationId}::uuid
+      AND project_id = ANY(${projectIds}::uuid[])
+      AND (id::text = ${taskRef} OR code = ${taskRef})
+    ORDER BY project_id LIMIT 2
+  `.execute(db as never);
+  if (task.rows.length !== 1) return false;
+  const effective = await getEffective(db, 'exec.policy', actor.organizationId, task.rows[0]!.project_id);
+  const policy = (effective?.value as ExecPolicy | undefined) ?? EXEC_POLICY_DEFAULT;
+  return classify(policy, { touches, reversible: args.reversible }).level === 'approval';
+}
+
+function stringField(value: Record<string, unknown>, key: string): string | null {
+  const field = value[key];
+  return typeof field === 'string' && field.length > 0 ? field : null;
+}
