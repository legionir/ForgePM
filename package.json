{
  "name": "forgepm",
  "version": "1.0.0-rc.1",
  "private": true,
  "bin": {
    "forgepm": "scripts/dev.mjs"
  },
  "description": "ForgePM: self-hosted, AI-native project planning with MCP",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "schema:check": "tsx scripts/schema-check.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "migrate": "tsx scripts/migrate.ts",
    "ledger": "tsx scripts/ledger-cli.ts",
    "policy:print": "tsx scripts/ledger-cli.ts policy print",
    "policy:set": "tsx scripts/ledger-cli.ts policy set",
    "seed": "tsx scripts/seed.ts",
    "gen:api": "tsx scripts/gen-api.ts",
    "gen:api:check": "tsx scripts/gen-api.ts --check",
    "rotate-secret": "tsx scripts/rotate-secret.ts",
    "doctor": "tsx scripts/doctor.ts",
    "start": "node scripts/dev.mjs --dev",
    "dev": "node scripts/dev.mjs --dev",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "exec:e2e": "tsx scripts/exec-e2e.ts",
    "test:e2e": "bash apps/web/e2e.sh",
    "report:phase": "tsx scripts/phase-report.ts",
    "prepare": "husky || true",
    "seed:perf": "tsx scripts/seed-perf.ts",
    "perf": "tsx scripts/perf.ts",
    "test:web": "cd apps/web && npx ng test"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@eslint/js": "9.17.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@vitest/coverage-v8": "3.2.6",
    "autocannon": "8.0.0",
    "eslint": "9.17.0",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "3.2.6"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "apps/api",
    "apps/worker",
    "tests"
  ]
}
