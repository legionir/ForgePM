{
  "name": "forgepm",
  "version": "0.0.0",
  "private": true,
  "description": "ForgePM: self-hosted, AI-native project planning with MCP",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "pnpm -r run build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "schema:check": "tsx scripts/schema-check.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "doctor": "tsx scripts/doctor.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "report:phase": "tsx scripts/phase-report.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "eslint": "9.17.0",    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import": "2.31.0",
    "husky": "9.1.7",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
