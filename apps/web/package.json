{
  "name": "@forgepm/web",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "ForgePM panel \u2014 Angular (standalone + signals) client of the OpenAPI surface",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint .",
    "verify": "npm run lint && npm run check:contrast && npm run check:raw && npm run build",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:raw": "node scripts/raw-value-check.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
