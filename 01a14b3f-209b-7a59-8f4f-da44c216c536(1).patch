+    expect(outside.code).toBe('SCOPE_VIOLATION');
+    const sneaky = checkEvidence({
+      ...base,
+      kind: 'file',
+      ref: 'file:packages/../secrets/id_rsa',
+      summary: 'trying to walk out of the root with a dot-dot',
