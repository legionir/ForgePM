+    expect(
+      checkEvidence({
+        ...base,
+        kind: 'diff',
+        ref: 'file:docs/x.md',
+        summary: 'the diff is right here, promise',
+        payload: '--- a/x\n+++ b/x\n@@ -1 +1 @@\n-old\n+new',
