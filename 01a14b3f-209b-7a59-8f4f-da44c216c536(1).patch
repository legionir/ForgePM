+export const DEFAULT_TEST_PARSER = {
+  pass: ['\\d+\\s+passed', '\\d+ passing', 'Tests\\s+\\d+\\s+passed'],
+  fail: ['\\d+\\s+failed', '\\d+ failing', 'FAILED'],
