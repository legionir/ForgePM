--- /dev/null
+++ b/apps/web/src/app/ui/board-drag.spec.ts
@@ -0,0 +1,266 @@
+// Board drag-and-drop wiring (issue #11, D-046). Two paths, one gesture:
+// native HTML5 DnD (real browsers) and a pointer session (works under
+// headless Chromium, where `dragTo` never starts a drag session). The pure
+// reducer lives in logic.ts; the directives here are thin DOM plumbing, so the
+// phase/threshold/zone rules are tested as units AND through rendered DOM to
+// catch wiring typos a pure test cannot see.
+import { describe, expect, it } from 'vitest';
+import { Component } from '@angular/core';
+import { TestBed } from '@angular/core/testing';
+import {
+  canDragFrom,
+  DRAG_IDLE,
+  DRAG_THRESHOLD_PX,
+  dragDown,
+  dragEnd,
+  dragMove,
+  dragTarget,
+  dragToNative,
+} from './logic';
+import { UiBoard, UiDrop, UiDropZone, UiDragSource } from './board-drag';
+
+/** A pointer event by name: jsdom has no PointerEvent constructor, and the
+ *  handlers only read type/clientX/clientY/target, so MouseEvent is faithful. */
+function pointer(el: Element, type: string, x: number, y: number, extra: Record<string, unknown> = {}): void {
+  const ev = new MouseEvent(type, { bubbles: true, cancelable: true, clientX: x, clientY: y });
+  for (const [k, v] of Object.entries(extra)) Object.defineProperty(ev, k, { value: v, configurable: true });
+  el.dispatchEvent(ev);
+}
+
+describe('board drag reducer', () => {
+  it('refuses to drag from interactive elements so links and buttons keep working', () => {
+    expect(canDragFrom('A')).toBe(false);
+    expect(canDragFrom('button')).toBe(false);
+    expect(canDragFrom('INPUT')).toBe(false);
+    expect(canDragFrom('select')).toBe(false);
+    expect(canDragFrom('summary')).toBe(false);
+    expect(canDragFrom('SPAN')).toBe(true);
+    expect(canDragFrom('ui-badge')).toBe(true);
+    expect(canDragFrom(undefined)).toBe(false);
+  });
+
+  it('press alone is only pending and stamps a fresh gesture token', () => {
+    const s = dragDown(DRAG_IDLE, 'EPRJ-1', 'st-backlog', 100, 50);
+    expect(s).toMatchObject({ phase: 'pending', key: 'EPRJ-1', fromStateId: 'st-backlog', x: 100, y: 50 });
+    expect(s.token).toBe(1);
+    expect(dragDown(s, 'EPRJ-2', 'st-todo', 0, 0).token).toBe(2);
+  });
+
+  it('keeps a jitter inside the threshold a click, and promotes past it', () => {
+    const s = dragDown(DRAG_IDLE, 'K-1', 'a', 100, 50);
+    expect(dragMove(s, 100 + DRAG_THRESHOLD_PX - 1, 50).phase).toBe('pending');
+    expect(dragMove(s, 100, 50 + DRAG_THRESHOLD_PX).phase).toBe('dragging');
+    expect(dragMove(s, 109, 50).phase).toBe('dragging');
+  });
+
+  it('ignores moves outside a gesture without churning the session object', () => {
+    expect(dragMove(DRAG_IDLE, 500, 500)).toBe(DRAG_IDLE);
+    const s = dragMove(dragDown(DRAG_IDLE, 'K-1', 'a', 0, 0), 50, 50);
+    expect(dragMove(s, 51, 51)).toBe(s); // already dragging: coords stay at the press point
+  });
+
+  it('drops only a dragging gesture over a foreign zone', () => {
+    const pending = dragDown(DRAG_IDLE, 'K-1', 'a', 0, 0);
+    expect(dragTarget(pending, 'b')).toBeNull(); // moved too little: it was a click
+    expect(dragTarget(DRAG_IDLE, 'b')).toBeNull();
+    const dragging = dragMove(pending, 40, 40);
+    expect(dragTarget(dragging, null)).toBeNull(); // released over the board, not a column
+    expect(dragTarget(dragging, 'a')).toBeNull(); // same column is not a move
+    expect(dragTarget(dragging, 'b')).toBe('b');
+  });
+
+  it('ends and stands down keeping the token, so a gesture cannot apply twice', () => {
+    const s = dragEnd(dragMove(dragDown(DRAG_IDLE, 'K-1', 'a', 0, 0), 40, 40));
+    expect(s).toEqual({ ...DRAG_IDLE, token: 1 });
+    const n = dragToNative(dragMove(dragDown(DRAG_IDLE, 'K-2', 'a', 0, 0), 40, 40));
+    expect(n.phase).toBe('idle');
+    expect(n.token).toBe(1); // the HTML5 path claims the same token
+    expect(dragTarget(n, 'b')).toBeNull(); // so the pointer path can no longer produce a drop
+  });
+});
+
+@Component({
+  standalone: true,
+  imports: [UiBoard, UiDropZone, UiDragSource],
+  template: `
+    <div class="ui-board" uiBoard (dragDrop)="dropped = $event">
+      @for (st of states; track st) {
+        <div class="ui-board-col" uiDropZone [uiDropZone]="st" (dropped)="dropped = $event">
+          @if (st === from) {
+            <div class="ui-board-card" uiDragSource [uiDragSource]="key" [uiDragFrom]="st" data-testid="board-card">
+              <span class="t">drag me</span>
+              <a href="/x">EPRJ-1</a>
+            </div>
+          }
+        </div>
+      }
+    </div>
+  `,
+})
+class BoardHost {
+  states = ['a', 'b', 'c'];
+  from = 'a';
+  key = 'EPRJ-1';
+  dropped: UiDrop | null = null;
+}
+
+describe('board drag directives', () => {
+  beforeEach(async () => {
+    TestBed.configureTestingModule({ imports: [BoardHost] });
+  });
+
+  it('moves the item through the transition output when the pointer is released on another column', async () => {
+    const f = TestBed.createComponent(BoardHost);
+    f.detectChanges();
+    const el = f.nativeElement as HTMLElement;
+    const card = el.querySelector<HTMLElement>('[data-testid="board-card"]')!;
+    const targetCol = el.querySelectorAll<HTMLElement>('.ui-board-col')[2];
+    expect(targetCol.getAttribute('data-drop-zone')).toBe('c'); // how the board resolves a release point
+
+    pointer(card, 'pointerdown', 10, 10);
+    expect(f.componentInstance.dropped).toBeNull();
+
+    f.detectChanges();
+    expect(card.classList.contains('ui-board-card--drag')).toBe(false); // a press alone is not a drag
+
+    pointer(card, 'pointermove', 20, 20); // crosses the threshold inside the origin column
+    f.detectChanges();
+    expect(card.classList.contains('ui-board-card--drag')).toBe(true); // feedback while dragging
+
+    pointer(targetCol, 'pointermove', 300, 300); // over the third column
+    pointer(targetCol, 'pointerup', 300, 300); // released there -> drop
+    f.detectChanges();
+
+    expect(f.componentInstance.dropped).toEqual({ key: 'EPRJ-1', to: 'c' });
+    expect(card.classList.contains('ui-board-card--drag')).toBe(false);
+  });
+
+  it('treats a press without travel as a click and leaves the gesture alone', async () => {
+    const f = TestBed.createComponent(BoardHost);
+    f.detectChanges();
+    const el = f.nativeElement as HTMLElement;
+    const card = el.querySelector<HTMLElement>('[data-testid="board-card"]')!;
+
+    pointer(card, 'pointerdown', 10, 10);
+    pointer(card, 'pointermove', 12, 11); // 2px: jitter
+    pointer(card, 'pointerup', 12, 11);
+    f.detectChanges();
+
+    expect(f.componentInstance.dropped).toBeNull();
+  });
+
+  it('never starts a drag from the link inside the card', async () => {
+    const f = TestBed.createComponent(BoardHost);
+    f.detectChanges();
+    const el = f.nativeElement as HTMLElement;
+    const link = el.querySelector<HTMLElement>('a')!;
+    const col = el.querySelectorAll<HTMLElement>('.ui-board-col')[1];
+
+    pointer(link, 'pointerdown', 10, 10);
+    pointer(link, 'pointermove', 300, 300);
+    pointer(col, 'pointerup', 300, 300);
+    f.detectChanges();
+
+    expect(f.componentInstance.dropped).toBeNull();
+  });
+
+  it('ignores touch and secondary buttons so their own semantics survive', async () => {
+    const f = TestBed.createComponent(BoardHost);
+    f.detectChanges();
+    const el = f.nativeElement as HTMLElement;
+    const card = el.querySelector<HTMLElement>('[data-testid="board-card"]')!;
+    const col = el.querySelectorAll<HTMLElement>('.ui-board-col')[1];
+
+    pointer(card, 'pointerdown', 10, 10, { pointerType: 'touch' });
+    pointer(card, 'pointermove', 300, 300, { pointerType: 'touch' });
+    pointer(col, 'pointerup', 300, 300, { pointerType: 'touch' });
+    f.detectChanges();
+    expect(f.componentInstance.dropped).toBeNull();
+
+    pointer(card, 'pointerdown', 10, 10, { button: 2 }); // right-click must not drag
+    pointer(card, 'pointermove', 300, 300);
+    pointer(col, 'pointerup', 300, 300);
+    f.detectChanges();
+    expect(f.componentInstance.dropped).toBeNull();
+  });
+
+  it('lets dragstart stand the pointer session down, and cancels on leaving the board', async () => {
+    const f = TestBed.createComponent(BoardHost);
+    f.detectChanges();
+    const el = f.nativeElement as HTMLElement;
+    const card = el.querySelector<HTMLElement>('[data-testid="board-card"]')!;
+    const board = el.querySelector<HTMLElement>('.ui-board')!;
+    const col = el.querySelectorAll<HTMLElement>('.ui-board-col')[1];
+
+    pointer(card, 'pointerdown', 10, 10);
+    pointer(card, 'pointermove', 60, 60);
+    card.dispatchEvent(new Event('dragstart', { bubbles: true })); // native drag took over
+    pointer(col, 'pointerup', 300, 300);
+    expect(f.componentInstance.dropped).toBeNull();
+
+    pointer(card, 'pointerdown', 10, 10);
+    pointer(card, 'pointermove', 60, 60);
+    pointer(board, 'pointerleave', 60, 60); // left the board: gesture is off
+    pointer(board, 'pointerup', 60, 60);
+    f.detectChanges();
+    expect(f.componentInstance.dropped).toBeNull();
+    expect(card.classList.contains('ui-board-card--drag')).toBe(false);
+  });
+
+  it('keeps the HTML5 path working for real browsers: payload drop + dragover accept', async () => {
+    const f = TestBed.createComponent(BoardHost);
+    f.detectChanges();
+    const el = f.nativeElement as HTMLElement;
+    const card = el.querySelector<HTMLElement>('[data-testid="board-card"]')!;
+    const col = el.querySelectorAll<HTMLElement>('.ui-board-col')[1];
+
+    // dragover must be accepted or Chromium refuses the drop before it starts
+    const over = new Event('dragover', { bubbles: true, cancelable: true });
+    col.dispatchEvent(over);
+    expect(over.defaultPrevented).toBe(true);
+
+    card.dispatchEvent(new Event('dragstart', { bubbles: true })); // native drag begins
+    const drop = new Event('drop', { bubbles: true, cancelable: true });
+    Object.defineProperty(drop, 'dataTransfer', {
+      value: { getData: (t: string) => (t === 'text/plain' ? 'EPRJ-1' : '') },
+    });
+    col.dispatchEvent(drop);
+    f.detectChanges();
+    expect(f.componentInstance.dropped).toEqual({ key: 'EPRJ-1', to: 'b' });
+  });
+
+  it('drops nothing when the payload carries no key', async () => {
+    const f = TestBed.createComponent(BoardHost);
+    f.detectChanges();
+    const col = (f.nativeElement as HTMLElement).querySelectorAll<HTMLElement>('.ui-board-col')[1];
+
+    const drop = new Event('drop', { bubbles: true, cancelable: true });
+    Object.defineProperty(drop, 'dataTransfer', { value: { getData: () => '' } });
+    col.dispatchEvent(drop);
+    f.detectChanges();
+    expect(f.componentInstance.dropped).toBeNull();
+  });
+
+  it('applies one gesture at most, however the two paths interleave', async () => {
+    const f = TestBed.createComponent(BoardHost);
+    f.detectChanges();
+    const el = f.nativeElement as HTMLElement;
+    const card = el.querySelector<HTMLElement>('[data-testid="board-card"]')!;
+    const col = el.querySelectorAll<HTMLElement>('.ui-board-col')[1];
+
+    pointer(card, 'pointerdown', 10, 10);
+    pointer(card, 'pointermove', 60, 60);
+    pointer(col, 'pointerup', 300, 300);
+    expect(f.componentInstance.dropped).toEqual({ key: 'EPRJ-1', to: 'b' });
+
+    // Same gesture, second claim (e.g. a stray pointerup after the native drop): no-op.
+    pointer(col, 'pointerup', 300, 300);
+    expect(f.componentInstance.dropped).toEqual({ key: 'EPRJ-1', to: 'b' });
+
+    const drop = new Event('drop', { bubbles: true, cancelable: true });
+    Object.defineProperty(drop, 'dataTransfer', { value: { getData: () => 'EPRJ-1' } });
+    el.querySelectorAll<HTMLElement>('.ui-board-col')[2].dispatchEvent(drop);
+    f.detectChanges();
+    expect(f.componentInstance.dropped).toEqual({ key: 'EPRJ-1', to: 'b' }); // still the first one
+  });
+});
diff --git a/apps/web/src/app/ui/board-drag.ts b/apps/web/src/app/ui/board-drag.ts
new file mode 100644
index 0000000..7c69664
--- /dev/null
+++ b/apps/web/src/app/ui/board-drag.ts
@@ -0,0 +1,169 @@
+// Board drag-and-drop plumbing (issue #11, D-046). The phase rules are pure and
+// unit-tested in logic.ts; these three directives only connect them to the DOM.
+//
+//   [uiBoard]      — the wrapper that sees every pointermove/pointerup of a gesture
+//   [uiDragSource] — a card: press starts (or refuses) a gesture, HTML5 dragstart
+//                    hands the gesture to the browser and stands the pointer down
+//   [uiDropZone]   — a column: the HTML5 drop target, and what a release is over
+//
+// Why both paths exist: a real browser drags `draggable` elements through HTML5 DnD,
+// which is what users get. Headless Chromium does not open a drag session for
+// Playwright's `dragTo` at all, so the `drop` handler never runs and a drag-only board
+// is untestable end to end (main has been red on exactly that). Pointer events cover
+// both engines and real touch/pen later. A gesture applies once, whichever path gets
+// there first — see UiBoardDrag.claim.
+
+import { Directive, EventEmitter, inject, Input, Output } from '@angular/core';
+import {
+  canDragFrom,
+  dragDown,
+  dragEnd,
+  dragMove,
+  dragTarget,
+  dragToNative,
+  DRAG_IDLE,
+  type DragSession,
+} from './logic';
+
+export interface UiDrop {
+  key: string;
+  to: string;
+}
+
+/** Which column is under a point? The attribute is also what tests assert on. */
+export function zoneOf(target: EventTarget | null): string | null {
+  const el = (target as Element | null)?.closest?.('[data-drop-zone]');
+  return el?.getAttribute('data-drop-zone') ?? null;
+}
+
+/** One board's drag gesture, shared by its wrapper, cards and columns. */
+export class UiBoardDrag {
+  private session: DragSession = DRAG_IDLE;
+  private claimed = -1;
+
+  /** The gesture that produced the last applied drop; -1 so token 0 can still claim. */
+  get dragging(): boolean {
+    return this.session.phase === 'dragging';
+  }
+
+  get activeKey(): string {
+    return this.session.key;
+  }
+
+  down(key: string, fromStateId: string, x: number, y: number): void {
+    this.session = dragDown(this.session, key, fromStateId, x, y);
+  }
+
+  move(x: number, y: number): void {
+    this.session = dragMove(this.session, x, y);
+  }
+
+  /** `dragstart`: the browser owns this gesture, so the pointer path stands down. */
+  standDown(): void {
+    this.session = dragToNative(this.session);
+  }
+
+  /** Release outside a target, a cancelled pointer, `dragend`: nothing to apply. */
+  cancel(): void {
+    this.session = dragEnd(this.session);
+  }
+
+  /** Pointer release inside the board; `zone` is the column under the release point. */
+  release(zone: string | null): UiDrop | null {
+    const prev = this.session;
+    const to = dragTarget(prev, zone);
+    this.session = dragEnd(prev);
+    return to && this.claim(prev.token) ? { key: prev.key, to } : null;
+  }
+
+  /** HTML5 drop: the payload carries the key, the zone the destination. */
+  nativeDrop(key: string, zone: string): UiDrop | null {
+    if (!key || !zone) return null;
+    return this.claim(this.session.token) ? { key, to: zone } : null;
+  }
+
+  /** Only the first path to finish a gesture may act on it. */
+  private claim(token: number): boolean {
+    if (this.claimed === token) return false;
+    this.claimed = token;
+    return true;
+  }
+}
+
+@Directive({
+  selector: '[uiBoard]',
+  providers: [UiBoardDrag],
+  host: {
+    '(pointermove)': 'onMove($event)',
+    '(pointerup)': 'onUp($event)',
+    '(pointercancel)': 'drag.cancel()',
+    '(pointerleave)': 'drag.cancel()',
+  },
+})
+export class UiBoard {
+  /** Emitted once per gesture that ended over a foreign column. */
+  @Output() readonly dragDrop = new EventEmitter<UiDrop>();
+
+  private readonly drag = inject(UiBoardDrag);
+
+  onMove(e: PointerEvent): void {
+    this.drag.move(e.clientX, e.clientY);
+  }
+
+  onUp(e: PointerEvent): void {
+    const drop = this.drag.release(zoneOf(e.target));
+    if (drop) this.dragDrop.emit(drop);
+  }
+}
+
+@Directive({
+  selector: '[uiDragSource]',
+  host: {
+    draggable: 'true',
+    '[class.ui-board-card--drag]': 'drag.dragging && drag.activeKey === uiDragSource',
+    '(pointerdown)': 'onDown($event)',
+    '(dragstart)': 'drag.standDown()',
+    '(dragend)': 'drag.cancel()',
+  },
+})
+export class UiDragSource {
+  /** Work-item key of the card, i.e. what a drop carries. */
+  @Input({ required: true }) uiDragSource!: string;
+  /** State the card currently sits in — a drag back onto its own column is a no-op. */
+  @Input({ required: true }) uiDragFrom!: string;
+
+  private readonly drag = inject(UiBoardDrag);
+
+  onDown(e: PointerEvent): void {
+    if (e.pointerType === 'touch' || e.button > 0) return; // touch and secondary buttons keep their own meaning
+    if (!canDragFrom((e.target as Element | null)?.tagName)) return; // links and buttons stay clickable
+    this.drag.down(this.uiDragSource, this.uiDragFrom, e.clientX, e.clientY);
+  }
+}
+
+@Directive({
+  selector: '[uiDropZone]',
+  host: {
+    '[attr.data-drop-zone]': 'uiDropZone',
+    '[class.ui-board-col--over]': 'over && drag.dragging',
+    '(pointerenter)': 'over = true',
+    '(pointerleave)': 'over = false',
+    '(dragover)': '$event.preventDefault()',
+    '(drop)': 'onDrop($event)',
+  },
+})
+export class UiDropZone {
+  /** State id this column moves items to. */
+  @Input({ required: true }) uiDropZone!: string;
+  /** Emitted by the HTML5 path; the pointer path emits on the board instead. */
+  @Output() readonly dropped = new EventEmitter<UiDrop>();
+
+  over = false;
+  private readonly drag = inject(UiBoardDrag);
+
+  onDrop(e: DragEvent): void {
+    e.preventDefault();
+    const drop = this.drag.nativeDrop(e.dataTransfer?.getData('text/plain') ?? '', this.uiDropZone);
+    if (drop) this.dropped.emit(drop);
+  }
+}
diff --git a/apps/web/src/app/ui/logic.ts b/apps/web/src/app/ui/logic.ts
index d8811b2..2dc31ce 100644
--- a/apps/web/src/app/ui/logic.ts
+++ b/apps/web/src/app/ui/logic.ts
@@ -140,3 +140,65 @@ export function stateVariant(category: string): 'default' | 'success' | 'warning
       return 'default';
   }
 }
+
+// ---------- board drag session (issue #11, D-046) ----------
+//
+// One gesture, two delivery paths. A real browser starts an HTML5 drag from the
+// `draggable` card and `dragstart` stands this session down (dragToNative), so the
+// two never both act on a drop. Headless Chromium does not enter a drag session for
+// Playwright's `dragTo` at all, so the pointer stream (press → move → release) has
+// to carry the same gesture. The phase rules live here, pure, because they are the
+// part that can be wrong silently.
+
+/** Pointer travel that turns a press into a drag; below it, it stays a click. */
+export const DRAG_THRESHOLD_PX = 4;
+
+/** Elements that keep their own press behaviour — the card is dragged around them. */
+const NO_DRAG_TAGS = new Set(['A', 'BUTTON', 'INPUT', 'SELECT', 'TEXTAREA', 'SUMMARY', 'LABEL']);
+
+export interface DragSession {
+  /** Increments per press; a drop may be applied once per token, by either path. */
+  token: number;
+  phase: 'idle' | 'pending' | 'dragging';
+  key: string;
+  fromStateId: string;
+  x: number;
+  y: number;
+}
+
+export const DRAG_IDLE: DragSession = { token: 0, phase: 'idle', key: '', fromStateId: '', x: 0, y: 0 };
+
+/** Whether a press on this element may begin a board drag. */
+export function canDragFrom(tagName: string | undefined): boolean {
+  return !!tagName && !NO_DRAG_TAGS.has(tagName.toUpperCase());
+}
+
+/** Press: remembered, but not yet a drag — and a newer gesture than anything before it. */
+export function dragDown(prev: DragSession, key: string, fromStateId: string, x: number, y: number): DragSession {
+  return { token: prev.token + 1, phase: 'pending', key, fromStateId, x, y };
+}
+
+/** Move: the threshold is measured from the press point, once, so the origin stays put. */
+export function dragMove(prev: DragSession, x: number, y: number): DragSession {
+  if (prev.phase === 'idle') return prev;
+  if (prev.phase === 'dragging') return prev;
+  if (Math.max(Math.abs(x - prev.x), Math.abs(y - prev.y)) < DRAG_THRESHOLD_PX) return prev;
+  return { ...prev, phase: 'dragging' };
+}
+
+/** Destination of the current gesture: a foreign column, and only once it is a drag. */
+export function dragTarget(prev: DragSession, zoneStateId: string | null): string | null {
+  if (prev.phase !== 'dragging') return null;
+  if (!zoneStateId || zoneStateId === prev.fromStateId) return null;
+  return zoneStateId;
+}
+
+/** Gesture over (either way): idle, but the token survives so it cannot re-apply. */
+export function dragEnd(prev: DragSession): DragSession {
+  return { ...DRAG_IDLE, token: prev.token };
+}
+
+/** The native HTML5 drag took the gesture; the pointer path must not act on it. */
+export function dragToNative(prev: DragSession): DragSession {
+  return { ...DRAG_IDLE, token: prev.token };
+}
