+++ b/packages/core/src/exec/open-items-service.test.ts
@@ -0,0 +1,135 @@
+import { describe, expect, it } from 'vitest';
+import { parseOpenItemCreate, parseOpenItemResolve, sourceForActor } from './open-items-service';
+import { validateNewOpenItem } from './open-items';
+
+/**
+ * Acceptance A.5 (docs/EXECUTION_CONTROL_PLAN.md §6): a malformed ledger write is
+ * answered with a structured error that says what to fix — never a crash, never a
+ * silent accept. The service parses at its own boundary instead of trusting the
+ * caller (tool, REST route or CLI) to have validated anything.
+ */
+const valid = {
+  title: 'gate ignores waivers without an approval id',
+  type: 'bug',
+  blocks_completion: true,
+};
+
+describe('open-item create input (A.5)', () => {
+  it('accepts the documented shape and strips the routing field', () => {
+    const r = parseOpenItemCreate({ ...valid, task_ref: 'T-001', detail: 'seen in run 39073122374' });
+    expect(r.ok).toBe(true);
+    if (r.ok) {
+      expect(r.value.title).toBe(valid.title);
+      expect((r.value as unknown as Record<string, unknown>).task_ref).toBeUndefined();
+    }
+  });
+
+  const cases: [string, unknown][] = [
+    ['title shorter than 5 chars', { ...valid, title: 'bug' }],
+    ['title longer than 500 chars', { ...valid, title: 'x'.repeat(501) }],
+    ['unknown item type', { ...valid, type: 'todo' }],
+    ['missing title', { type: 'bug' }],
+    ['missing type', { title: valid.title }],
+    ['extra unknown field', { ...valid, assignee: 'me' }],
+    ['detail over the cap', { ...valid, detail: 'd'.repeat(8001) }],
+    ['title is not a string', { ...valid, title: 42 }],
+    [
+      'why_not_blocking too short',
+      { ...valid, type: 'commitment', blocks_completion: false, why_not_blocking: 'later' },
+    ],
+    ['blocks_completion not a boolean', { ...valid, blocks_completion: 'true' }],
+    ['type as a number', { ...valid, type: 7 }],
+    ['null payload', null],
+    ['undefined payload', undefined],
+    ['array payload', [valid]],
+    ['string payload', 'file a bug'],
+    ['prototype-polluting key', { ...valid, __proto__: { admin: true } }],
+  ];
+  it.each(cases)('refuses %s with needed_action instead of a crash', (_name, raw) => {
+    let out: ReturnType<typeof parseOpenItemCreate> | undefined;
+    expect(() => {
+      out = parseOpenItemCreate(raw);
+    }).not.toThrow();
+    expect(out?.ok).toBe(false);
+    if (out && !out.ok) {
+      expect(out.code).toBe('VALIDATION_ERROR');
+      expect(out.message.length).toBeGreaterThan(10);
+      expect(out.needed_action).toMatch(/fix|send|docs\/EXECUTION_CONTROL_PLAN/);
+    }
+  });
+
+  it('does not accept a reason-only downgrade dressed up as blocking', () => {
+    // blocks_completion omitted on a default-blocking type stays blocking.
+    const r = parseOpenItemCreate({ title: valid.title, type: 'incomplete_requirement' });
+    expect(r.ok).toBe(true);
+    if (r.ok) expect(r.value.blocks_completion).toBeUndefined();
+  });
+});
+
+describe('open-item resolve input (A.5/A.3)', () => {
+  it('accepts a real closure note', () => {
+    const r = parseOpenItemResolve({
+      item_ref: 'OI-004',
+      status: 'resolved',
+      note: 'fixed in 2edeeb9, chain.spec.ts asserts it now',
+    });
+    expect(r.ok).toBe(true);
+  });
+
+  const bad: [string, unknown][] = [
+    ['a status that is not a transition', { item_ref: 'OI-1', status: 'closed', note: 'x'.repeat(30) }],
+    ['a note shorter than the 20-char floor', { item_ref: 'OI-1', status: 'resolved', note: 'done' }],
+    ['no note at all', { item_ref: 'OI-1', status: 'resolved' }],
+    ['missing item_ref', { status: 'resolved', note: 'x'.repeat(30) }],
+    ['an extra field', { item_ref: 'OI-1', status: 'resolved', note: 'x'.repeat(30), silent: true }],
+    ['status capitalised', { item_ref: 'OI-1', status: 'Resolved', note: 'x'.repeat(30) }],
+    ['note not a string', { item_ref: 'OI-1', status: 'resolved', note: 42 }],
+  ];
+  it.each(bad)('refuses %s', (_name, raw) => {
+    const r = parseOpenItemResolve(raw);
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.code).toBe('VALIDATION_ERROR');
+  });
+});
+
+describe('shape is not the law (A.5 vs A.3/A.7)', () => {
+  it('the shape accepts a blocking downgrade and the state machine refuses it', () => {
+    const shape = parseOpenItemCreate({ title: valid.title, type: 'commitment', blocks_completion: false });
+    expect(shape.ok).toBe(true); // the field is present and well-typed
+    const law = validateNewOpenItem({
+      type: 'commitment',
+      title: valid.title,
+      blocks_completion: false,
+      actorType: 'agent',
+    });
+    expect(law.ok).toBe(false); // ...but a commitment may not become a footnote without a reason
+    if (!law.ok) expect(law.needed_action.length).toBeGreaterThan(5);
+  });
+
+  it('a ref is only length-checked here; whether it exists is the ledger that answers', () => {
+    expect(parseOpenItemResolve({ item_ref: 'not a ledger ref', status: 'resolved', note: 'x'.repeat(30) }).ok).toBe(
+      true,
+    );
+    expect(parseOpenItemResolve({ item_ref: 'ab', status: 'resolved', note: 'x'.repeat(30) }).ok).toBe(false);
+  });
+});
+
+describe('source attribution (0010 source CHECK)', () => {
+  it('derives the source from who is acting', () => {
+    expect(sourceForActor('agent')).toEqual({ ok: true, source: 'agent' });
+    expect(sourceForActor('human')).toEqual({ ok: true, source: 'human' });
+  });
+
+  it('makes a system writer name the role it writes as', () => {
+    const r = sourceForActor('system');
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.needed_action).toContain('exit_report');
+  });
+
+  it('lets the promotion path claim exit_report/reviewer but never human', () => {
+    expect(sourceForActor('agent', 'exit_report').ok).toBe(true);
+    expect(sourceForActor('agent', 'reviewer').ok).toBe(true);
+    expect(sourceForActor('agent', 'human').ok).toBe(false);
+    expect(sourceForActor('agent', 'ghost').ok).toBe(false);
+  });
+});
diff --git a/packages/core/src/exec/open-items-service.ts b/packages/core/src/exec/open-items-service.ts
new file mode 100644
index 0000000..aa20f90
--- /dev/null
+++ b/packages/core/src/exec/open-items-service.ts
@@ -0,0 +1,353 @@
+import { sql } from 'kysely';
+import {
+  AppError,
+  BLOCKING_BY_DEFAULT,
+  openItemInputSchema,
+  resolveItemInputSchema,
+  type ExecOpenItemStatus,
+} from '@forgepm/shared';
+import type { DbLike } from '../db/unitOfWork';
+import { newId } from '../id';
+import { allocateLedgerCode } from './codes';
+import { appendEvent } from './events';
+import { dedupKey, validateNewOpenItem, validateResolution, type ResolveOutcome } from './open-items';
+
+/**
+ * Open-item write path (docs/EXECUTION_CONTROL_PLAN.md §6, acceptance A.3–A.8).
+ *
+ * The laws themselves live in `open-items.ts` (pure) and in 0010's CHECK
+ * constraints (non-bypassable); this file is the *only* supported way to write an
+ * open item, and it exists so that those laws cannot be re-implemented slightly
+ * differently by each caller. Every mutation appends exactly one `exec_events`
+ * row inside the same transaction (A.4) and never deletes anything (A.2):
+ * a closed item is history, not trash.
+ *
+ * Callers own the transaction: pass a `unitOfWork` tx so ledger row + event +
+ * `audit_event` commit or roll back together.
+ */
+
+export interface LedgerActor {
+  organizationId: string;
+  projectId: string;
+  actorType: 'agent' | 'human' | 'system';
+  actorId: string;
+  /** The tool that asked for this, recorded verbatim in exec_events. */
+  tool?: string;
+}
+
+export interface OpenItemRow {
+  id: string;
+  task_id: string;
+  code: string;
+  title: string;
+  detail: string | null;
+  type: string;
+  blocks_completion: boolean;
+  why_not_blocking: string | null;
+  source: string;
+  status: ExecOpenItemStatus;
+  resolution_note: string | null;
+  resolved_by: string | null;
+  related_ref: string | null;
+}
+
+export interface ParseOk<T> {
+  ok: true;
+  value: T;
+}
+export interface ParseFail {
+  ok: false;
+  code: 'VALIDATION_ERROR';
+  message: string;
+  needed_action: string;
+}
+/** Structured, never thrown: a malformed payload is an answer, not a crash (A.5). */
+export type ParseResult<T> = ParseOk<T> | ParseFail;
+
+export interface OpenItemCreateValue {
+  title: string;
+  detail?: string;
+  type: string;
+  blocks_completion?: boolean;
+  why_not_blocking?: string;
+  related_ref?: string;
+}
+
+export interface OpenItemResolveValue {
+  item_ref: string;
+  status: ExecOpenItemStatus;
+  note: string;
+}
+
+const SELECT_COLS = `id, task_id, code, title, detail, type, blocks_completion, why_not_blocking,
+       source, status, resolution_note, resolved_by, related_ref`;
+
+/** Shape-check a create payload. Unknown keys are refused, not ignored. */
+export function parseOpenItemCreate(raw: unknown): ParseResult<OpenItemCreateValue> {
+  const parsed = openItemInputSchema.safeParse(raw ?? {});
+  if (!parsed.success) return zodFailure(parsed.error.issues[0]);
+  // task_ref routes the write to a task; it is not part of the row, and the caller
+  // passes it separately — so the parsed value loses it here rather than at the INSERT.
+  const rest = { ...parsed.data };
+  delete rest.task_ref;
+  return { ok: true, value: rest };
+}
+
+/** Shape-check a resolve payload (`{ item_ref, status, note }`). */
+export function parseOpenItemResolve(raw: unknown): ParseResult<OpenItemResolveValue> {
+  const parsed = resolveItemInputSchema.safeParse(raw ?? {});
+  if (!parsed.success) return zodFailure(parsed.error.issues[0]);
+  return { ok: true, value: parsed.data };
+}
+
+/**
+ * Which `source` an actor may file an item under. 0010's CHECK allows five
+ * sources; only agent and human follow from who is acting, so a system caller has
+ * to say which of the three remaining roles it is writing as.
+ */
+export function sourceForActor(
+  actorType: LedgerActor['actorType'],
+  requested?: string,
+): { ok: true; source: string } | { ok: false; message: string; needed_action: string } {
+  if (requested) {
+    const allowed = ['agent', 'exit_report', 'reviewer', 'human', 'hook'];
+    if (!allowed.includes(requested)) {
+      return {
+        ok: false,
+        message: `unknown open-item source '${requested}'`,
+        needed_action: `use one of: ${allowed.join(', ')}`,
+      };
+    }
+    if (actorType === 'agent' && requested !== 'agent' && requested !== 'exit_report' && requested !== 'reviewer') {
+      return {
+        ok: false,
+        message: `an agent may not file an item as '${requested}'`,
+        needed_action: 'file it as agent (or exit_report/reviewer when promoting a report)',
+      };
+    }
+    return { ok: true, source: requested };
+  }
+  if (actorType === 'agent') return { ok: true, source: 'agent' };
+  if (actorType === 'human') return { ok: true, source: 'human' };
+  return {
+    ok: false,
+    message: 'a system actor must name the source it writes as',
+    needed_action: "pass source: 'exit_report' | 'reviewer' | 'hook'",
+  };
+}
+
+/** Task lookup by id or ledger code, scoped to the caller's organisation. */
+export async function findTaskByRef(
+  db: DbLike,
+  actor: Pick<LedgerActor, 'organizationId' | 'projectId'>,
+  ref: string,
+): Promise<{ id: string; code: string; status: string } | null> {
+  const r = await sql<{ id: string; code: string; status: string }>`
+    SELECT id, code, status FROM exec_tasks
+    WHERE organization_id = ${actor.organizationId} AND project_id = ${actor.projectId}
+      AND (id::text = ${ref} OR code = ${ref})
+  `.execute(db as never);
+  return r.rows[0] ?? null;
+}
+
+/**
+ * File an open item. Refused before any write when the rules say so: a blocking
+ * item filed as non-blocking needs a reason, and an already-open item with the
+ * same normalised title is a duplicate rather than a second record.
+ */
+export async function createOpenItem(
+  db: DbLike,
+  actor: LedgerActor,
+  taskRef: string,
+  raw: unknown,
+  source?: string,
+): Promise<OpenItemRow> {
+  const parsed = parseOpenItemCreate(raw);
+  if (!parsed.ok) throw validationError(parsed);
+  const task = await findTaskByRef(db, actor, taskRef);
+  if (!task) throw new AppError('NOT_FOUND', `no task '${taskRef}' in this project`, { ref: taskRef });
+
+  const blocks =
+    parsed.value.blocks_completion ?? (BLOCKING_BY_DEFAULT as readonly string[]).includes(parsed.value.type);
+  const check = validateNewOpenItem({
+    type: parsed.value.type,
+    title: parsed.value.title,
+    blocks_completion: blocks,
+    why_not_blocking: parsed.value.why_not_blocking,
+    actorType: actor.actorType,
+  });
+  if (!check.ok) throw ruleError(check);
+  const who = sourceForActor(actor.actorType, source);
+  if (!who.ok) throw new AppError('VALIDATION_ERROR', who.message, { needed_action: who.needed_action });
+
+  const key = dedupKey(parsed.value.type, parsed.value.title);
+  const twin = await findByDedupKey(db, task.id, parsed.value.type, parsed.value.title);
+  if (twin) {
+    throw new AppError('CONFLICT', `open item '${twin.code}' already covers this`, {
+      existing: twin.code,
+      dedup_key: key,
+      needed_action: `update or resolve ${twin.code} instead of filing it twice`,
+    });
+  }
+
+  const id = newId();
+  const code = await allocateLedgerCode(db, actor.projectId, 'OI');
+  await sql`
+    INSERT INTO exec_open_items
+      (id, organization_id, task_id, code, title, detail, type, blocks_completion, why_not_blocking, source, status, related_ref)
+    VALUES
+      (${id}, ${actor.organizationId}, ${task.id}, ${code}, ${parsed.value.title}, ${parsed.value.detail ?? null},
+       ${parsed.value.type}, ${blocks}, ${parsed.value.why_not_blocking ?? null}, ${who.source}, 'open',
+       ${parsed.value.related_ref ?? null})
+  `.execute(db as never);
+  const row = await readItem(db, id);
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: task.id,
+    entity: 'open_item',
+    entity_id: id,
+    entity_code: code,
+    action: 'open_item.created',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: { before: null, after: row },
+  });
+  return row;
+}
+
+/**
+ * Move an open item to another status. The pure state machine answers first, so
+ * an agent asking to `defer` a blocking item gets `LEDGER_TRANSITION_NOT_ALLOWED`
+ * with the action it must take instead — and 0010's CHECK is still what makes the
+ * same rule true for any other writer (A.3).
+ */
+export async function resolveOpenItem(
+  db: DbLike,
+  actor: LedgerActor,
+  taskRef: string,
+  raw: unknown,
+): Promise<OpenItemRow> {
+  const parsed = parseOpenItemResolve(raw);
+  if (!parsed.ok) throw validationError(parsed);
+  const task = await findTaskByRef(db, actor, taskRef);
+  if (!task) throw new AppError('NOT_FOUND', `no task '${taskRef}' in this project`, { ref: taskRef });
+
+  const before = await findItemByRef(db, task.id, parsed.value.item_ref);
+  if (!before) {
+    throw new AppError('NOT_FOUND', `no open item '${parsed.value.item_ref}' on task ${task.code}`, {
+      item_ref: parsed.value.item_ref,
+      needed_action: 'ledger_list_open shows the codes this task has',
+    });
+  }
+  const subject = {
+    code: before.code,
+    type: before.type,
+    blocks_completion: before.blocks_completion,
+    status: before.status,
+  };
+  const check = validateResolution(subject, {
+    requested: parsed.value.status,
+    note: parsed.value.note,
+    actorType: actor.actorType,
+  });
+  if (!check.ok) throw ruleError(check);
+
+  const closing = parsed.value.status !== 'open' && !ACTIVE_STATUSES.has(parsed.value.status);
+  await sql`
+    UPDATE exec_open_items
+    SET status = ${parsed.value.status}, resolution_note = ${parsed.value.note},
+        resolved_by = ${closing ? (actor.actorType === 'agent' ? 'agent' : 'human') : null},
+        updated_at = now()
+    WHERE id = ${before.id}
+  `.execute(db as never);
+  const after = await readItem(db, before.id);
+  await appendEvent(db, {
+    organization_id: actor.organizationId,
+    task_id: task.id,
+    entity: 'open_item',
+    entity_id: before.id,
+    entity_code: before.code,
+    action: closing ? 'open_item.closed' : 'open_item.reopened',
+    actor_type: actor.actorType,
+    actor_id: actor.actorId,
+    tool: actor.tool ?? null,
+    payload: {
+      before: { status: before.status, resolution_note: before.resolution_note, resolved_by: before.resolved_by },
+      after: { status: after.status, resolution_note: after.resolution_note, resolved_by: after.resolved_by },
+    },
+  });
+  return after;
+}
+
+/** Every item of a task, active first — the order the panel and the tools show. */
+export async function listTaskItems(
+  db: DbLike,
+  taskId: string,
+  opts: { activeOnly?: boolean } = {},
+): Promise<OpenItemRow[]> {
+  const active = opts.activeOnly ? sql`AND status IN ('open','blocked','awaiting_human')` : sql``;
+  const r = await sql<OpenItemRow>`
+    SELECT ${sql.raw(SELECT_COLS)} FROM exec_open_items
+    WHERE task_id = ${taskId} ${active}
+    ORDER BY (status IN ('open','blocked','awaiting_human')) DESC, code
+  `.execute(db as never);
+  return r.rows.map(normaliseRow);
+}
+
+async function findByDedupKey(db: DbLike, taskId: string, type: string, title: string): Promise<OpenItemRow | null> {
+  const active = await listTaskItems(db, taskId, { activeOnly: true });
+  const key = dedupKey(type, title);
+  return active.find((row) => dedupKey(row.type, row.title) === key) ?? null;
+}
+
+async function findItemByRef(db: DbLike, taskId: string, ref: string): Promise<OpenItemRow | null> {
+  const r = await sql<OpenItemRow>`
+    SELECT ${sql.raw(SELECT_COLS)} FROM exec_open_items
+    WHERE task_id = ${taskId} AND (id::text = ${ref} OR code = ${ref})
+  `.execute(db as never);
+  return r.rows[0] ? normaliseRow(r.rows[0]) : null;
+}
+
+async function readItem(db: DbLike, id: string): Promise<OpenItemRow> {
+  const r = await sql<OpenItemRow>`
+    SELECT ${sql.raw(SELECT_COLS)} FROM exec_open_items WHERE id = ${id}
+  `.execute(db as never);
+  const row = r.rows[0];
+  if (!row) throw new AppError('INTERNAL', `open item ${id} vanished inside its own transaction`);
+  return normaliseRow(row);
+}
+
+/** `blocks_completion` arrives as a boolean but the driver types everything as string. */
+function normaliseRow(row: OpenItemRow): OpenItemRow {
+  return {
+    ...row,
+    blocks_completion:
+      row.blocks_completion === true ||
+      (row.blocks_completion as unknown) === 'true' ||
+      (row.blocks_completion as unknown) === 1,
+  };
+}
+
+/** Statuses an item can still move out of; anything else has been closed. */
+const ACTIVE_STATUSES = new Set(['open', 'blocked', 'awaiting_human']);
+
+function validationError(fail: ParseFail): AppError {
+  return new AppError('VALIDATION_ERROR', fail.message, { needed_action: fail.needed_action });
+}
+
+function ruleError(check: Extract<ResolveOutcome, { ok: false }>): AppError {
+  return new AppError(check.code, check.message, { needed_action: check.needed_action });
+}
+
+function zodFailure(issue: { path: (string | number)[]; message: string } | undefined): ParseFail {
+  const path = issue?.path?.filter((p) => p !== 'task_ref').join('.') ?? '';
+  return {
+    ok: false,
+    code: 'VALIDATION_ERROR',
+    message: issue ? `open-item input: ${path || '(root)'} ${issue.message}` : 'open-item input is not an object',
+    needed_action: path
+      ? `fix '${path}' (see docs/EXECUTION_CONTROL_PLAN.md §6 for the shape)`
+      : 'send only the documented fields, with task_ref, title (>= 5 chars), type and blocks_completion',
+  };
+}
diff --git a/packages/core/src/exec/open-items.ts b/packages/core/src/exec/open-items.ts
new file mode 100644
index 0000000..85a5a5b
--- /dev/null
+++ b/packages/core/src/exec/open-items.ts
@@ -0,0 +1,157 @@
+import { EXEC_HUMAN_ONLY_CLOSURES, EXEC_OPEN_ITEM_ACTIVE, type ExecOpenItemStatus } from '@forgepm/shared';
+
+/**
+ * Open-item state machine (docs/EXECUTION_CONTROL_PLAN.md §6 / plan §A rules).
+ * Pure so the "no silent close" law can be tested without a database — and the
+ * same function is reused by the service layer and the DB CHECK constraints.
+ */
+
+export interface ResolveSubject {
+  code: string;
+  type: string;
+  blocks_completion: boolean;
+  status: ExecOpenItemStatus;
+}
+
+export interface ResolveInput {
+  requested: ExecOpenItemStatus;
+  note: string;
+  actorType: 'agent' | 'human' | 'system';
+}
+
+export interface NewOpenItemInput {
+  type: string;
+  title: string;
+  detail?: string;
+  blocks_completion: boolean;
+  /** Required when a REQUIRED item is filed as non-blocking (plan §B). */
+  why_not_blocking?: string;
+  actorType: 'agent' | 'human' | 'system';
+}
+
+export type ResolveOutcome =
+  | { ok: true }
+  | { ok: false; code: 'LEDGER_TRANSITION_NOT_ALLOWED' | 'VALIDATION_ERROR'; message: string; needed_action: string };
+
+const MIN_NOTE = 20;
+/** Statuses that END the item. 'blocked'/'awaiting_human'/'open' are active states. */
+export const CLOSURE_STATUSES = ['resolved', 'accepted', 'deferred', 'wont_fix', 'not_applicable'] as const;
+export const isOpenItemClosure = (status: ExecOpenItemStatus): boolean =>
+  (CLOSURE_STATUSES as readonly string[]).includes(status);
+
+export function validateResolution(subject: ResolveSubject, input: ResolveInput): ResolveOutcome {
+  const note = (input.note ?? '').trim();
+  if (input.requested === 'open') {
+    if (input.actorType !== 'human') {
+      return fail(
+        'LEDGER_TRANSITION_NOT_ALLOWED',
+        'an agent may not reopen a closed item — only a human may',
+        'ask the human (ledger_ask_human) to reopen it, or add a fresh open item',
+      );
+    }
+    return { ok: true };
+  }
+  if (note.length < MIN_NOTE) {
+    return fail(
+      'VALIDATION_ERROR',
+      `closing an open item needs a resolution note of at least ${MIN_NOTE} characters (got ${note.length})`,
+      'explain what was done, or where the proof lives, then retry',
+    );
+  }
+  if (subject.blocks_completion && isOpenItemClosure(input.requested)) {
+    if (input.requested === 'accepted' || input.requested === 'deferred' || input.requested === 'wont_fix') {
+      if (input.actorType !== 'human' && input.actorType !== 'system') {
+        return fail(
+          'LEDGER_TRANSITION_NOT_ALLOWED',
+          `'${input.requested}' is not allowed for a blocking item by an agent — an agent may not delete a required item from the definition of done`,
+          `either fix it and resolve with status 'resolved' + evidence, or call ledger_ask_human so a human can decide`,
+        );
+      }
+    }
+    if (input.actorType === 'agent' && input.requested !== 'resolved' && input.requested !== 'not_applicable') {
+      return fail(
+        'LEDGER_TRANSITION_NOT_ALLOWED',
+        `a blocking item may only be closed as 'resolved' or 'not_applicable' (got '${input.requested}')`,
+        'resolve it with proof, or ask the human to accept/defer it',
+      );
+    }
+  }
+  if (
+    input.requested === 'not_applicable' &&
+    subject.type !== 'suggestion' &&
+    subject.type !== 'out_of_scope' &&
+    note.length < 60
+  ) {
+    return fail(
+      'VALIDATION_ERROR',
+      "'not_applicable' on a non-optional item needs a longer justification (>= 60 chars)",
+      'state which requirement makes it not applicable, quoting the requirement code',
+    );
+  }
+  return { ok: true };
+}
+
+/**
+ * Filing rules. The important one: an agent may not file "the requirement is not
+ * met" as a non-blocking note — that would let it shrink the definition of done
+ * by wording. Mirrors the DB CHECK on `exec_open_items`, so a direct SQL write
+ * is held to the same bar.
+ */
+export function validateNewOpenItem(input: NewOpenItemInput): ResolveOutcome {
+  const title = (input.title ?? '').trim();
+  if (title.length < 10) {
+    return fail(
+      'VALIDATION_ERROR',
+      `title needs >= 10 characters (got ${title.length})`,
+      'state the observable problem, not a label ("gate blocks on missing test")',
+    );
+  }
+  const requiredish = input.type === 'incomplete_requirement' || input.type === 'commitment';
+  if (requiredish && !input.blocks_completion) {
+    const why = (input.why_not_blocking ?? '').trim();
+    const min = input.actorType === 'agent' ? 40 : 1;
+    if (why.length < min) {
+      return fail(
+        'VALIDATION_ERROR',
+        `an ${input.type} filed as non-blocking needs why_not_blocking of >= ${min} characters (got ${why.length})`,
+        'either file it with blocks_completion=true, or explain which requirement makes it optional (quoting its code)',
+      );
+    }
+  }
+  return { ok: true };
+}
+
+export function isHumanOnlyClosure(status: ExecOpenItemStatus): boolean {
+  return (EXEC_HUMAN_ONLY_CLOSURES as readonly string[]).includes(status);
+}
+
+export function isActiveOpenItem(status: ExecOpenItemStatus): boolean {
+  return (EXEC_OPEN_ITEM_ACTIVE as readonly string[]).includes(status);
+}
+
+/** Blocking items that keep the gate shut. */
+export function blockingOpen<T extends { blocks_completion: boolean; status: ExecOpenItemStatus }>(
+  items: readonly T[],
+): T[] {
+  return items.filter((i) => i.blocks_completion && isActiveOpenItem(i.status));
+}
+
+/**
+ * Dedup key for auto-promotion of exit-report entries into open items: the same
+ * sentence must not create two items across resubmissions (acceptance C.4).
+ */
+export function dedupKey(kind: string, title: string): string {
+  const norm = title
+    .toLowerCase()
+    .replace(/[\s\p{P}]+/gu, ' ')
+    .trim();
+  return `${kind}|${norm.slice(0, 200)}`;
+}
+
+function fail(
+  code: 'LEDGER_TRANSITION_NOT_ALLOWED' | 'VALIDATION_ERROR',
+  message: string,
+  needed_action: string,
+): { ok: false; code: typeof code; message: string; needed_action: string } {
+  return { ok: false, code, message, needed_action };
+}
