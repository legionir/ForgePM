+    expect(sneaky.code).toBe('SCOPE_VIOLATION');
+    const gone = checkEvidence({
+      ...base,
+      kind: 'file',
+      ref: 'file:docs/missing.png',
+      summary: 'a file that is not readable at all',
+      fs: { exists: () => true, read: () => null },
