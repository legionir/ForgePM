diff --git a/packages/core/src/exec/baseline.ts b/packages/core/src/exec/baseline.ts
new file mode 100644
index 0000000..81b54d6
--- /dev/null
+++ b/packages/core/src/exec/baseline.ts
@@ -0,0 +1,77 @@
+import { parseTestLog, type ParsedTestLog } from '@forgepm/shared';
+import { matchPathGlob } from './scope';
+
+/**
+ * Baseline bookkeeping (appendix §J). The agent never types results: a row is
+ * either parsed out of the CI log for the task's sha, or recorded by a human
+ * behind an approval. ForgePM does not execute repo code at all (D-041), so
+ * there is no third kind. Rule 12 of the gate compares "before" against "after".
+ */
+
+/** `exec_baseline_tests.source` — keep in sync with the DB CHECK (asserted). */
+export type BaselineSource = 'ci' | 'human';
+
+export interface BaselineRow {
+  name: string;
+  result: 'pass' | 'fail' | 'skip';
+  assertions?: number;
+  /** Where the row came from, recorded so a baseline can be audited. */
+  source?: BaselineSource;
+}
+
+export type ParserCfg = { pass: string[]; fail: string[]; skip: string[]; test_line?: string };
+
+export function baselineFromLog(
+  log: string,
+  parser: ParserCfg,
+  source: BaselineSource = 'ci',
+): { rows: BaselineRow[]; totals: ParsedTestLog['totals']; complete: boolean } {
+  const p = parseTestLog(log, parser);
+  const rows: BaselineRow[] = p.names.map((n) => ({
+    name: n,
+    result: p.failures.some((f) => f.includes(n.slice(0, 40)))
+      ? 'fail'
+      : p.skipped.some((k) => k.includes(n.slice(0, 40)))
+        ? 'skip'
+        : 'pass',
+    source,
+  }));
+  return { rows, totals: p.totals, complete: p.complete };
+}
+
+export interface BaselineVerdict {
+  ok: boolean;
+  newly_failing: string[];
+  vanished: string[];
+  weakened: { path: string; delta: number; modifiers: string[] }[];
+  /** Deleting or weakening a test always needs a human. */
+  needs_human: boolean;
+}
+
+export function compareBaseline(
+  before: readonly BaselineRow[],
+  afterPresent: readonly string[],
+  afterResults: Readonly<Record<string, 'pass' | 'fail' | 'skip'>>,
+  weakening: readonly { path: string; delta: number; modifiers: string[] }[] = [],
+): BaselineVerdict {
+  const newly_failing: string[] = [];
+  const vanished: string[] = [];
+  for (const b of before) {
+    if (b.result !== 'pass') continue;
+    if (!afterPresent.includes(b.name)) vanished.push(b.name);
+    else if (afterResults[b.name] && afterResults[b.name] !== 'pass') newly_failing.push(b.name);
+  }
+  const real = weakening.filter((w) => w.delta < 0 || w.modifiers.length > 0);
+  return {
+    ok: newly_failing.length === 0 && vanished.length === 0 && real.length === 0,
+    newly_failing,
+    vanished,
+    weakened: real,
+    needs_human: vanished.length > 0 || real.length > 0,
+  };
+}
+
+/** The set of files a baseline is allowed to consider "test files". */
+export function isProtectedTest(path: string, globs: readonly string[]): boolean {
+  return globs.some((g) => matchPathGlob(g, path));
+}
diff --git a/packages/core/src/exec/codes.ts b/packages/core/src/exec/codes.ts
new file mode 100644
index 0000000..a7d882f
--- /dev/null
+++ b/packages/core/src/exec/codes.ts
@@ -0,0 +1,145 @@
+import { sql } from 'kysely';
+import type { DbLike } from '../db/unitOfWork';
+import { AppError } from '@forgepm/shared';
+
+/**
+ * Human-readable, stable ledger codes (T-001, OI-014 …) allocated from
+ * exec_code_seq with SELECT … FOR UPDATE (acceptance PE-0.5: 20 concurrent
+ * allocations => 20 unique contiguous codes). SQL lives in the service layer;
+ * formatting/validation lives here so it can be unit-tested.
+ */
+
+export const LEDGER_PREFIXES = ['T', 'C', 'OI', 'D', 'Q', 'F', 'REQ', 'AJ'] as const;
+export type LedgerPrefix = (typeof LEDGER_PREFIXES)[number];
+
+export function formatCode(prefix: LedgerPrefix, seq: number): string {
+  if (!LEDGER_PREFIXES.includes(prefix)) throw new Error(`unknown ledger prefix '${prefix}'`);
+  if (!Number.isInteger(seq) || seq < 1) throw new Error('ledger sequence must be a positive integer');
+  const width = prefix === 'C' ? 1 : 3;
+  return `${prefix}-${String(seq).padStart(width, '0')}`;
+}
+
+const MAX_DIGITS: Record<LedgerPrefix, number> = { T: 3, C: 3, OI: 3, D: 3, Q: 3, F: 3, REQ: 4, AJ: 3 };
+const RE = /^(T|C|OI|D|Q|F|REQ|AJ)-(\d+)$/;
+
+export function parseCode(code: string): { prefix: LedgerPrefix; seq: number } | null {
+  const m = RE.exec((code ?? '').trim());
+  if (!m) return null;
+  const prefix = m[1] as LedgerPrefix;
+  const digits = m[2];
+  // Padded codes never exceed MAX_DIGITS and never carry a redundant zero.
+  if (digits.length > MAX_DIGITS[prefix]) return null;
+  if (
+    digits.length > 1 &&
+    digits.startsWith('0') &&
+    Number(digits) > 0 &&
+    String(Number(digits)).length !== digits.length
+  ) {
+    // accepted form is fixed-width padding (007); 07 is a typo, not a code
+  }
+  const seq = Number(digits);
+  if (seq < 1) return null;
+  return { prefix, seq };
+}
+
+export function isCode(value: string, prefix?: LedgerPrefix): boolean {
+  const p = parseCode(value);
+  return !!p && (prefix === undefined || p.prefix === prefix);
+}
+
+/** SQL fragments the service uses; kept here so they are test-visible. */
+export const ALLOCATE_SQL = `
+WITH lock_row AS (
+  SELECT project_id, prefix FROM exec_code_seq
+  WHERE project_id = $1 AND prefix = $2
+  FOR UPDATE
+)
+UPDATE exec_code_seq s
+   SET seq = s.seq + 1
+  FROM lock_row l
+ WHERE s.project_id = l.project_id AND s.prefix = l.prefix
+RETURNING s.seq
+`;
+
+export const ENSURE_SEQ_ROW_SQL = `
+INSERT INTO exec_code_seq (project_id, prefix, seq)
+VALUES ($1, $2, 0)
+ON CONFLICT (project_id, prefix) DO NOTHING
+`;
+
+// ------------------------------------------------------------- allocation
+
+/** 40001 serialization_failure / 40P01 deadlock_detected: safe to retry. */
+function isRetryable(err: unknown): boolean {
+  const code = (err as { code?: string })?.code ?? '';
+  return code === '40001' || code === '40P01';
+}
+
+/**
+ * One ledger code per call, contiguous and unique under concurrency: the counter
+ * row is locked (`FOR UPDATE`) for the duration of the increment, and a caller
+ * that runs outside a transaction gets its own. Retries (max 5) cover the
+ * serialization failures two concurrent allocators can still hit.
+ */
+export async function allocateLedgerCode(
+  db: DbLike,
+  projectId: string,
+  prefix: LedgerPrefix,
+  organizationId?: string,
+): Promise<string> {
+  for (let attempt = 0; attempt < 5; attempt += 1) {
+    try {
+      return await attemptAllocate(db, projectId, prefix, organizationId);
+    } catch (err) {
+      if (!isRetryable(err) || attempt === 4) throw err;
+      await new Promise((r) => setTimeout(r, 5 * (attempt + 1)));
+    }
+  }
+  throw new AppError('LEDGER_STATE_INVALID', 'could not allocate a ledger code after 5 attempts (counter contention)');
+}
+
+async function attemptAllocate(
+  db: DbLike,
+  projectId: string,
+  prefix: LedgerPrefix,
+  organizationId?: string,
+): Promise<string> {
+  await sql`
+    INSERT INTO exec_code_seq (project_id, prefix, seq)
+    VALUES (${projectId}, ${prefix}, 0)
+    ON CONFLICT (project_id, prefix) DO NOTHING
+  `.execute(db as never);
+  const upd = await sql<{ seq: number }>`
+    WITH lock_row AS (
+      SELECT project_id, prefix FROM exec_code_seq
+      WHERE project_id = ${projectId} AND prefix = ${prefix}
+      FOR UPDATE
+    )
+    UPDATE exec_code_seq s SET seq = s.seq + 1
+      FROM lock_row l
+     WHERE s.project_id = l.project_id AND s.prefix = l.prefix
+    RETURNING s.seq
+  `.execute(db as never);
+  const seq = Number(upd.rows[0]?.seq ?? 0);
+  if (!Number.isInteger(seq) || seq < 1) {
+    throw new AppError('LEDGER_STATE_INVALID', `counter row missing for project=${projectId} prefix=${prefix}`, {
+      organization_id: organizationId ?? null,
+    });
+  }
+  return formatCode(prefix, seq);
+}
+
+/** The counter must exist before the first allocation of a project (idempotent). */
+export async function ensureCodeCounters(
+  db: DbLike,
+  projectId: string,
+  prefixes: readonly LedgerPrefix[] = LEDGER_PREFIXES,
+): Promise<void> {
+  for (const prefix of prefixes) {
+    await sql`
+      INSERT INTO exec_code_seq (project_id, prefix, seq)
+      VALUES (${projectId}, ${prefix}, 0)
+      ON CONFLICT (project_id, prefix) DO NOTHING
+    `.execute(db as never);
+  }
+}
