+    expect(parseRef('commit:abc1234:docs/A.md')).toEqual({ kind: 'commit', sha: 'abc1234', path: 'docs/A.md' });
+    expect(parseRef('ci:99:unit')).toEqual({ kind: 'ci', run: '99', job: 'unit' });
