# ForgePM environment — bootstrap values ONLY (secrets move to the `secrets`
# table once set from the panel; DB is then the source of truth).
# Copy to .env and fill. Never commit a real .env.

# ---- Runtime ----
NODE_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=3001

# ---- Postgres (only source of durable truth) ----
# docker compose default:
DATABASE_URL=postgres://forgepm:forgepm@localhost:5432/forgepm

# ---- Redis (queue + locks only, no durable data) ----
REDIS_URL=redis://localhost:6379

# ---- Encryption ----
# 32 random bytes, base64. Generate:  openssl rand -base64 32
# Encrypts provider keys / module secrets (AES-256-GCM). Rotation: docs/RUNBOOK.md
FORGEPM_SECRET_KEY=CHANGE_ME_32_BYTES_BASE64

# ---- Panel / CORS ----
WEB_ORIGIN=http://localhost:4200

# ---- Optional switches ----
API_DOCS_ENABLED=false          # serves /api/docs UI (OpenAPI JSON is always on)
METRICS_ENABLED=false           # Prometheus /metrics

# ---- First-run bootstrap admin (optional; the one-time setup screen is the
# ---- fallback if these are unset — plan §5.2) ----
#FORGEPM_ADMIN_EMAIL=admin@example.com
#FORGEPM_ADMIN_PASSWORD=change-me-please

LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace

# ---- Backups ----
BACKUP_KEEP=7

# ---- Refactor Review local sources (Phase 6) ----
#REPO_MOUNT_ROOT=/srv/forgepm/repos
